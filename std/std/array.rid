use crate::std::iter::{IntoIterator, Iterator};
use crate::std::option::Option;
use crate::std::vector::Vector;

pub struct IntoIter<T> {
    values: Vector<T>,
}

pub struct Iter<T, const N: usize> {
    values: &[T; N],
    index: usize,
}

pub struct IterMut<T, const N: usize> {
    values: &mut [T; N],
    index: usize,
}

impl<T, const N: usize> crate::std::fmt::Debug for [T; N]
where T: crate::std::fmt::Debug {
    fun fmt(&self, formatter: &mut crate::std::fmt::Formatter) -> crate::std::fmt::Result {
        formatter.write_str("[")?;
        let mut index = 0usize;
        while index < N {
            if index > 0usize {
                formatter.write_str(", ")?;
            }
            crate::std::fmt::write_debug(&self[index], &mut *formatter)?;
            index += 1usize;
        }
        formatter.write_str("]")
    }
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;

    fun next(&mut self) -> Option<Self::Item> {
        self.values.pop()
    }
}

impl<T, const N: usize> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T>;

    fun into_iter(self) -> Self::IntoIter {
        let mut values: Vector<T> = Vector::new();
        let mut index = N;
        while index > 0usize {
            index -= 1usize;
            values.push(self[index]);
        }
        IntoIter {
            values,
        }
    }
}

impl<T, const N: usize> Iterator for Iter<T, N> {
    type Item = &T;

    fun next(&mut self) -> Option<Self::Item> {
        if self.index < N {
            let index = self.index;
            self.index += 1usize;
            Option::Some(&self.values[index])
        } else {
            Option::None
        }
    }
}

impl<T, const N: usize> IntoIterator for &[T; N] {
    type Item = &T;
    type IntoIter = Iter<T, N>;

    fun into_iter(self) -> Self::IntoIter {
        Iter {
            values: &*self,
            index: 0usize,
        }
    }
}

impl<T, const N: usize> Iterator for IterMut<T, N> {
    type Item = &mut T;

    fun next(&mut self) -> Option<Self::Item> {
        if self.index < N {
            let index = self.index;
            self.index += 1usize;
            Option::Some(&mut self.values[index])
        } else {
            Option::None
        }
    }
}

impl<T, const N: usize> IntoIterator for &mut [T; N] {
    type Item = &mut T;
    type IntoIter = IterMut<T, N>;

    fun into_iter(self) -> Self::IntoIter {
        IterMut {
            values: &mut *self,
            index: 0usize,
        }
    }
}
