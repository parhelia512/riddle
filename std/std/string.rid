use crate::std::vector::Vector;

// SAFETY: the caller must guarantee that value contains valid UTF-8.
unsafe fun from_utf8_unchecked(value: &[u8]) -> &str {
    // SAFETY: &[u8] and &str use the same pointer and length metadata.
    unsafe { value as &str }
}

pub struct String {
    bytes: Vector<u8>,
}

impl String {
    pub fun new() -> String {
        String {
            bytes: Vector::new(),
        }
    }

    pub fun from_str(value: &str) -> String {
        let mut output = String::new();
        output.push_str(value);
        output
    }

    pub fun as_str(&self) -> &str {
        // SAFETY: String only stores bytes copied from valid string slices.
        unsafe { from_utf8_unchecked(self.bytes.as_slice()) }
    }

    pub fun len(&self) -> usize {
        self.bytes.len()
    }

    pub fun capacity(&self) -> usize {
        self.bytes.capacity()
    }

    pub fun is_empty(&self) -> bool {
        self.bytes.is_empty()
    }

    pub fun push_str(&mut self, value: &str) {
        for byte in value.as_bytes() {
            self.bytes.push(*byte);
        }
    }

    pub fun clear(&mut self) {
        self.bytes.clear();
    }
}

impl str {
    pub fun len(&self) -> usize {
        self.as_bytes().len()
    }

    pub fun is_empty(&self) -> bool {
        self.len() == 0usize
    }

    pub fun as_bytes(&self) -> &[u8] {
        self as &[u8]
    }
}
