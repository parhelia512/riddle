use crate::std::iter::{IntoIterator, Iterator};
use crate::std::option::Option;
use crate::std::vector::Vector;

// SAFETY: the caller must guarantee that value contains valid UTF-8.
unsafe fun from_utf8_unchecked(value: &[u8]) -> &str {
    // SAFETY: &[u8] and &str use the same pointer and length metadata.
    unsafe { value as &str }
}

// SAFETY: the caller must guarantee that value is a valid Unicode scalar value.
unsafe fun char_from_u32_unchecked(value: u32) -> char {
    // SAFETY: char and u32 have the same runtime representation.
    let values = [value];
    let slice: &[u32] = &values;
    unsafe { *(slice.as_ptr() as *const char) }
}

pub struct StrIter {
    bytes: &[u8],
    index: usize,
}

#[derive(Debug)]
pub struct String {
    bytes: Vector<u8>,
}

impl String {
    pub fun new() -> String {
        String {
            bytes: Vector::new(),
        }
    }

    pub fun from_str(value: &str) -> String {
        let mut output = String::new();
        output.push_str(value);
        output
    }

    pub fun as_str(&self) -> &str {
        // SAFETY: String only stores bytes copied from valid string slices.
        unsafe { from_utf8_unchecked(self.bytes.as_slice()) }
    }

    pub fun len(&self) -> usize {
        self.bytes.len()
    }

    pub fun capacity(&self) -> usize {
        self.bytes.capacity()
    }

    pub fun is_empty(&self) -> bool {
        self.bytes.is_empty()
    }

    pub fun push_str(&mut self, value: &str) {
        for byte in value.as_bytes() {
            self.bytes.push(*byte);
        }
    }

    pub fun clear(&mut self) {
        self.bytes.clear();
    }
}

impl str {
    pub fun len(&self) -> usize {
        self.as_bytes().len()
    }

    pub fun is_empty(&self) -> bool {
        self.len() == 0usize
    }

    pub fun as_bytes(&self) -> &[u8] {
        self as &[u8]
    }
}

impl Iterator for StrIter {
    type Item = char;

    fun next(&mut self) -> Option<Self::Item> {
        let first = match self.bytes.get(self.index) {
            Option::Some(value) => *value,
            Option::None => { return Option::None; },
        };

        if first < 128u8 {
            self.index += 1usize;
            return Option::Some(unsafe { char_from_u32_unchecked(first as u32) });
        }

        let second = match self.bytes.get(self.index + 1usize) {
            Option::Some(value) => *value,
            Option::None => { return Option::None; },
        };
        if first < 224u8 {
            self.index += 2usize;
            let value = (((first & 31u8) as u32) << 6u32) | ((second & 63u8) as u32);
            return Option::Some(unsafe { char_from_u32_unchecked(value) });
        }

        let third = match self.bytes.get(self.index + 2usize) {
            Option::Some(value) => *value,
            Option::None => { return Option::None; },
        };
        if first < 240u8 {
            self.index += 3usize;
            let value = (((first & 15u8) as u32) << 12u32)
                | (((second & 63u8) as u32) << 6u32)
                | ((third & 63u8) as u32);
            return Option::Some(unsafe { char_from_u32_unchecked(value) });
        }

        let fourth = match self.bytes.get(self.index + 3usize) {
            Option::Some(value) => *value,
            Option::None => { return Option::None; },
        };
        self.index += 4usize;
        let value = (((first & 7u8) as u32) << 18u32)
            | (((second & 63u8) as u32) << 12u32)
            | (((third & 63u8) as u32) << 6u32)
            | ((fourth & 63u8) as u32);
        Option::Some(unsafe { char_from_u32_unchecked(value) })
    }
}

impl IntoIterator for &str {
    type Item = char;
    type IntoIter = StrIter;

    fun into_iter(self) -> Self::IntoIter {
        StrIter {
            bytes: self.as_bytes(),
            index: 0usize,
        }
    }
}
