// `char` helpers. All functions are ASCII-only (the language has no Unicode
// case tables in std yet); non-ASCII code points pass through unchanged or
// return false from the classification predicates.
use crate::std::option::Option;

impl char {
    pub fun is_ascii(self) -> bool { is_ascii(self) }
    pub fun is_ascii_alphabetic(self) -> bool { is_ascii_alphabetic(self) }
    pub fun is_ascii_alphanumeric(self) -> bool { is_ascii_alphanumeric(self) }
    pub fun is_ascii_digit(self) -> bool { is_ascii_digit(self) }
    pub fun is_ascii_hexdigit(self) -> bool { is_ascii_hexdigit(self) }
    pub fun is_ascii_lowercase(self) -> bool { is_ascii_lowercase(self) }
    pub fun is_ascii_uppercase(self) -> bool { is_ascii_uppercase(self) }
    pub fun is_ascii_whitespace(self) -> bool { is_ascii_whitespace(self) }
    pub fun is_ascii_punctuation(self) -> bool { is_ascii_punctuation(self) }
    pub fun is_ascii_graphic(self) -> bool { is_ascii_graphic(self) }
    pub fun is_ascii_control(self) -> bool { is_ascii_control(self) }
    pub fun to_ascii_uppercase(self) -> char { to_ascii_uppercase(self) }
    pub fun to_ascii_lowercase(self) -> char { to_ascii_lowercase(self) }
    pub fun to_digit(self, radix: u32) -> Option<u32> { to_digit(self, radix) }
}

/// ASCII digit radix ceiling (`to_digit` supports 2..=36).
pub const MAX_RADIX: u32 = 36u32;

pub fun is_ascii(value: char) -> bool {
    (value as u32) < 128u32
}

pub fun is_ascii_alphabetic(value: char) -> bool {
    let code = value as u32;
    (code >= 65u32 && code <= 90u32) || (code >= 97u32 && code <= 122u32)
}

pub fun is_ascii_alphanumeric(value: char) -> bool {
    is_ascii_alphabetic(value) || is_ascii_digit(value)
}

pub fun is_ascii_digit(value: char) -> bool {
    let code = value as u32;
    code >= 48u32 && code <= 57u32
}

pub fun is_ascii_hexdigit(value: char) -> bool {
    let code = value as u32;
    is_ascii_digit(value) || (code >= 65u32 && code <= 70u32) || (code >= 97u32 && code <= 102u32)
}

pub fun is_ascii_lowercase(value: char) -> bool {
    let code = value as u32;
    code >= 97u32 && code <= 122u32
}

pub fun is_ascii_uppercase(value: char) -> bool {
    let code = value as u32;
    code >= 65u32 && code <= 90u32
}

pub fun is_ascii_whitespace(value: char) -> bool {
    let code = value as u32;
    code == 32u32 || code == 9u32 || code == 10u32 || code == 12u32 || code == 13u32
}

pub fun is_ascii_punctuation(value: char) -> bool {
    is_ascii_graphic(value) && !is_ascii_alphanumeric(value)
}

pub fun is_ascii_graphic(value: char) -> bool {
    let code = value as u32;
    code >= 33u32 && code <= 126u32
}

pub fun is_ascii_control(value: char) -> bool {
    let code = value as u32;
    code < 32u32 || code == 127u32
}

/// ASCII case conversion; non-ASCII characters are returned unchanged.
pub fun to_ascii_uppercase(value: char) -> char {
    if is_ascii_lowercase(value) {
        (((value as u32) - 32u32) as u8) as char
    } else {
        value
    }
}

/// ASCII case conversion; non-ASCII characters are returned unchanged.
pub fun to_ascii_lowercase(value: char) -> char {
    if is_ascii_uppercase(value) {
        (((value as u32) + 32u32) as u8) as char
    } else {
        value
    }
}

/// Converts a digit character in the given radix (2..=36) to its numeric value.
pub fun to_digit(value: char, radix: u32) -> Option<u32> {
    if radix < 2u32 || radix > MAX_RADIX {
        return Option::None;
    }
    let code = value as u32;
    let digit = if code >= 48u32 && code <= 57u32 {
        code - 48u32
    } else if code >= 97u32 && code <= 122u32 {
        code - 97u32 + 10u32
    } else if code >= 65u32 && code <= 90u32 {
        code - 65u32 + 10u32
    } else {
        return Option::None;
    };
    if digit < radix {
        Option::Some(digit)
    } else {
        Option::None
    }
}

/// Converts a number to its digit character in the given radix (2..=36).
pub fun from_digit(value: u32, radix: u32) -> Option<char> {
    if radix < 2u32 || radix > MAX_RADIX || value >= radix {
        return Option::None;
    }
    let code = if value < 10u32 {
        48u32 + value
    } else {
        97u32 + value - 10u32
    };
    Option::Some((code as u8) as char)
}
