unsafe extern "C" {
    safe fun riddle_time(value: *mut i64) -> i64;
    safe fun riddle_sleep_ms(milliseconds: u64);
}

pub fun time_now() -> i64 {
    riddle_time(0usize as *mut i64)
}

pub struct Duration {
    total_ms: u64,
}

impl Duration {
    pub fun from_secs(seconds: u64) -> Duration {
        Duration {
            total_ms: seconds * 1000u64,
        }
    }

    pub fun from_millis(milliseconds: u64) -> Duration {
        Duration {
            total_ms: milliseconds,
        }
    }

    pub fun as_millis(&self) -> u64 {
        self.total_ms
    }

    pub fun as_secs(&self) -> u64 {
        self.total_ms / 1000u64
    }
}

pub fun sleep(duration: Duration) {
    unsafe { riddle_sleep_ms(duration.as_millis()); }
}
