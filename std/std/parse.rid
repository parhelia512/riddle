use crate::std::option::Option;
use crate::std::result::Result;

// Why an integer parse failed, mirroring Rust's `ParseIntError` variants:
// `Empty` (input was empty or only a sign), `InvalidDigit` (a character
// outside the digit range), `PosOverflow` (value above the maximum) and
// `NegOverflow` (value below the minimum).
#[derive(Debug)]
pub enum ParseIntErrorKind {
    Empty,
    InvalidDigit,
    PosOverflow,
    NegOverflow,
}

#[derive(Debug)]
pub struct ParseIntError {
    kind: ParseIntErrorKind,
}

impl ParseIntError {
    pub fun kind(&self) -> &ParseIntErrorKind {
        &self.kind
    }
}

pub fun parse_i32(value: &str) -> Result<i32, ParseIntError> {
    if value.is_empty() {
        return Result::Err(ParseIntError {
            kind: ParseIntErrorKind::Empty
        });
    }
    let bytes = value.as_bytes();
    let mut index = 0usize;
    let mut negative = false;
    if bytes[0usize] == 45u8 {
        negative = true;
        index = 1usize;
        if index == bytes.len() {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::Empty
            });
        }
    }
    let limit = if negative {
        2147483648u32
    } else {
        2147483647u32
    };
    let mut output = 0u32;
    while index < bytes.len() {
        let byte = bytes[index];
        if byte < 48u8 || byte > 57u8 {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::InvalidDigit
            });
        }
        let digit = (byte - 48u8) as u32;
        if output > limit / 10u32 || (output == limit / 10u32 && digit > limit % 10u32) {
            let kind = if negative {
                ParseIntErrorKind::NegOverflow
            } else {
                ParseIntErrorKind::PosOverflow
            };
            return Result::Err(ParseIntError {
                kind
            });
        }
        output = output * 10u32 + digit;
        index += 1usize;
    }
    if negative {
        if output == 2147483648u32 {
            Result::Ok(-2147483647i32 - 1i32)
        } else {
            Result::Ok(-(output as i32))
        }
    } else {
        Result::Ok(output as i32)
    }
}

pub fun parse_u64(value: &str) -> Result<u64, ParseIntError> {
    if value.is_empty() {
        return Result::Err(ParseIntError {
            kind: ParseIntErrorKind::Empty
        });
    }
    let bytes = value.as_bytes();
    let mut index = 0usize;
    let mut output = 0u64;
    let limit = 18446744073709551615u64;
    while index < bytes.len() {
        let byte = bytes[index];
        if byte < 48u8 || byte > 57u8 {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::InvalidDigit
            });
        }
        let digit = (byte - 48u8) as u64;
        if output > limit / 10u64 || (output == limit / 10u64 && digit > limit % 10u64) {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::PosOverflow
            });
        }
        output = output * 10u64 + digit;
        index += 1usize;
    }
    Result::Ok(output)
}

pub fun parse_i64(value: &str) -> Result<i64, ParseIntError> {
    if value.is_empty() {
        return Result::Err(ParseIntError {
            kind: ParseIntErrorKind::Empty
        });
    }
    let bytes = value.as_bytes();
    let mut index = 0usize;
    let mut negative = false;
    if bytes[0usize] == 45u8 {
        negative = true;
        index = 1usize;
        if index == bytes.len() {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::Empty
            });
        }
    }
    let limit = if negative {
        9223372036854775808u64
    } else {
        9223372036854775807u64
    };
    let mut output = 0u64;
    while index < bytes.len() {
        let byte = bytes[index];
        if byte < 48u8 || byte > 57u8 {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::InvalidDigit
            });
        }
        let digit = (byte - 48u8) as u64;
        if output > limit / 10u64 || (output == limit / 10u64 && digit > limit % 10u64) {
            let kind = if negative {
                ParseIntErrorKind::NegOverflow
            } else {
                ParseIntErrorKind::PosOverflow
            };
            return Result::Err(ParseIntError {
                kind
            });
        }
        output = output * 10u64 + digit;
        index += 1usize;
    }
    if negative {
        if output == 9223372036854775808u64 {
            Result::Ok(-9223372036854775807i64 - 1i64)
        } else {
            Result::Ok(-(output as i64))
        }
    } else {
        Result::Ok(output as i64)
    }
}

pub fun parse_usize(value: &str) -> Result<usize, ParseIntError> {
    let parsed = parse_u64(value);
    match parsed {
        Result::Ok(number) => {
            let narrowed = number as usize;
            if (narrowed as u64) == number {
                Result::Ok(narrowed)
            } else {
                Result::Err(ParseIntError {
                    kind: ParseIntErrorKind::PosOverflow
                })
            }
        },
        Result::Err(error) => Result::Err(error),
    }
}

pub fun parse_with_radix(value: &str, radix: u32) -> Result<i64, ParseIntError> {
    if radix < 2u32 || radix > 36u32 {
        return Result::Err(ParseIntError {
            kind: ParseIntErrorKind::InvalidDigit
        });
    }
    if value.is_empty() {
        return Result::Err(ParseIntError {
            kind: ParseIntErrorKind::Empty
        });
    }
    let bytes = value.as_bytes();
    let mut index = 0usize;
    let mut negative = false;
    if bytes[0usize] == 45u8 {
        negative = true;
        index = 1usize;
        if index == bytes.len() {
            return Result::Err(ParseIntError {
                kind: ParseIntErrorKind::Empty
            });
        }
    }
    let radix_u64 = radix as u64;
    let mut output = 0u64;
    while index < bytes.len() {
        let byte = bytes[index];
        let digit_value_option = digit_value(byte);
        let digit = match digit_value_option {
            Option::Some(value) => {
                if (value as u32) >= radix {
                    return Result::Err(ParseIntError {
                        kind: ParseIntErrorKind::InvalidDigit
                    });
                }
                value as u64
            },
            Option::None => {
                return Result::Err(ParseIntError {
                    kind: ParseIntErrorKind::InvalidDigit
                });
            },
        };
        // Accumulate with a per-digit overflow check: a wrapped product can
        // land back inside the valid range, silently mis-parsing the value.
        let limit = if negative {
            9223372036854775808u64
        } else {
            0x7FFFFFFFFFFFFFFFu64
        };
        if output > (limit - digit) / radix_u64 {
            let kind = if negative {
                ParseIntErrorKind::NegOverflow
            } else {
                ParseIntErrorKind::PosOverflow
            };
            return Result::Err(ParseIntError {
                kind
            });
        }
        output = output * radix_u64 + digit;
        index += 1usize;
    }
    // The magnitude of `i64::MIN` (2^63) exceeds `i64::MAX` and is only
    // valid for the negative branch.
    if output > 0x7FFFFFFFFFFFFFFFu64 && !(negative && output == 9223372036854775808u64) {
        let kind = if negative {
            ParseIntErrorKind::NegOverflow
        } else {
            ParseIntErrorKind::PosOverflow
        };
        return Result::Err(ParseIntError {
            kind
        });
    }
    if negative {
        if output == 9223372036854775808u64 {
            Result::Ok(-9223372036854775807i64 - 1i64)
        } else {
            Result::Ok(-(output as i64))
        }
    } else {
        Result::Ok(output as i64)
    }
}

fun digit_value(byte: u8) -> Option<u8> {
    if byte >= 48u8 && byte <= 57u8 {
        Option::Some(byte - 48u8)
    } else if byte >= 97u8 && byte <= 122u8 {
        Option::Some(byte - 87u8)
    } else if byte >= 65u8 && byte <= 90u8 {
        Option::Some(byte - 55u8)
    } else {
        Option::None
    }
}
