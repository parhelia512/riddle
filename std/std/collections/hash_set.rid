use crate::std::cmp::Eq;
use crate::std::hash::Hash;
use crate::std::collections::hash_map::HashMap;
use crate::std::option::Option;

pub struct HashSet<T> {
    values: HashMap<T, bool>,
}

impl<T> crate::std::fmt::Debug for HashSet<T> where T: crate::std::fmt::Debug {
    fun fmt(&self, formatter: &mut crate::std::fmt::Formatter) -> crate::std::fmt::Result {
        formatter.write_str("{")?;
        let mut iter = self.values.iter();
        let mut first = true;
        loop {
            match iter.next() {
                Option::Some((value, _)) => {
                    if first {
                        first = false;
                    } else {
                        formatter.write_str(", ")?;
                    }
                    crate::std::fmt::write_debug(value, &mut *formatter)?;
                },
                Option::None => {
                    break;
                },
            }
        }
        formatter.write_str("}")
    }
}

impl<T> HashSet<T> {
    pub fun new() -> HashSet<T> {
        let values: HashMap<T, bool> = HashMap::new();
        HashSet {
            values
        }
    }

    pub fun len(&self) -> usize {
        self.values.len()
    }

    pub fun is_empty(&self) -> bool {
        self.values.is_empty()
    }

    pub fun insert(&mut self, value: T) where T: Hash + Eq {
        self.values.insert(value, true);
    }

    pub fun contains(&self, value: &T) -> bool where T: Hash + Eq {
        self.values.contains_key(value)
    }

    pub fun remove(&mut self, value: &T) -> bool where T: Hash + Eq {
        self.values.remove(value).is_some()
    }

    /// Iterates the elements in insertion order, like [`HashMap::keys`] —
    /// including its caveat: a `remove` displaces the last element into the
    /// vacated slot, so removals reorder what follows.
    pub fun iter(&self) -> HashSetIter<T> {
        HashSetIter {
            inner: self.values.iter(),
        }
    }
}

pub struct HashSetIter<T> {
    inner: crate::std::collections::hash_map::HashMapIter<T, bool>,
}

impl<T> crate::std::iter::Iterator for HashSetIter<T> {
    type Item = &T;

    fun next(&mut self) -> Option<Self::Item> {
        match self.inner.next() {
            Option::Some((value, _)) => Option::Some(value),
            Option::None => Option::None,
        }
    }
}

impl<T> crate::std::iter::IntoIterator for HashSetIter<T> {
    type Item = &T;
    type IntoIter = HashSetIter<T>;

    fun into_iter(self) -> HashSetIter<T> {
        self
    }
}

impl<T> crate::std::iter::IntoIterator for &HashSet<T> {
    type Item = &T;
    type IntoIter = HashSetIter<T>;

    fun into_iter(self) -> Self::IntoIter {
        self.iter()
    }
}
