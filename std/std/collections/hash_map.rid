use crate::std::cmp::Eq;
use crate::std::hash::Hash;
use crate::std::option::Option;
use crate::std::vector::Vector;

#[derive(Debug)]
enum HashBucket {
    Empty,
    Occupied(usize),
}

impl crate::std::marker::Copy for HashBucket {}

fun occupy_hash_bucket(
    mut buckets: &mut Vector<HashBucket>,
    bucket_index: usize,
    entry_index: usize
) {
    match buckets.get_mut(bucket_index) {
        Option::Some(mut bucket) => { *bucket = HashBucket::Occupied(entry_index); },
        Option::None => {},
    }
}

#[derive(Debug)]
pub struct HashMap<K, V> {
    buckets: Vector<HashBucket>,
    keys: Vector<K>,
    values: Vector<V>,
}

pub struct HashMapIter<K, V> {
    keys: &[K],
    values: &[V],
    index: usize,
}

impl<K, V> HashMap<K, V> {
    pub fun new() -> HashMap<K, V> {
        let mut buckets: Vector<HashBucket> = Vector::new();
        let mut index = 0usize;
        while index < 8usize {
            buckets.push(HashBucket::Empty);
            index += 1usize;
        }
        let keys: Vector<K> = Vector::new();
        let values: Vector<V> = Vector::new();
        HashMap {
            buckets,
            keys,
            values,
        }
    }

    pub fun len(&self) -> usize {
        self.keys.len()
    }

    pub fun is_empty(&self) -> bool {
        self.keys.is_empty()
    }

    pub fun insert(&mut self, key: K, value: V)
    where K: Hash + Eq {
        let existing = self.find_entry(&key);
        if existing.is_none()
            && (self.keys.len() + 1usize) * 4usize >= self.buckets.len() * 3usize {
            self.grow();
        }

        let bucket_index = if existing.is_none() {
            self.find_empty_bucket(&key).unwrap_or(0usize)
        } else {
            0usize
        };
        let value_index = self.values.len();
        self.values.push(value);

        if existing.is_some() {
            let entry_index = existing.unwrap_or(0usize);
            self.values.swap(entry_index, value_index);
            let _old_value = self.values.pop();
        } else {
            let entry_index = self.keys.len();
            self.keys.push(key);
            occupy_hash_bucket(&mut self.buckets, bucket_index, entry_index);
        }
    }

    pub fun get(&self, key: &K) -> Option<&V>
    where K: Hash + Eq {
        match self.find_entry(key) {
            Option::Some(entry_index) => self.values.get(entry_index),
            Option::None => Option::None,
        }
    }

    pub fun get_mut(&mut self, key: &K) -> Option<&mut V>
    where K: Hash + Eq {
        match self.find_entry(key) {
            Option::Some(entry_index) => self.values.get_mut(entry_index),
            Option::None => Option::None,
        }
    }

    pub fun remove(&mut self, key: &K) -> Option<V>
    where K: Hash + Eq {
        let capacity = self.buckets.len();
        if capacity == 0usize {
            return Option::None;
        }
        let located = self.find_entry_bucket(key);
        let entry_index = match located {
            Option::Some((entry, bucket)) => {
                self.set_bucket(bucket, HashBucket::Empty);
                self.backward_shift(bucket, capacity);
                entry
            },
            Option::None => { return Option::None; },
        };

        // Remove the parallel entries, then relocate the formerly last entry's
        // bucket pointer; its hash is read after the swap because the swap
        // moved the key into the vacated slot.
        let last = self.keys.len() - 1usize;
        let moved_home = if entry_index != last {
            match self.keys.get(last) {
                Option::Some(stored) => stored.hash() % capacity,
                Option::None => 0usize,
            }
        } else {
            0usize
        };
        self.keys.swap(entry_index, last);
        self.keys.pop();

        if entry_index != last {
            let mut probe = moved_home;
            let mut scanning = true;
            while scanning {
                let matches_last = match self.buckets.get(probe) {
                    Option::Some(bucket) => match *bucket {
                        HashBucket::Occupied(occupied) => occupied == last,
                        HashBucket::Empty => false,
                    },
                    Option::None => false,
                };
                if matches_last {
                    match self.buckets.get_mut(probe) {
                        Option::Some(mut slot) => { *slot = HashBucket::Occupied(entry_index); },
                        Option::None => {},
                    }
                    scanning = false;
                } else {
                    probe = (probe + 1usize) % capacity;
                }
            }
        }

        self.values.swap(entry_index, last);
        let value = self.values.pop();
        value
    }

    fun find_entry_bucket(&self, key: &K) -> Option<(usize, usize)>
    where K: Hash + Eq {
        let capacity = self.buckets.len();
        if capacity == 0usize {
            return Option::None;
        }
        let mut bucket_index = key.hash() % capacity;
        let mut scanned = 0usize;
        while scanned < capacity {
            let bucket = self.bucket_at(bucket_index);
            match bucket {
                HashBucket::Empty => { return Option::None; },
                HashBucket::Occupied(entry_index) => {
                    match self.keys.get(entry_index) {
                        Option::Some(stored) => {
                            if stored.eq(key) {
                                return Option::Some((entry_index, bucket_index));
                            }
                        },
                        Option::None => { return Option::None; },
                    }
                },
            }
            bucket_index = (bucket_index + 1usize) % capacity;
            scanned += 1usize;
        }
        Option::None
    }

    fun bucket_at(&self, index: usize) -> HashBucket {
        match self.buckets.get(index) {
            Option::Some(bucket) => *bucket,
            Option::None => HashBucket::Empty,
        }
    }

    fun set_bucket(&mut self, index: usize, bucket: HashBucket) {
        match self.buckets.get_mut(index) {
            Option::Some(mut slot) => { *slot = bucket; },
            Option::None => {},
        }
    }

    // Backward-shift deletion for linear probing: entries after the emptied
    // bucket move into it whenever their home position lies before the empty
    // slot on their probe path, keeping every lookup chain intact.
    fun backward_shift(&mut self, removed_bucket: usize, capacity: usize)
    where K: Hash {
        if capacity == 0usize {
            return;
        }
        let mut empty = removed_bucket;
        let mut current = removed_bucket;
        let mut scanning = true;
        while scanning {
            current = (current + 1usize) % capacity;
            let next_entry = match self.bucket_at(current) {
                HashBucket::Empty => 0usize,
                HashBucket::Occupied(occupied) => occupied + 1usize,
            };
            if next_entry == 0usize {
                scanning = false;
                break;
            }
            let entry_index = next_entry - 1usize;
            let home = match self.keys.get(entry_index) {
                Option::Some(stored) => stored.hash() % capacity,
                Option::None => 0usize,
            };
            if home == 0usize && self.keys.get(entry_index).is_none() {
                scanning = false;
                break;
            }
            let empty_distance = (empty + capacity - home) % capacity;
            let current_distance = (current + capacity - home) % capacity;
            if empty_distance < current_distance {
                self.set_bucket(empty, HashBucket::Occupied(entry_index));
                self.set_bucket(current, HashBucket::Empty);
                empty = current;
            }
        }
    }

    pub fun iter(&self) -> HashMapIter<K, V> {
        HashMapIter {
            keys: self.keys.as_slice(),
            values: self.values.as_slice(),
            index: 0usize,
        }
    }

    pub fun contains_key(&self, key: &K) -> bool
    where K: Hash + Eq {
        self.find_entry(key).is_some()
    }

    fun find_entry(&self, key: &K) -> Option<usize>
    where K: Hash + Eq {
        let capacity = self.buckets.len();
        if capacity == 0usize {
            return Option::None;
        }
        let mut bucket_index = key.hash() % capacity;
        let mut scanned = 0usize;
        while scanned < capacity {
            match self.buckets.get(bucket_index) {
                Option::Some(bucket) => match *bucket {
                    HashBucket::Empty => { return Option::None; },
                    HashBucket::Occupied(entry_index) => {
                        match self.keys.get(entry_index) {
                            Option::Some(stored) => {
                                if stored.eq(key) {
                                    return Option::Some(entry_index);
                                }
                            },
                            Option::None => {},
                        }
                    },
                },
                Option::None => { return Option::None; },
            }
            bucket_index = (bucket_index + 1usize) % capacity;
            scanned += 1usize;
        }
        Option::None
    }

    fun find_empty_bucket(&self, key: &K) -> Option<usize>
    where K: Hash {
        let capacity = self.buckets.len();
        if capacity == 0usize {
            return Option::None;
        }
        let mut bucket_index = key.hash() % capacity;
        let mut scanned = 0usize;
        while scanned < capacity {
            match self.buckets.get(bucket_index) {
                Option::Some(bucket) => match *bucket {
                    HashBucket::Empty => { return Option::Some(bucket_index); },
                    HashBucket::Occupied(_) => {},
                },
                Option::None => { return Option::None; },
            }
            bucket_index = (bucket_index + 1usize) % capacity;
            scanned += 1usize;
        }
        Option::None
    }

    fun grow(&mut self)
    where K: Hash {
        let capacity = self.buckets.len() * 2usize;
        let mut buckets: Vector<HashBucket> = Vector::new();
        let mut bucket_count = 0usize;
        while bucket_count < capacity {
            buckets.push(HashBucket::Empty);
            bucket_count += 1usize;
        }
        let mut entry_index = 0usize;
        while entry_index < self.keys.len() {
            let mut bucket_index = match self.keys.get(entry_index) {
                Option::Some(key) => key.hash() % capacity,
                Option::None => 0usize,
            };
            let mut placed = false;
            while !placed {
                let empty = match buckets.get(bucket_index) {
                    Option::Some(bucket) => match *bucket {
                        HashBucket::Empty => true,
                        HashBucket::Occupied(_) => false,
                    },
                    Option::None => false,
                };
                if empty {
                    occupy_hash_bucket(&mut buckets, bucket_index, entry_index);
                    placed = true;
                } else {
                    bucket_index = (bucket_index + 1usize) % capacity;
                }
            }
            entry_index += 1usize;
        }
        self.buckets = buckets;
    }
}

impl<K, V> crate::std::iter::Iterator for HashMapIter<K, V> {
    type Item = (&K, &V);

    fun next(&mut self) -> Option<Self::Item> {
        if self.index >= self.keys.len() {
            return Option::None;
        }
        let index = self.index;
        self.index += 1usize;
        match (self.keys.get(index), self.values.get(index)) {
            (Option::Some(key), Option::Some(value)) => Option::Some((key, value)),
            _ => Option::None,
        }
    }
}

impl<K, V> crate::std::iter::IntoIterator for &HashMap<K, V> {
    type Item = (&K, &V);
    type IntoIter = HashMapIter<K, V>;

    fun into_iter(self) -> Self::IntoIter {
        self.iter()
    }
}
