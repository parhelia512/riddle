use crate::std::cmp::Ord;
use crate::std::collections::tree_map::TreeMap;

#[derive(Debug)]
pub struct TreeSet<T> {
    values: TreeMap<T, ()>,
}

impl<T> TreeSet<T> {
    pub fun new() -> TreeSet<T> {
        TreeSet { values: TreeMap::new() }
    }

    pub fun len(&self) -> usize {
        self.values.len()
    }

    pub fun is_empty(&self) -> bool {
        self.values.is_empty()
    }

    pub fun insert(&mut self, value: T)
    where T: Ord {
        self.values.insert(value, ());
    }

    pub fun contains(&self, value: &T) -> bool
    where T: Ord {
        self.values.contains_key(value)
    }

    pub fun remove(&mut self, value: &T) -> bool
    where T: Ord {
        self.values.remove(value).is_some()
    }
}
