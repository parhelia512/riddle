use crate::std::cmp::Ord;
use crate::std::collections::tree_map::TreeMap;
use crate::std::option::Option;

pub struct TreeSet<T> {
    values: TreeMap<T, ()>,
}

impl<T> crate::std::fmt::Debug for TreeSet<T> where T: crate::std::fmt::Debug {
    fun fmt(&self, formatter: &mut crate::std::fmt::Formatter) -> crate::std::fmt::Result {
        formatter.write_str("{")?;
        let mut iter = self.values.iter();
        let mut first = true;
        loop {
            match iter.next() {
                Option::Some((value, _)) => {
                    if first {
                        first = false;
                    } else {
                        formatter.write_str(", ")?;
                    }
                    crate::std::fmt::write_debug(value, &mut *formatter)?;
                },
                Option::None => {
                    break;
                },
            }
        }
        formatter.write_str("}")
    }
}

impl<T> TreeSet<T> {
    pub fun new() -> TreeSet<T> {
        TreeSet {
            values: TreeMap::new()
        }
    }

    pub fun len(&self) -> usize {
        self.values.len()
    }

    pub fun is_empty(&self) -> bool {
        self.values.is_empty()
    }

    pub fun insert(&mut self, value: T) where T: Ord {
        self.values.insert(value, ());
    }

    pub fun contains(&self, value: &T) -> bool where T: Ord {
        self.values.contains_key(value)
    }

    pub fun remove(&mut self, value: &T) -> bool where T: Ord {
        self.values.remove(value).is_some()
    }

    /// Iterates the elements in sorted order.
    pub fun iter(&self) -> TreeSetIter<T> {
        TreeSetIter {
            inner: self.values.iter(),
        }
    }
}

pub struct TreeSetIter<T> {
    inner: crate::std::collections::tree_map::TreeMapIter<T, ()>,
}

impl<T> crate::std::iter::Iterator for TreeSetIter<T> {
    type Item = &T;

    fun next(&mut self) -> Option<Self::Item> {
        match self.inner.next() {
            Option::Some((value, _)) => Option::Some(value),
            Option::None => Option::None,
        }
    }
}

impl<T> crate::std::iter::IntoIterator for TreeSetIter<T> {
    type Item = &T;
    type IntoIter = TreeSetIter<T>;

    fun into_iter(self) -> TreeSetIter<T> {
        self
    }
}

impl<T> crate::std::iter::IntoIterator for &TreeSet<T> {
    type Item = &T;
    type IntoIter = TreeSetIter<T>;

    fun into_iter(self) -> Self::IntoIter {
        self.iter()
    }
}
