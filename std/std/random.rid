unsafe extern "C" {
    safe fun riddle_random_u32() -> u32;
    safe fun riddle_random_u64() -> u64;
}

pub fun random_u32() -> u32 {
    unsafe { riddle_random_u32() }
}

pub fun random_u64() -> u64 {
    unsafe { riddle_random_u64() }
}

pub fun random_bool() -> bool {
    random_u32() % 2u32 == 0u32
}

pub fun random_below(bound: u32) -> u32 {
    if bound == 0u32 {
        return 0u32;
    }
    random_u32() % bound
}
