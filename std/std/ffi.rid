use crate::std::clone::Clone;
use crate::std::cmp::{Eq, PartialEq};
use crate::std::result::Result;
use crate::std::string::String;
use crate::std::vector::Vector;

// Unix stores native bytes. Windows stores WTF-8 so every UTF-16 command-line
// argument, including isolated surrogates, can be represented without loss.
#[derive(Debug)]
pub struct OsString {
    bytes: Vector<u8>,
}

impl OsString {
    pub fun new() -> OsString {
        OsString {
            bytes: Vector::new(),
        }
    }

    pub fun from_str(value: &str) -> OsString {
        let mut output = OsString::new();
        for byte in value.as_bytes() {
            output.bytes.push(*byte);
        }
        output
    }

    // SAFETY: value must use the platform encoding returned by as_encoded_bytes.
    pub unsafe fun from_encoded_bytes_unchecked(value: &[u8]) -> OsString {
        let mut output = OsString::new();
        for byte in value {
            output.bytes.push(*byte);
        }
        output
    }

    pub fun as_encoded_bytes(&self) -> &[u8] {
        self.bytes.as_slice()
    }

    pub fun len(&self) -> usize {
        self.bytes.len()
    }

    pub fun is_empty(&self) -> bool {
        self.bytes.is_empty()
    }

    pub fun into_string(self) -> Result<String, OsString> {
        match String::from_utf8(self.as_encoded_bytes()) {
            crate::std::option::Option::Some(value) => Result::Ok(value),
            crate::std::option::Option::None => Result::Err(self),
        }
    }
}

impl Clone for OsString {
    fun clone(&self) -> Self {
        unsafe { OsString::from_encoded_bytes_unchecked(self.as_encoded_bytes()) }
    }
}

impl PartialEq for OsString {
    fun eq(&self, other: &Self) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let left = self.as_encoded_bytes();
        let right = other.as_encoded_bytes();
        let mut index = 0usize;
        while index < left.len() {
            if left[index] != right[index] {
                return false;
            }
            index += 1usize;
        }
        true
    }
}

impl Eq for OsString {}
