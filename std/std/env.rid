use crate::std::string::String;
use crate::std::vector::Vector;

// Process arguments are copied from the host's argc/argv in order. args()
// rejects a platform argument that is not valid UTF-8.
unsafe extern "C" {
    safe fun riddle_argc() -> i32;
    safe fun riddle_argv_at(index: i32) -> *mut u8;
    safe fun riddle_argv_len(index: i32) -> usize;
}

pub fun args() -> Vector<String> {
    let count = riddle_argc();
    let mut output: Vector<String> = Vector::new();
    let mut index = 0i32;
    while index < count {
        let pointer = riddle_argv_at(index);
        let length = riddle_argv_len(index);
        let value = match unsafe { String::from_utf8_raw(pointer as *const u8, length) } {
            crate::std::option::Option::Some(value) => value,
            crate::std::option::Option::None => {
                crate::std::panic::panic("process argument is not valid UTF-8")
            },
        };
        output.push(value);
        index += 1i32;
    }
    output
}
