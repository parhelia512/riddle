use crate::std::ffi::OsString;
use crate::std::string::String;
use crate::std::vector::Vector;

// Process arguments are copied from the host in platform encoding. On Windows
// the runtime reads and parses GetCommandLineW instead of using narrow argv.
unsafe extern "C" {
    safe fun riddle_argc() -> i32;
    safe fun riddle_argv_at(index: i32) -> *mut u8;
    safe fun riddle_argv_len(index: i32) -> usize;
}

pub fun args_os() -> Vector<OsString> {
    let count = riddle_argc();
    let mut output: Vector<OsString> = Vector::new();
    let mut index = 0i32;
    while index < count {
        let pointer = riddle_argv_at(index);
        let length = riddle_argv_len(index);
        // SAFETY: the runtime keeps pointer readable for the process lifetime
        // and returns bytes in the platform encoding used by OsString.
        let encoded: &[u8] = unsafe { (pointer as *const u8, length) as &[u8] };
        let value = unsafe { OsString::from_encoded_bytes_unchecked(encoded) };
        output.push(value);
        index += 1i32;
    }
    output
}

pub fun args() -> Vector<String> {
    let mut output: Vector<String> = Vector::new();
    for value in args_os() {
        match value.into_string() {
            crate::std::result::Result::Ok(value) => { output.push(value); },
            crate::std::result::Result::Err(_) => {
                crate::std::panic::panic("process argument is not valid Unicode")
            },
        }
    }
    output
}
