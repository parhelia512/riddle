    impl Parse for DeriveInput {
        fun parse(input: &mut ParseStream) -> Result<DeriveInput, Error> {
            let tokens = input.remaining();
            let mut attrs = Vector::new();
            while input.peek_punct('#') {
                let mut attribute = TokenStream::new();
                match input.next() {
                    Option::Some(tree) => attribute.push(tree),
                    Option::None => {
                        return Result::Err(Error::new(input.span(), "expected attribute"));
                    },
                }
                match input.next() {
                    Option::Some(tree) => {
                        match &tree {
                            TokenTree::Group(group) => {
                                match group.delimiter() {
                                    Delimiter::Bracket => attribute.push(tree.clone()),
                                    _ => {
                                        return Result::Err(Error::new(group.span(), "expected attribute brackets"));
                                    },
                                }
                            },
                            _ => {
                                return Result::Err(Error::new(tree.span(), "expected attribute brackets"));
                            },
                        }
                    },
                    Option::None => {
                        return Result::Err(Error::new(input.span(), "expected attribute brackets"));
                    },
                }
                attrs.push(Attribute { tokens: attribute });
            }

            let vis = if input.peek_ident("pub") {
                let _keyword = input.next();
                Visibility::Public
            } else {
                Visibility::Inherited
            };

            let is_struct = if input.peek_ident("struct") {
                let _keyword = input.next();
                true
            } else if input.peek_ident("enum") {
                let _keyword = input.next();
                false
            } else {
                return Result::Err(Error::new(input.span(), "expected `struct` or `enum`"));
            };

            let ident = match input.next() {
                Option::Some(tree) => {
                    match &tree {
                        TokenTree::Ident(value) => value.clone(),
                        _ => {
                            return Result::Err(Error::new(tree.span(), "expected item name"));
                        },
                    }
                },
                Option::None => {
                    return Result::Err(Error::new(input.span(), "expected item name"));
                },
            };
            let mut generic_tokens = TokenStream::new();
            if input.peek_punct('<') {
                let mut depth = 0usize;
                while !input.is_empty() {
                    let tree = match input.next() {
                        Option::Some(value) => value,
                        Option::None => {
                            return Result::Err(Error::new(input.span(), "unclosed generic parameters"));
                        },
                    };
                    let mut closed = false;
                    match &tree {
                        TokenTree::Punct(punct) => {
                            if punct.as_char() == '<' {
                                depth += 1usize;
                            } else if punct.as_char() == '>' {
                                if depth == 0usize {
                                    return Result::Err(Error::new(punct.span(), "unexpected `>`"));
                                }
                                depth -= 1usize;
                                closed = depth == 0usize;
                            }
                        },
                        _ => {},
                    }
                    generic_tokens.push(tree.clone());
                    if closed {
                        break;
                    }
                }
                if generic_tokens.is_empty() || !punct_at(&generic_tokens, generic_tokens.len() - 1usize, '>') {
                    return Result::Err(Error::new(input.span(), "unclosed generic parameters"));
                }
            }

            let mut where_clause = TokenStream::new();
            let mut body = TokenStream::new();
            let mut found_body = false;
            while !input.is_empty() {
                let tree = match input.next() {
                    Option::Some(value) => value,
                    Option::None => {
                        return Result::Err(Error::new(input.span(), "expected item body"));
                    },
                };
                match &tree {
                    TokenTree::Group(group) => match group.delimiter() {
                        Delimiter::Brace => {
                            body = group.stream().cloned();
                            found_body = true;
                        },
                        _ => where_clause.push(tree.clone()),
                    },
                    _ => where_clause.push(tree.clone()),
                }
                if found_body {
                    break;
                }
            }
            if !found_body {
                return Result::Err(Error::new(input.span(), "expected item body"));
            }
            if !input.is_empty() {
                return Result::Err(Error::new(input.span(), "unexpected tokens after item body"));
            }
            let params = match parse_generic_params(&generic_tokens) {
                Result::Ok(value) => value,
                Result::Err(error) => { return Result::Err(error); },
            };
            let predicates = match parse_where_predicates(&where_clause) {
                Result::Ok(value) => value,
                Result::Err(error) => { return Result::Err(error); },
            };
            let data = if is_struct {
                let named = match parse_named_fields(&body) {
                    Result::Ok(value) => value,
                    Result::Err(error) => { return Result::Err(error); },
                };
                Data::Struct(DataStruct {
                    fields: body.cloned(),
                    named,
                })
            } else {
                let items = match parse_variants(&body) {
                    Result::Ok(value) => value,
                    Result::Err(error) => { return Result::Err(error); },
                };
                Data::Enum(DataEnum {
                    variants: body.cloned(),
                    items,
                })
            };
            Result::Ok(DeriveInput {
                attrs,
                vis,
                ident,
                generics: Generics {
                    tokens: generic_tokens,
                    where_clause,
                    params,
                    predicates,
                },
                data,
                tokens,
            })
        }
    }

    impl crate::ToTokens for DeriveInput {
        fun to_tokens(&self, output: &mut TokenStream) {
            output.extend(self.tokens.cloned());
        }
    }

    impl DeriveInput {
        pub fun to_token_stream(&self) -> TokenStream {
            self.tokens.cloned()
        }
    }
}
