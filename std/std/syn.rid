pub mod syn {
    use crate::std::option::Option;
    use crate::std::result::Result;
    use crate::std::string::String;
    use crate::std::vector::Vector;
    use crate::{Delimiter, Diagnostic, Group, Ident, Punct, Span, Spacing, TokenStream, TokenTree};

    pub use crate::ToTokens;

    pub struct Error {
        pub span: Span,
        pub message: String,
    }

    pub struct ParseStream {
        tokens: TokenStream,
        index: usize,
    }

    pub trait Parse {
        fun parse(input: &mut ParseStream) -> Result<Self, Error>;
    }

    pub trait Visit {
        fun visit_file(&mut self, node: &File) { walk_file(self, node); }
        fun visit_item(&mut self, node: &Item) { walk_item(self, node); }
        fun visit_stmt(&mut self, node: &Stmt) { walk_stmt(self, node); }
        fun visit_expr(&mut self, node: &Expr) { walk_expr(self, node); }
        fun visit_type(&mut self, node: &Type) { walk_type(self, node); }
        fun visit_pat(&mut self, node: &Pat) { walk_pat(self, node); }
        fun visit_derive_input(&mut self, node: &DeriveInput) {
            walk_derive_input(self, node);
        }
    }

    pub trait Fold {
        fun fold_file(&mut self, node: File) -> File { fold_file_default(self, node) }
        fun fold_item(&mut self, node: Item) -> Item { fold_item_default(self, node) }
        fun fold_stmt(&mut self, node: Stmt) -> Stmt { fold_stmt_default(self, node) }
        fun fold_expr(&mut self, node: Expr) -> Expr { fold_expr_default(self, node) }
        fun fold_type(&mut self, node: Type) -> Type { fold_type_default(self, node) }
        fun fold_pat(&mut self, node: Pat) -> Pat { fold_pat_default(self, node) }
        fun fold_derive_input(&mut self, node: DeriveInput) -> DeriveInput {
            fold_derive_input_default(self, node)
        }
    }

    pub enum Visibility {
        Inherited,
        Public,
    }

    pub struct Attribute {
        pub tokens: TokenStream,
    }

    pub struct Generics {
        pub tokens: TokenStream,
        pub where_clause: TokenStream,
        pub params: Vector<GenericParam>,
        pub predicates: Vector<WherePredicate>,
    }

    pub struct TypeParam {
        pub ident: Ident,
        pub bounds: TokenStream,
        pub default: TokenStream,
        pub tokens: TokenStream,
    }

    pub struct ConstParam {
        pub ident: Ident,
        pub ty: Type,
        pub tokens: TokenStream,
    }

    pub enum GenericParam {
        Type(TypeParam),
        Const(ConstParam),
    }

    pub struct WherePredicate {
        pub ty: Type,
        pub bounds: TokenStream,
        pub tokens: TokenStream,
    }

    pub struct Field {
        pub attrs: Vector<Attribute>,
        pub vis: Visibility,
        pub ident: Ident,
        pub ty: Type,
        pub tokens: TokenStream,
    }

    pub enum Fields {
        Unit,
        Named(Vector<Field>),
        Unnamed(Vector<Type>),
    }

    pub struct Variant {
        pub attrs: Vector<Attribute>,
        pub ident: Ident,
        pub fields: Fields,
        pub tokens: TokenStream,
    }

    pub struct DataStruct {
        pub fields: TokenStream,
        pub named: Vector<Field>,
    }

    pub struct DataEnum {
        pub variants: TokenStream,
        pub items: Vector<Variant>,
    }

    pub enum Data {
        Struct(DataStruct),
        Enum(DataEnum),
    }

    pub struct DeriveInput {
        pub attrs: Vector<Attribute>,
        pub vis: Visibility,
        pub ident: Ident,
        pub generics: Generics,
        pub data: Data,
        tokens: TokenStream,
    }

    pub struct File {
        pub stmts: Vector<Stmt>,
    }

    pub enum Item {
        Module(TokenStream),
        Use(TokenStream),
        Function(TokenStream),
        Struct(TokenStream),
        Enum(TokenStream),
        Trait(TokenStream),
        Impl(TokenStream),
        Const(TokenStream),
        TypeAlias(TokenStream),
        Extern(TokenStream),
    }

    pub enum Stmt {
        Item(Item),
        Local(TokenStream),
        Expr(TokenStream),
        Break(TokenStream),
        Continue(TokenStream),
        Return(TokenStream),
    }

    pub enum Expr {
        Literal(TokenStream),
        Path(TokenStream),
        Block(TokenStream),
        Tuple(TokenStream),
        Array(TokenStream),
        Struct(TokenStream),
        Call(TokenStream),
        Field(TokenStream),
        Index(TokenStream),
        Unary(TokenStream),
        Binary(TokenStream),
        Cast(TokenStream),
        Try(TokenStream),
        Closure(TokenStream),
        If(TokenStream),
        While(TokenStream),
        For(TokenStream),
        Match(TokenStream),
        Unsafe(TokenStream),
        Macro(TokenStream),
    }

    pub enum Type {
        Path(TokenStream),
        Reference(TokenStream),
        Pointer(TokenStream),
        Tuple(TokenStream),
        Array(TokenStream),
        Const(TokenStream),
        Never(TokenStream),
        ImplTrait(TokenStream),
        Macro(TokenStream),
    }

    pub enum Pat {
        Wildcard(TokenStream),
        Literal(TokenStream),
        Tuple(TokenStream),
        Struct(TokenStream),
        Enum(TokenStream),
        Binding(TokenStream),
        Reference(TokenStream),
        Macro(TokenStream),
    }

    impl Error {
        pub fun new(span: Span, message: &str) -> Error {
            Error {
                span,
                message: String::from_str(message),
            }
        }

        pub fun emit(&self) {
            Diagnostic::error(self.span, self.message.as_str()).emit();
        }
    }

    impl ParseStream {
        pub fun new(tokens: TokenStream) -> ParseStream {
            ParseStream { tokens, index: 0usize }
        }

        pub fun is_empty(&self) -> bool {
            self.index == self.tokens.len()
        }

        pub fun peek_ident(&self, expected: &str) -> bool {
            match self.tokens.as_slice().get(self.index) {
                Option::Some(TokenTree::Ident(value)) => value.as_str() == expected,
                _ => false,
            }
        }

        pub fun peek_punct(&self, expected: char) -> bool {
            match self.tokens.as_slice().get(self.index) {
                Option::Some(TokenTree::Punct(value)) => value.as_char() == expected,
                _ => false,
            }
        }

        pub fun span(&self) -> Span {
            match self.tokens.as_slice().get(self.index) {
                Option::Some(tree) => tree.span(),
                Option::None => Span::call_site(),
            }
        }

        pub fun next(&mut self) -> Option<TokenTree> {
            if self.is_empty() {
                Option::None
            } else {
                let tree = self.tokens.as_slice()[self.index].clone();
                self.index += 1usize;
                Option::Some(tree)
            }
        }

        pub fun remaining(&self) -> TokenStream {
            let mut output = TokenStream::new();
            let mut index = self.index;
            while index < self.tokens.len() {
                output.push(self.tokens.as_slice()[index].clone());
                index += 1usize;
            }
            output
        }

        pub fun parse<T: Parse>(&mut self) -> Result<T, Error> {
            Parse::parse(self)
        }

        fun consume_all(&mut self) {
            self.index = self.tokens.len();
        }
    }

    pub fun parse<T: Parse>(tokens: TokenStream) -> Result<T, Error> {
        let mut input = ParseStream::new(tokens);
        Parse::parse(&mut input)
    }

    pub fun parse_str<T: Parse>(source: &str) -> Result<T, Error> {
        match TokenStream::from_str(source) {
            Result::Ok(tokens) => parse::<T>(tokens),
            Result::Err(error) => Result::Err(Error::new(error.span(), error.message())),
        }
    }

    fun take_tokens(input: &mut ParseStream, expected: &str) -> Result<TokenStream, Error> {
        if input.is_empty() {
            return Result::Err(Error::new(input.span(), expected));
        }
        let tokens = input.remaining();
        input.consume_all();
        Result::Ok(tokens)
    }

    fun ident_at(tokens: &TokenStream, index: usize, expected: &str) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Ident(value)) => value.as_str() == expected,
            _ => false,
        }
    }

    fun punct_at(tokens: &TokenStream, index: usize, expected: char) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Punct(value)) => value.as_char() == expected,
            _ => false,
        }
    }

    fun group_at(tokens: &TokenStream, index: usize) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(_)) => true,
            _ => false,
        }
    }

    fun parenthesis_at(tokens: &TokenStream, index: usize) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                Delimiter::Parenthesis => true,
                _ => false,
            },
            _ => false,
        }
    }

    fun brace_at(tokens: &TokenStream, index: usize) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                Delimiter::Brace => true,
                _ => false,
            },
            _ => false,
        }
    }

    fun bracket_at(tokens: &TokenStream, index: usize) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                Delimiter::Bracket => true,
                _ => false,
            },
            _ => false,
        }
    }

    fun has_ident(tokens: &TokenStream, expected: &str) -> bool {
        let mut index = 0usize;
        while index < tokens.len() {
            if ident_at(tokens, index, expected) {
                return true;
            }
            index += 1usize;
        }
        false
    }

    fun has_punct(tokens: &TokenStream, expected: char) -> bool {
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, expected) {
                return true;
            }
            index += 1usize;
        }
        false
    }

    fun is_macro_call(tokens: &TokenStream) -> bool {
        let mut index = 1usize;
        while index + 1usize < tokens.len() {
            if punct_at(tokens, index, '!') && group_at(tokens, index + 1usize) {
                return true;
            }
            index += 1usize;
        }
        false
    }

    fun item_keyword_index(tokens: &TokenStream) -> usize {
        let mut index = 0usize;
        while index + 1usize < tokens.len()
            && punct_at(tokens, index, '#')
            && bracket_at(tokens, index + 1usize)
        {
            index += 2usize;
        }
        if ident_at(tokens, index, "pub") {
            index += 1usize;
        }
        if ident_at(tokens, index, "unsafe") {
            index += 1usize;
        }
        index
    }

    fun attribute_end_index(tokens: &TokenStream) -> usize {
        let mut index = 0usize;
        while index + 1usize < tokens.len()
            && punct_at(tokens, index, '#')
            && bracket_at(tokens, index + 1usize)
        {
            index += 2usize;
        }
        index
    }

    fun token_range(tokens: &TokenStream, start: usize, end: usize) -> TokenStream {
        let mut output = TokenStream::new();
        let mut index = start;
        while index < end {
            output.push(tokens.as_slice()[index].clone());
            index += 1usize;
        }
        output
    }

    fun brace_terminates_statement(tokens: &TokenStream, brace: usize, start: usize) -> bool {
        if ident_at(tokens, brace + 1usize, "else") {
            return false;
        }
        let current = token_range(tokens, start, brace + 1usize);
        let item_index = item_keyword_index(&current);
        if ident_at(&current, item_index, "fun") {
            return match current.as_slice().get(item_index + 1usize) {
                Option::Some(TokenTree::Ident(_)) => true,
                _ => false,
            };
        }
        if ident_at(&current, item_index, "struct")
            || ident_at(&current, item_index, "enum")
            || ident_at(&current, item_index, "trait")
            || ident_at(&current, item_index, "impl")
            || ident_at(&current, item_index, "mod")
            || ident_at(&current, item_index, "extern")
        {
            return true;
        }
        let expr_index = attribute_end_index(&current);
        ident_at(&current, expr_index, "if")
            || ident_at(&current, expr_index, "while")
            || ident_at(&current, expr_index, "for")
            || ident_at(&current, expr_index, "match")
            || ident_at(&current, expr_index, "unsafe")
    }

    fun push_statement(
        stmts: &mut Vector<Stmt>,
        tokens: &TokenStream,
        start: usize,
        end: usize
    ) -> Result<(), Error> {
        let current = token_range(tokens, start, end);
        match classify_stmt(&current) {
            Result::Ok(stmt) => {
                stmts.push(stmt);
                Result::Ok(())
            },
            Result::Err(error) => Result::Err(error),
        }
    }

    fun valid_params(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for param in split_top_level(tokens, ',') {
            let mut index = attribute_end_index(&param);
            if punct_at(&param, index, '&') {
                index += 1usize;
                if ident_at(&param, index, "mut") {
                    index += 1usize;
                }
                if !ident_at(&param, index, "self") || index + 1usize != param.len() {
                    return false;
                }
            } else if ident_at(&param, index, "self") {
                if index + 1usize != param.len() {
                    return false;
                }
            } else {
                if ident_at(&param, index, "mut") {
                    index += 1usize;
                }
                match param.as_slice().get(index) {
                    Option::Some(TokenTree::Ident(_)) => index += 1usize,
                    _ => { return false; },
                }
                if !punct_at(&param, index, ':') {
                    return false;
                }
                let ty = token_range(&param, index + 1usize, param.len());
                if ty.is_empty() || !valid_type(&ty) {
                    return false;
                }
            }
        }
        true
    }

    fun valid_function_item(tokens: &TokenStream, keyword: usize) -> bool {
        let mut index = keyword + 1usize;
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Ident(_)) => index += 1usize,
            _ => { return false; },
        }
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, tokens.len());
            if close == index {
                return false;
            }
            let generics = token_range(tokens, index, close);
            match parse_generic_params(&generics) {
                Result::Ok(_) => {},
                Result::Err(_) => { return false; },
            }
            index = close;
        }
        let params = match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                match group.delimiter() {
                    Delimiter::Parenthesis => group,
                    _ => { return false; },
                }
            },
            _ => { return false; },
        };
        if !valid_params(params.stream()) {
            return false;
        }
        index += 1usize;
        if punct_joint_at(tokens, index, '-') && punct_at(tokens, index + 1usize, '>') {
            let mut end = index + 2usize;
            while end < tokens.len()
                && !ident_at(tokens, end, "where")
                && !brace_at(tokens, end)
                && !punct_at(tokens, end, ';')
            {
                end += 1usize;
            }
            let ty = token_range(tokens, index + 2usize, end);
            if ty.is_empty() || !valid_type(&ty) {
                return false;
            }
            index = end;
        }
        if ident_at(tokens, index, "where") {
            let mut end = index + 1usize;
            while end < tokens.len() && !brace_at(tokens, end) && !punct_at(tokens, end, ';') {
                end += 1usize;
            }
            let clause = token_range(tokens, index, end);
            match parse_where_predicates(&clause) {
                Result::Ok(_) => {},
                Result::Err(_) => { return false; },
            }
            index = end;
        }
        if index + 1usize != tokens.len() {
            return false;
        }
        if punct_at(tokens, index, ';') {
            true
        } else {
            match tokens.as_slice().get(index) {
                Option::Some(TokenTree::Group(group)) => valid_block(group),
                _ => false,
            }
        }
    }

    fun valid_const_item(tokens: &TokenStream, keyword: usize) -> bool {
        if !punct_at(tokens, tokens.len() - 1usize, ';') {
            return false;
        }
        match tokens.as_slice().get(keyword + 1usize) {
            Option::Some(TokenTree::Ident(_)) => {},
            _ => { return false; },
        }
        let rest = token_range(tokens, keyword + 2usize, tokens.len() - 1usize);
        let colon = find_top_level_punct(&rest, ':');
        let equals = find_top_level_punct(&rest, '=');
        if colon != 0usize || equals == rest.len() || equals <= colon + 1usize {
            return false;
        }
        let ty = token_range(&rest, colon + 1usize, equals);
        let value = token_range(&rest, equals + 1usize, rest.len());
        !ty.is_empty() && !value.is_empty() && valid_type(&ty) && valid_expr(&value)
    }

    fun valid_type_alias_item(tokens: &TokenStream, keyword: usize) -> bool {
        if !punct_at(tokens, tokens.len() - 1usize, ';') {
            return false;
        }
        match tokens.as_slice().get(keyword + 1usize) {
            Option::Some(TokenTree::Ident(_)) => {},
            _ => { return false; },
        }
        if keyword + 3usize == tokens.len() {
            return true;
        }
        if !punct_at(tokens, keyword + 2usize, '=') { return false; }
        let ty = token_range(tokens, keyword + 3usize, tokens.len() - 1usize);
        !ty.is_empty() && valid_type(&ty)
    }

    fun valid_item_body(tokens: &TokenStream) -> bool {
        if !matches_group_at_end(tokens, Delimiter::Brace) { return false; }
        match tokens.as_slice().get(tokens.len() - 1usize) {
            Option::Some(TokenTree::Group(group)) => {
                match parse::<File>(group.stream().cloned()) {
                    Result::Ok(_) => true,
                    Result::Err(_) => false,
                }
            },
            _ => false,
        }
    }

    fun valid_trait_item(tokens: &TokenStream, keyword: usize) -> bool {
        match tokens.as_slice().get(keyword + 1usize) {
            Option::Some(TokenTree::Ident(_)) => {},
            _ => { return false; },
        }
        let body = tokens.len() - 1usize;
        let mut index = keyword + 2usize;
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, body);
            if close == index { return false; }
            match parse_generic_params(&token_range(tokens, index, close)) {
                Result::Ok(_) => {},
                Result::Err(_) => { return false; },
            }
            index = close;
        }
        if punct_at(tokens, index, ':') {
            let bounds = token_range(tokens, index + 1usize, body);
            if bounds.is_empty() || !valid_bounds(&bounds) { return false; }
            index = body;
        }
        index == body && valid_item_body(tokens)
    }

    fun valid_impl_item(tokens: &TokenStream, keyword: usize) -> bool {
        if ident_at(tokens, attribute_end_index(tokens), "pub") { return false; }
        if !matches_group_at_end(tokens, Delimiter::Brace) { return false; }
        let body = tokens.len() - 1usize;
        let mut index = keyword + 1usize;
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, body);
            if close == index { return false; }
            match parse_generic_params(&token_range(tokens, index, close)) {
                Result::Ok(_) => {},
                Result::Err(_) => { return false; },
            }
            index = close;
        }
        let mut where_index = body;
        let mut for_index = body;
        let mut scan = index;
        while scan < body {
            if ident_at(tokens, scan, "where") && where_index == body { where_index = scan; }
            if ident_at(tokens, scan, "for") && for_index == body { for_index = scan; }
            scan += 1usize;
        }
        let head_end = if where_index < body { where_index } else { body };
        if for_index < head_end {
            let trait_ty = token_range(tokens, index, for_index);
            let self_ty = token_range(tokens, for_index + 1usize, head_end);
            if trait_ty.is_empty() || self_ty.is_empty()
                || !valid_type(&trait_ty) || !valid_type(&self_ty)
            {
                return false;
            }
        } else {
            let self_ty = token_range(tokens, index, head_end);
            if self_ty.is_empty() || !valid_type(&self_ty) { return false; }
        }
        if where_index < body {
            match parse_where_predicates(&token_range(tokens, where_index, body)) {
                Result::Ok(_) => {},
                Result::Err(_) => { return false; },
            }
        }
        valid_item_body(tokens)
    }

    fun valid_extern_members(tokens: &TokenStream) -> bool {
        let mut start = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, ';') {
                let member = token_range(tokens, start, index + 1usize);
                let mut keyword = attribute_end_index(&member);
                if ident_at(&member, keyword, "pub") { keyword += 1usize; }
                if ident_at(&member, keyword, "safe") || ident_at(&member, keyword, "unsafe") {
                    keyword += 1usize;
                }
                if !ident_at(&member, keyword, "fun")
                    || punct_at(&member, keyword + 2usize, '<')
                    || !valid_function_item(&member, keyword)
                {
                    return false;
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        start == tokens.len()
    }

    fun valid_extern_item(tokens: &TokenStream, keyword: usize) -> bool {
        match tokens.as_slice().get(keyword + 1usize) {
            Option::Some(TokenTree::Literal(_)) => {},
            _ => { return false; },
        }
        if ident_at(tokens, keyword + 2usize, "fun") {
            return matches_group_at_end(tokens, Delimiter::Brace)
                && valid_function_item(tokens, keyword + 2usize);
        }
        if keyword + 3usize != tokens.len() || !brace_at(tokens, keyword + 2usize) {
            return false;
        }
        let prefix = attribute_end_index(tokens);
        let unsafe_index = if ident_at(tokens, prefix, "pub") { prefix + 1usize } else { prefix };
        if !ident_at(tokens, unsafe_index, "unsafe") { return false; }
        match tokens.as_slice().get(keyword + 2usize) {
            Option::Some(TokenTree::Group(group)) => valid_extern_members(group.stream()),
            _ => false,
        }
    }

    fun valid_item(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return false;
        }
        let index = item_keyword_index(tokens);
        if ident_at(tokens, index, "struct") || ident_at(tokens, index, "enum") {
            return match parse::<DeriveInput>(tokens.cloned()) {
                Result::Ok(_) => true,
                Result::Err(_) => false,
            };
        }
        if ident_at(tokens, index, "fun") {
            return valid_function_item(tokens, index);
        }
        if ident_at(tokens, index, "mod") {
            match tokens.as_slice().get(index + 1usize) {
                Option::Some(TokenTree::Ident(_)) => {},
                _ => { return false; },
            }
            if index + 3usize != tokens.len() {
                return false;
            }
            if punct_at(tokens, index + 2usize, ';') {
                return true;
            }
            return match tokens.as_slice().get(index + 2usize) {
                Option::Some(TokenTree::Group(group)) => valid_block(group),
                _ => false,
            };
        }
        if ident_at(tokens, index, "use") {
            return index + 2usize < tokens.len()
                && punct_at(tokens, tokens.len() - 1usize, ';');
        }
        if ident_at(tokens, index, "const") {
            return valid_const_item(tokens, index);
        }
        if ident_at(tokens, index, "type") {
            return valid_type_alias_item(tokens, index);
        }
        if ident_at(tokens, index, "trait") {
            return valid_trait_item(tokens, index);
        }
        if ident_at(tokens, index, "impl") {
            return valid_impl_item(tokens, index);
        }
        if ident_at(tokens, index, "extern") {
            return valid_extern_item(tokens, index);
        }
        false
    }

    fun matches_group_at_end(tokens: &TokenStream, expected: Delimiter) -> bool {
        if tokens.is_empty() {
            return false;
        }
        match tokens.as_slice().get(tokens.len() - 1usize) {
            Option::Some(TokenTree::Group(group)) => {
                match (group.delimiter(), expected) {
                    (Delimiter::Parenthesis, Delimiter::Parenthesis) => true,
                    (Delimiter::Brace, Delimiter::Brace) => true,
                    (Delimiter::Bracket, Delimiter::Bracket) => true,
                    (Delimiter::None, Delimiter::None) => true,
                    _ => false,
                }
            },
            _ => false,
        }
    }

    fun classify_item(tokens: &TokenStream) -> Result<Item, Error> {
        let keyword = item_keyword_index(tokens);
        if ident_at(tokens, keyword, "fun") && keyword + 2usize == tokens.len() {
            return Result::Err(Error::new(
                tokens_span(tokens),
                "expected function parameter list"
            ));
        }
        if !valid_item(tokens) {
            return Result::Err(Error::new(tokens_span(tokens), "invalid item syntax"));
        }
        let index = keyword;
        if ident_at(tokens, index, "mod") {
            Result::Ok(Item::Module(tokens.cloned()))
        } else if ident_at(tokens, index, "use") {
            Result::Ok(Item::Use(tokens.cloned()))
        } else if ident_at(tokens, index, "fun") {
            Result::Ok(Item::Function(tokens.cloned()))
        } else if ident_at(tokens, index, "struct") {
            Result::Ok(Item::Struct(tokens.cloned()))
        } else if ident_at(tokens, index, "enum") {
            Result::Ok(Item::Enum(tokens.cloned()))
        } else if ident_at(tokens, index, "trait") {
            Result::Ok(Item::Trait(tokens.cloned()))
        } else if ident_at(tokens, index, "impl") {
            Result::Ok(Item::Impl(tokens.cloned()))
        } else if ident_at(tokens, index, "const") {
            Result::Ok(Item::Const(tokens.cloned()))
        } else if ident_at(tokens, index, "type") {
            Result::Ok(Item::TypeAlias(tokens.cloned()))
        } else if ident_at(tokens, index, "extern") {
            Result::Ok(Item::Extern(tokens.cloned()))
        } else {
            Result::Err(Error::new(tokens.as_slice()[0usize].span(), "expected item"))
        }
    }

    fun is_item(tokens: &TokenStream) -> bool {
        let index = item_keyword_index(tokens);
        ident_at(tokens, index, "mod")
            || ident_at(tokens, index, "use")
            || ident_at(tokens, index, "fun")
            || ident_at(tokens, index, "struct")
            || ident_at(tokens, index, "enum")
            || ident_at(tokens, index, "trait")
            || ident_at(tokens, index, "impl")
            || ident_at(tokens, index, "const")
            || ident_at(tokens, index, "type")
            || ident_at(tokens, index, "extern")
    }

    fun classify_stmt(tokens: &TokenStream) -> Result<Stmt, Error> {
        let index = item_keyword_index(tokens);
        if is_item(tokens) {
            match classify_item(tokens) {
                Result::Ok(item) => Result::Ok(Stmt::Item(item)),
                Result::Err(error) => Result::Err(error),
            }
        } else if ident_at(tokens, index, "let") {
            if !valid_local_stmt(tokens, index) {
                Result::Err(Error::new(tokens_span(tokens), "invalid let statement syntax"))
            } else {
                Result::Ok(Stmt::Local(tokens.cloned()))
            }
        } else if ident_at(tokens, index, "break") {
            if index + 2usize != tokens.len() || !punct_at(tokens, index + 1usize, ';') {
                Result::Err(Error::new(tokens_span(tokens), "invalid break statement syntax"))
            } else {
                Result::Ok(Stmt::Break(tokens.cloned()))
            }
        } else if ident_at(tokens, index, "continue") {
            if index + 2usize == tokens.len() && punct_at(tokens, index + 1usize, ';') {
                Result::Ok(Stmt::Continue(tokens.cloned()))
            } else {
                Result::Err(Error::new(tokens_span(tokens), "invalid continue statement syntax"))
            }
        } else if ident_at(tokens, index, "return") {
            if !valid_control_stmt(tokens, index) {
                Result::Err(Error::new(tokens_span(tokens), "invalid return statement syntax"))
            } else {
                Result::Ok(Stmt::Return(tokens.cloned()))
            }
        } else {
            let valid = if punct_at(tokens, tokens.len() - 1usize, ';') {
                let expr = token_range(tokens, 0usize, tokens.len() - 1usize);
                valid_expr(&expr)
            } else {
                valid_expr(tokens)
            };
            if valid {
                Result::Ok(Stmt::Expr(tokens.cloned()))
            } else {
                Result::Err(Error::new(tokens_span(tokens), "invalid expression statement syntax"))
            }
        }
    }

    fun valid_control_stmt(tokens: &TokenStream, keyword: usize) -> bool {
        if tokens.len() < keyword + 2usize || !punct_at(tokens, tokens.len() - 1usize, ';') {
            return false;
        }
        if keyword + 2usize == tokens.len() {
            return true;
        }
        let value = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
        valid_expr(&value)
    }

    fun valid_local_stmt(tokens: &TokenStream, keyword: usize) -> bool {
        if tokens.len() < keyword + 3usize || !punct_at(tokens, tokens.len() - 1usize, ';') {
            return false;
        }
        let body = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
        let equals = find_top_level_punct(&body, '=');
        if equals == 0usize || equals + 1usize == body.len() {
            return false;
        }
        let left_end = if equals < body.len() { equals } else { body.len() };
        let left = token_range(&body, 0usize, left_end);
        let colon = find_top_level_punct(&left, ':');
        let pat_end = if colon < left.len() { colon } else { left.len() };
        let pat = token_range(&left, 0usize, pat_end);
        if !valid_pat(&pat) { return false; }
        if colon < left.len() {
            let ty = token_range(&left, colon + 1usize, left.len());
            if ty.is_empty() || !valid_type(&ty) { return false; }
        }
        if equals < body.len() {
            let value = token_range(&body, equals + 1usize, body.len());
            valid_expr(&value)
        } else {
            true
        }
    }

    fun classify_expr(tokens: &TokenStream) -> Result<Expr, Error> {
        if !valid_expr(tokens) {
            return Result::Err(Error::new(tokens_span(tokens), "invalid expression syntax"));
        }
        let start = attribute_end_index(tokens);
        let last = tokens.len() - 1usize;
        if ident_at(tokens, start, "if") {
            return Result::Ok(Expr::If(tokens.cloned()));
        }
        if ident_at(tokens, start, "while") {
            return Result::Ok(Expr::While(tokens.cloned()));
        }
        if ident_at(tokens, start, "for") {
            return Result::Ok(Expr::For(tokens.cloned()));
        }
        if ident_at(tokens, start, "match") {
            return Result::Ok(Expr::Match(tokens.cloned()));
        }
        if ident_at(tokens, start, "unsafe") {
            return Result::Ok(Expr::Unsafe(tokens.cloned()));
        }
        if is_bracket_lambda_start(tokens, start) {
            return Result::Ok(Expr::Closure(tokens.cloned()));
        }
        if expr_binary_split(tokens) < tokens.len() {
            return Result::Ok(Expr::Binary(tokens.cloned()));
        }
        if expr_cast_split(tokens) < tokens.len() {
            return Result::Ok(Expr::Cast(tokens.cloned()));
        }
        if punct_at(tokens, last, '?') {
            return Result::Ok(Expr::Try(tokens.cloned()));
        }
        let path_end = consume_path(tokens, start, tokens.len());
        if path_end > start
            && punct_at(tokens, path_end, '!')
            && group_at(tokens, path_end + 1usize)
            && path_end + 2usize == tokens.len()
        {
            return Result::Ok(Expr::Macro(tokens.cloned()));
        }
        if brace_at(tokens, last) {
            if start == last {
                return Result::Ok(Expr::Block(tokens.cloned()));
            }
            return Result::Ok(Expr::Struct(tokens.cloned()));
        }
        if parenthesis_at(tokens, last) {
            if start == last {
                return Result::Ok(Expr::Tuple(tokens.cloned()));
            }
            return Result::Ok(Expr::Call(tokens.cloned()));
        }
        if bracket_at(tokens, last) {
            if start == last {
                return Result::Ok(Expr::Array(tokens.cloned()));
            }
            return Result::Ok(Expr::Index(tokens.cloned()));
        }
        if has_punct(tokens, '.') {
            return Result::Ok(Expr::Field(tokens.cloned()));
        }
        if punct_at(tokens, start, '+')
            || punct_at(tokens, start, '-')
            || punct_at(tokens, start, '&')
            || punct_at(tokens, start, '*')
            || punct_at(tokens, start, '!')
        {
            return Result::Ok(Expr::Unary(tokens.cloned()));
        }
        match tokens.as_slice().get(start) {
            Option::Some(TokenTree::Literal(_)) => Result::Ok(Expr::Literal(tokens.cloned())),
            _ => {
                if ident_at(tokens, start, "true") || ident_at(tokens, start, "false") {
                    Result::Ok(Expr::Literal(tokens.cloned()))
                } else {
                    Result::Ok(Expr::Path(tokens.cloned()))
                }
            },
        }
    }

    fun punct_joint_at(tokens: &TokenStream, index: usize, expected: char) -> bool {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Punct(value)) => {
                if value.as_char() != expected {
                    false
                } else {
                    match value.spacing() {
                        crate::Spacing::Joint => true,
                        crate::Spacing::Alone => false,
                    }
                }
            },
            _ => false,
        }
    }

    fun valid_expr_list(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for expression in split_top_level(tokens, ',') {
            if !valid_expr(&expression) {
                return false;
            }
        }
        true
    }

    fun valid_block(group: &Group) -> bool {
        match group.delimiter() {
            Delimiter::Brace => {
                if group.stream().is_empty() || valid_expr(group.stream()) {
                    true
                } else {
                    match parse::<File>(group.stream().cloned()) {
                        Result::Ok(_) => true,
                        Result::Err(_) => false,
                    }
                }
            },
            _ => false,
        }
    }

    fun valid_expr_group(group: &Group) -> bool {
        match group.delimiter() {
            Delimiter::Parenthesis => valid_expr_list(group.stream()),
            Delimiter::Bracket => {
                let parts = split_top_level(group.stream(), ';');
                if parts.is_empty() {
                    true
                } else if parts.len() == 1usize {
                    valid_expr_list(&parts.as_slice()[0usize])
                } else if parts.len() == 2usize {
                    valid_expr(&parts.as_slice()[0usize])
                        && valid_expr(&parts.as_slice()[1usize])
                } else {
                    false
                }
            },
            Delimiter::Brace => valid_block(group),
            Delimiter::None => valid_expr(group.stream()),
        }
    }

    fun valid_struct_expr_fields(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for field in split_top_level(tokens, ',') {
            match field.as_slice().get(0usize) {
                Option::Some(TokenTree::Ident(_)) => {},
                _ => { return false; },
            }
            if field.len() > 1usize {
                if !punct_at(&field, 1usize, ':') || punct_at(&field, 2usize, ':') {
                    return false;
                }
                let value = token_range(&field, 2usize, field.len());
                if value.is_empty() || !valid_expr(&value) {
                    return false;
                }
            }
        }
        true
    }

    fun binary_operator_end(tokens: &TokenStream, index: usize) -> usize {
        let value = match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Punct(value)) => value.as_char(),
            _ => { return index; },
        };
        if value == '!' {
            if punct_joint_at(tokens, index, '!') && punct_at(tokens, index + 1usize, '=') {
                return index + 2usize;
            }
            return index;
        }
        if value != '='
            && value != '+'
            && value != '-'
            && value != '*'
            && value != '/'
            && value != '%'
            && value != '&'
            && value != '|'
            && value != '^'
            && value != '<'
            && value != '>'
        {
            return index;
        }
        let mut end = index + 1usize;
        if punct_joint_at(tokens, index, value)
            && punct_at(tokens, end, value)
            && (value == '&' || value == '|' || value == '<' || value == '>')
        {
            end += 1usize;
        }
        if punct_at(tokens, end, '=')
            && punct_joint_at(tokens, end - 1usize, match tokens.as_slice().get(end - 1usize) {
                Option::Some(TokenTree::Punct(punct)) => punct.as_char(),
                _ => value,
            })
        {
            end += 1usize;
        }
        end
    }

    fun expr_binary_split(tokens: &TokenStream) -> usize {
        let mut index = attribute_end_index(tokens) + 1usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<')
                && index >= 2usize
                && punct_at(tokens, index - 1usize, ':')
                && punct_at(tokens, index - 2usize, ':')
            {
                let close = matching_angle_end(tokens, index, tokens.len());
                if close > index {
                    index = close;
                    continue;
                }
            }
            let operator_end = binary_operator_end(tokens, index);
            if operator_end > index && operator_end < tokens.len() {
                let left = token_range(tokens, 0usize, index);
                let right = token_range(tokens, operator_end, tokens.len());
                if valid_expr(&left) && valid_expr(&right) {
                    return index;
                }
            }
            index += 1usize;
        }
        tokens.len()
    }

    fun expr_cast_split(tokens: &TokenStream) -> usize {
        let mut index = attribute_end_index(tokens) + 1usize;
        while index < tokens.len() {
            if ident_at(tokens, index, "as") {
                let left = token_range(tokens, 0usize, index);
                let right = token_range(tokens, index + 1usize, tokens.len());
                if valid_expr(&left) && valid_type(&right) {
                    return index;
                }
            }
            index += 1usize;
        }
        tokens.len()
    }

    fun first_brace(tokens: &TokenStream, start: usize) -> usize {
        let mut index = start;
        while index < tokens.len() {
            if brace_at(tokens, index) {
                return index;
            }
            index += 1usize;
        }
        tokens.len()
    }

    fun valid_if_expr(tokens: &TokenStream) -> bool {
        let brace = first_brace(tokens, 1usize);
        if brace == tokens.len() {
            return false;
        }
        let condition = token_range(tokens, 1usize, brace);
        let group = match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => group,
            _ => { return false; },
        };
        if condition.is_empty() || !valid_expr(&condition) || !valid_block(group) {
            return false;
        }
        if brace + 1usize == tokens.len() {
            return true;
        }
        if !ident_at(tokens, brace + 1usize, "else") {
            return false;
        }
        let tail = token_range(tokens, brace + 2usize, tokens.len());
        if tail.is_empty() {
            return false;
        }
        if ident_at(&tail, 0usize, "if") {
            valid_if_expr(&tail)
        } else {
            if tail.len() != 1usize {
                false
            } else {
                match tail.as_slice().get(0usize) {
                    Option::Some(TokenTree::Group(group)) => valid_block(group),
                    _ => false,
                }
            }
        }
    }

    fun valid_loop_expr(tokens: &TokenStream, is_for: bool) -> bool {
        let brace = first_brace(tokens, 1usize);
        if brace == tokens.len() || brace + 1usize != tokens.len() {
            return false;
        }
        let group = match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => group,
            _ => { return false; },
        };
        if !valid_block(group) {
            return false;
        }
        let start = if is_for {
            let has_binding = match tokens.as_slice().get(1usize) {
                Option::Some(TokenTree::Ident(_)) => true,
                _ => false,
            };
            if !has_binding || !ident_at(tokens, 2usize, "in") {
                return false;
            }
            3usize
        } else {
            1usize
        };
        let condition = token_range(tokens, start, brace);
        !condition.is_empty() && valid_expr(&condition)
    }

    fun valid_match_arms(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for arm in split_top_level(tokens, ',') {
            let mut arrow = 0usize;
            while arrow + 1usize < arm.len()
                && !(punct_joint_at(&arm, arrow, '=') && punct_at(&arm, arrow + 1usize, '>'))
            {
                arrow += 1usize;
            }
            if arrow + 1usize >= arm.len() {
                return false;
            }
            let mut guard = arrow;
            let mut index = 0usize;
            while index < arrow {
                if ident_at(&arm, index, "if") {
                    guard = index;
                    break;
                }
                index += 1usize;
            }
            let pattern = token_range(&arm, 0usize, guard);
            if pattern.is_empty() || !valid_pat(&pattern) {
                return false;
            }
            if guard < arrow {
                let condition = token_range(&arm, guard + 1usize, arrow);
                if condition.is_empty() || !valid_expr(&condition) {
                    return false;
                }
            }
            let value = token_range(&arm, arrow + 2usize, arm.len());
            if value.is_empty() || !valid_expr(&value) {
                return false;
            }
        }
        true
    }

    fun valid_match_expr(tokens: &TokenStream) -> bool {
        let brace = first_brace(tokens, 1usize);
        if brace == tokens.len() || brace + 1usize != tokens.len() {
            return false;
        }
        let value = token_range(tokens, 1usize, brace);
        if value.is_empty() || !valid_expr(&value) {
            return false;
        }
        match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => valid_match_arms(group.stream()),
            _ => false,
        }
    }

    fun valid_lambda_params(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for param in split_top_level(tokens, ',') {
            let mut index = attribute_end_index(&param);
            if ident_at(&param, index, "mut") {
                index += 1usize;
            }
            match param.as_slice().get(index) {
                Option::Some(TokenTree::Ident(_)) => index += 1usize,
                Option::Some(TokenTree::Group(group)) => {
                    match group.delimiter() {
                        Delimiter::Parenthesis => index += 1usize,
                        _ => { return false; },
                    }
                },
                _ => { return false; },
            }
            if index < param.len() {
                if !punct_at(&param, index, ':') {
                    return false;
                }
                let ty = token_range(&param, index + 1usize, param.len());
                if ty.is_empty() || !valid_type(&ty) {
                    return false;
                }
            }
        }
        true
    }

    fun valid_lambda_expr(tokens: &TokenStream) -> bool {
        let mut index = 0usize;
        if ident_at(tokens, index, "move") {
            index += 1usize;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                if index + 1usize != tokens.len() {
                    return false;
                }
                match group.delimiter() {
                    Delimiter::Bracket => {},
                    _ => { return false; },
                }
                let stream = group.stream();
                let arrow = find_top_level_arrow(stream);
                if arrow >= stream.len() {
                    return false;
                }
                if !valid_lambda_params(&token_range(stream, 0usize, arrow)) {
                    return false;
                }
                let body = token_range(stream, arrow + 2usize, stream.len());
                if body.is_empty() {
                    return false;
                }
                return valid_expr(&body);
            },
            _ => false,
        }
    }

    /// Index of the `-` of a top-level `->`, or `tokens.len()` when absent.
    fun find_top_level_arrow(tokens: &TokenStream) -> usize {
        let mut angle_depth = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_joint_at(tokens, index, '-') && punct_at(tokens, index + 1usize, '>') {
                if angle_depth == 0usize {
                    return index;
                }
                index += 2usize;
                continue;
            }
            if punct_at(tokens, index, '<') {
                angle_depth += 1usize;
            } else if punct_at(tokens, index, '>') && angle_depth > 0usize {
                angle_depth -= 1usize;
            }
            index += 1usize;
        }
        tokens.len()
    }

    /// `move`? `[params -> body]`: true when the token at `start` begins a
    /// bracket lambda.
    fun is_bracket_lambda_start(tokens: &TokenStream, start: usize) -> bool {
        let mut index = start;
        if ident_at(tokens, index, "move") {
            index += 1usize;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                match group.delimiter() {
                    Delimiter::Bracket => {},
                    _ => { return false; },
                }
                find_top_level_arrow(group.stream()) < group.stream().len()
            },
            _ => false,
        }
    }

    fun valid_expr(tokens: &TokenStream) -> bool {
        let start = attribute_end_index(tokens);
        if start == tokens.len() {
            return false;
        }
        let body = if start == 0usize {
            tokens.cloned()
        } else {
            token_range(tokens, start, tokens.len())
        };
        if ident_at(&body, 0usize, "if") {
            return valid_if_expr(&body);
        }
        if ident_at(&body, 0usize, "while") {
            return valid_loop_expr(&body, false);
        }
        if ident_at(&body, 0usize, "for") {
            return valid_loop_expr(&body, true);
        }
        if ident_at(&body, 0usize, "match") {
            return valid_match_expr(&body);
        }
        if ident_at(&body, 0usize, "unsafe") {
            if body.len() != 2usize {
                return false;
            }
            return match body.as_slice().get(1usize) {
                Option::Some(TokenTree::Group(group)) => valid_block(group),
                _ => false,
            };
        }
        if is_bracket_lambda_start(&body, 0usize) {
            return valid_lambda_expr(&body);
        }
        if expr_binary_split(&body) < body.len() || expr_cast_split(&body) < body.len() {
            return true;
        }
        let end = body.len();
        let mut index = 0usize;
        if punct_at(&body, index, '+')
            || punct_at(&body, index, '-')
            || punct_at(&body, index, '*')
            || punct_at(&body, index, '!')
            || punct_at(&body, index, '&')
        {
            index += 1usize;
            if punct_at(&body, 0usize, '&') && ident_at(&body, index, "mut") {
                index += 1usize;
            } else if punct_at(&body, 0usize, '&') && punct_at(&body, index, '&') {
                index += 1usize;
            }
            if index >= end {
                return false;
            }
            if index + 1usize == end {
                return match body.as_slice().get(index) {
                    Option::Some(TokenTree::Ident(_)) => true,
                    Option::Some(TokenTree::Literal(_)) => true,
                    Option::Some(TokenTree::Group(group)) => valid_expr_group(group),
                    _ => false,
                };
            }
            let inner = token_range(&body, index, end);
            return valid_expr(&inner);
        }
        let mut can_struct = false;
        match body.as_slice().get(index) {
            Option::Some(TokenTree::Literal(_)) => index += 1usize,
            Option::Some(TokenTree::Group(group)) => {
                if !valid_expr_group(group) {
                    return false;
                }
                index += 1usize;
            },
            Option::Some(TokenTree::Ident(_)) => {
                if ident_at(&body, index, "true") || ident_at(&body, index, "false") {
                    index += 1usize;
                } else {
                    let path_end = consume_path(&body, index, end);
                    if path_end == index {
                        return false;
                    }
                    index = path_end;
                    can_struct = true;
                    if punct_at(&body, index, '!') && group_at(&body, index + 1usize) {
                        index += 2usize;
                        can_struct = false;
                    }
                }
            },
            Option::Some(TokenTree::Punct(_)) => {
                let path_end = consume_path(&body, index, end);
                if path_end == index {
                    return false;
                }
                index = path_end;
                can_struct = true;
                if punct_at(&body, index, '!') && group_at(&body, index + 1usize) {
                    index += 2usize;
                    can_struct = false;
                }
            },
            _ => { return false; },
        }
        while index < end {
            if punct_at(&body, index, ':')
                && punct_at(&body, index + 1usize, ':')
                && punct_at(&body, index + 2usize, '<')
            {
                let close = matching_angle_end(&body, index + 2usize, end);
                if close == index + 2usize {
                    return false;
                }
                let arguments = token_range(&body, index + 3usize, close - 1usize);
                if !valid_type_arguments(&arguments) {
                    return false;
                }
                index = close;
                continue;
            }
            match body.as_slice().get(index) {
                Option::Some(TokenTree::Group(group)) => {
                    match group.delimiter() {
                        Delimiter::Parenthesis => {
                            if !valid_expr_list(group.stream()) { return false; }
                        },
                        Delimiter::Bracket => {
                            if group.stream().is_empty() || !valid_expr(group.stream()) { return false; }
                        },
                        Delimiter::Brace => {
                            if !can_struct || !valid_struct_expr_fields(group.stream()) { return false; }
                        },
                        Delimiter::None => {
                            if !valid_expr(group.stream()) { return false; }
                        },
                    }
                    index += 1usize;
                    can_struct = false;
                },
                Option::Some(TokenTree::Punct(punct)) if punct.as_char() == '.' => {
                    match body.as_slice().get(index + 1usize) {
                        Option::Some(TokenTree::Ident(_)) => {
                            index += 2usize;
                            can_struct = false;
                        },
                        Option::Some(TokenTree::Literal(_)) => {
                            index += 2usize;
                            can_struct = false;
                        },
                        _ => { return false; },
                    }
                },
                Option::Some(TokenTree::Punct(punct)) if punct.as_char() == '?' => {
                    index += 1usize;
                    can_struct = false;
                },
                _ => { return false; },
            }
        }
        true
    }

    fun reserved_ident_at(tokens: &TokenStream, index: usize) -> bool {
        ident_at(tokens, index, "as")
            || ident_at(tokens, index, "break")
            || ident_at(tokens, index, "const")
            || ident_at(tokens, index, "continue")
            || ident_at(tokens, index, "else")
            || ident_at(tokens, index, "enum")
            || ident_at(tokens, index, "extern")
            || ident_at(tokens, index, "false")
            || ident_at(tokens, index, "for")
            || ident_at(tokens, index, "fun")
            || ident_at(tokens, index, "if")
            || ident_at(tokens, index, "impl")
            || ident_at(tokens, index, "in")
            || ident_at(tokens, index, "let")
            || ident_at(tokens, index, "match")
            || ident_at(tokens, index, "mod")
            || ident_at(tokens, index, "move")
            || ident_at(tokens, index, "mut")
            || ident_at(tokens, index, "pub")
            || ident_at(tokens, index, "return")
            || ident_at(tokens, index, "safe")
            || ident_at(tokens, index, "struct")
            || ident_at(tokens, index, "trait")
            || ident_at(tokens, index, "true")
            || ident_at(tokens, index, "type")
            || ident_at(tokens, index, "unsafe")
            || ident_at(tokens, index, "use")
            || ident_at(tokens, index, "where")
            || ident_at(tokens, index, "while")
    }

    fun consume_path(tokens: &TokenStream, start: usize, end: usize) -> usize {
        let mut index = start;
        if punct_at(tokens, index, ':') && punct_at(tokens, index + 1usize, ':') {
            index += 2usize;
        }
        if reserved_ident_at(tokens, index) { return start; }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Ident(_)) => index += 1usize,
            _ => { return start; },
        }
        while index + 2usize < end
            && punct_at(tokens, index, ':')
            && punct_at(tokens, index + 1usize, ':')
        {
            if reserved_ident_at(tokens, index + 2usize) { return start; }
            match tokens.as_slice().get(index + 2usize) {
                Option::Some(TokenTree::Ident(_)) => index += 3usize,
                _ => { return start; },
            }
        }
        index
    }

    fun matching_angle_end(tokens: &TokenStream, start: usize, end: usize) -> usize {
        if !punct_at(tokens, start, '<') {
            return start;
        }
        let mut depth = 0usize;
        let mut index = start;
        while index < end {
            if punct_at(tokens, index, '<') {
                depth += 1usize;
            } else if punct_at(tokens, index, '>') {
                if depth == 0usize {
                    return start;
                }
                depth -= 1usize;
                if depth == 0usize {
                    return index + 1usize;
                }
            }
            index += 1usize;
        }
        start
    }

    fun valid_type_arguments(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for argument in split_top_level(tokens, ',') {
            if !valid_type(&argument) {
                return false;
            }
        }
        true
    }

    fun valid_bound_arguments(tokens: &TokenStream) -> bool {
        if tokens.is_empty() { return true; }
        for argument in split_top_level(tokens, ',') {
            let equals = find_top_level_punct(&argument, '=');
            if equals < argument.len() {
                if equals != 1usize {
                    return false;
                }
                match argument.as_slice().get(0usize) {
                    Option::Some(TokenTree::Ident(_)) => {},
                    _ => { return false; },
                }
                let value = token_range(&argument, equals + 1usize, argument.len());
                if value.is_empty() || !valid_type(&value) { return false; }
            } else if !valid_type(&argument) {
                return false;
            }
        }
        true
    }

    fun valid_type_group(group: &Group) -> bool {
        match group.delimiter() {
            Delimiter::Parenthesis => valid_type_arguments(group.stream()),
            Delimiter::Bracket => {
                let parts = split_top_level(group.stream(), ';');
                if parts.len() == 1usize {
                    valid_type(&parts.as_slice()[0usize])
                } else if parts.len() == 2usize {
                    valid_type(&parts.as_slice()[0usize])
                        && valid_expr(&parts.as_slice()[1usize])
                } else {
                    false
                }
            },
            _ => false,
        }
    }

    fun valid_bound(tokens: &TokenStream) -> bool {
        let end = tokens.len();
        let mut index = consume_path(tokens, 0usize, end);
        if index == 0usize {
            return false;
        }
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, end);
            if close == index {
                return false;
            }
            let arguments = token_range(tokens, index + 1usize, close - 1usize);
            if !valid_bound_arguments(&arguments) {
                return false;
            }
            index = close;
        } else {
            match tokens.as_slice().get(index) {
                Option::Some(TokenTree::Group(group)) => {
                    if !valid_type_arguments(group.stream()) {
                        return false;
                    }
                    index += 1usize;
                    if punct_joint_at(tokens, index, '-') && punct_at(tokens, index + 1usize, '>') {
                        let output = token_range(tokens, index + 2usize, end);
                        return !output.is_empty() && valid_type(&output);
                    }
                },
                _ => {},
            }
        }
        index == end
    }

    fun valid_bounds(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return false;
        }
        for bound in split_top_level(tokens, '+') {
            if !valid_bound(&bound) {
                return false;
            }
        }
        true
    }

    fun valid_type(tokens: &TokenStream) -> bool {
        let start = attribute_end_index(tokens);
        if start == tokens.len() {
            return false;
        }
        if ident_at(tokens, start, "impl") {
            let bounds = token_range(tokens, start + 1usize, tokens.len());
            return valid_bounds(&bounds);
        }
        if consume_path(tokens, start, tokens.len()) == tokens.len() {
            return true;
        }
        let body = token_range(tokens, start, tokens.len());
        let end = body.len();
        if punct_at(&body, 0usize, '!') {
            return end == 1usize;
        }
        if punct_at(&body, 0usize, '&') {
            let mut index = 1usize;
            if punct_at(&body, index, '&') {
                index += 1usize;
            } else if ident_at(&body, index, "mut") {
                index += 1usize;
            }
            if index >= end {
                return false;
            }
            let inner = token_range(&body, index, end);
            return valid_type(&inner);
        }
        if punct_at(&body, 0usize, '*') {
            if !ident_at(&body, 1usize, "const") && !ident_at(&body, 1usize, "mut") {
                return false;
            }
            if end <= 2usize {
                return false;
            }
            let inner = token_range(&body, 2usize, end);
            return valid_type(&inner);
        }
        match body.as_slice().get(0usize) {
            Option::Some(TokenTree::Group(group)) => {
                return end == 1usize && valid_type_group(group);
            },
            Option::Some(TokenTree::Literal(literal)) => {
                let text = literal.as_str().as_bytes();
                return end == 1usize
                    && !text.is_empty()
                    && text[0usize] >= 48u8
                    && text[0usize] <= 57u8;
            },
            _ => {},
        }
        let path_end = consume_path(&body, 0usize, end);
        if path_end == 0usize {
            return false;
        }
        if path_end == end {
            return true;
        }
        if punct_at(&body, path_end, '!') && group_at(&body, path_end + 1usize) {
            return path_end + 2usize == end;
        }
        if punct_at(&body, path_end, '<') {
            let close = matching_angle_end(&body, path_end, end);
            if close != end {
                return false;
            }
            let arguments = token_range(&body, path_end + 1usize, close - 1usize);
            return valid_type_arguments(&arguments);
        }
        false
    }

    fun classify_type(tokens: &TokenStream) -> Result<Type, Error> {
        let start = attribute_end_index(tokens);
        if start + 1usize == tokens.len()
            && (punct_at(tokens, start, '&') || punct_at(tokens, start, '*'))
        {
            return Result::Err(Error::new(tokens_span(tokens), "incomplete type syntax"));
        }
        if !valid_type(tokens) {
            return Result::Err(Error::new(tokens_span(tokens), "invalid type syntax"));
        }
        match tokens.as_slice().get(0usize) {
            Option::Some(TokenTree::Literal(_)) => {
                return Result::Ok(Type::Const(tokens.cloned()));
            },
            _ => {},
        }
        if punct_at(tokens, start, '!') {
            Result::Ok(Type::Never(tokens.cloned()))
        } else if punct_at(tokens, start, '&') {
            Result::Ok(Type::Reference(tokens.cloned()))
        } else if punct_at(tokens, start, '*') {
            Result::Ok(Type::Pointer(tokens.cloned()))
        } else if parenthesis_at(tokens, start) {
            Result::Ok(Type::Tuple(tokens.cloned()))
        } else if bracket_at(tokens, start) {
            Result::Ok(Type::Array(tokens.cloned()))
        } else if ident_at(tokens, start, "impl") {
            Result::Ok(Type::ImplTrait(tokens.cloned()))
        } else if is_macro_call(tokens) {
            Result::Ok(Type::Macro(tokens.cloned()))
        } else {
            Result::Ok(Type::Path(tokens.cloned()))
        }
    }

    fun valid_pattern_fields(tokens: &TokenStream) -> bool {
        if tokens.is_empty() {
            return true;
        }
        for field in split_top_level(tokens, ',') {
            let mut index = attribute_end_index(&field);
            match field.as_slice().get(index) {
                Option::Some(TokenTree::Ident(_)) => index += 1usize,
                _ => { return false; },
            }
            if index < field.len() {
                if !punct_at(&field, index, ':') || punct_at(&field, index + 1usize, ':') {
                    return false;
                }
                let pattern = token_range(&field, index + 1usize, field.len());
                if pattern.is_empty() || !valid_pat(&pattern) {
                    return false;
                }
            }
        }
        true
    }

    fun valid_pat(tokens: &TokenStream) -> bool {
        let start = attribute_end_index(tokens);
        if start == tokens.len() {
            return false;
        }
        let body = token_range(tokens, start, tokens.len());
        let end = body.len();
        if ident_at(&body, 0usize, "mut") {
            let binding = match body.as_slice().get(1usize) {
                Option::Some(TokenTree::Ident(_)) => true,
                _ => false,
            };
            return end == 2usize && binding;
        }
        if punct_at(&body, 0usize, '&') {
            let mut index = 1usize;
            if punct_at(&body, index, '&') {
                index += 1usize;
            }
            if ident_at(&body, index, "mut") {
                index += 1usize;
            }
            if index >= end {
                return false;
            }
            let inner = token_range(&body, index, end);
            return valid_pat(&inner);
        }
        match body.as_slice().get(0usize) {
            Option::Some(TokenTree::Literal(_)) => { return end == 1usize; },
            Option::Some(TokenTree::Group(group)) => {
                if end != 1usize {
                    return false;
                }
                match group.delimiter() {
                    Delimiter::Parenthesis => {
                        for pattern in split_top_level(group.stream(), ',') {
                            if !valid_pat(&pattern) {
                                return false;
                            }
                        }
                        return true;
                    },
                    _ => { return false; },
                }
            },
            _ => {},
        }
        if ident_at(&body, 0usize, "true") || ident_at(&body, 0usize, "false") {
            return end == 1usize;
        }
        let path_end = consume_path(&body, 0usize, end);
        if path_end == 0usize {
            return false;
        }
        if path_end == end {
            return true;
        }
        if punct_at(&body, path_end, '!') && group_at(&body, path_end + 1usize) {
            return path_end + 2usize == end;
        }
        match body.as_slice().get(path_end) {
            Option::Some(TokenTree::Group(group)) if path_end + 1usize == end => {
                match group.delimiter() {
                    Delimiter::Parenthesis => {
                        for pattern in split_top_level(group.stream(), ',') {
                            if !valid_pat(&pattern) {
                                return false;
                            }
                        }
                        true
                    },
                    Delimiter::Brace => valid_pattern_fields(group.stream()),
                    _ => false,
                }
            },
            _ => false,
        }
    }

    fun classify_pat(tokens: &TokenStream) -> Result<Pat, Error> {
        let start = attribute_end_index(tokens);
        if start + 1usize == tokens.len() && punct_at(tokens, start, '&') {
            return Result::Err(Error::new(tokens_span(tokens), "incomplete pattern syntax"));
        }
        if !valid_pat(tokens) {
            return Result::Err(Error::new(tokens_span(tokens), "invalid pattern syntax"));
        }
        let last = tokens.len() - 1usize;
        if ident_at(tokens, start, "_") {
            return Result::Ok(Pat::Wildcard(tokens.cloned()));
        }
        match tokens.as_slice().get(start) {
            Option::Some(TokenTree::Literal(_)) => {
                return Result::Ok(Pat::Literal(tokens.cloned()));
            },
            _ => {},
        }
        if ident_at(tokens, start, "true") || ident_at(tokens, start, "false") {
            return Result::Ok(Pat::Literal(tokens.cloned()));
        }
        if punct_at(tokens, start, '&') {
            return Result::Ok(Pat::Reference(tokens.cloned()));
        }
        if parenthesis_at(tokens, start) {
            return Result::Ok(Pat::Tuple(tokens.cloned()));
        }
        if is_macro_call(tokens) {
            return Result::Ok(Pat::Macro(tokens.cloned()));
        }
        if brace_at(tokens, last) {
            return Result::Ok(Pat::Struct(tokens.cloned()));
        }
        if parenthesis_at(tokens, last) || has_punct(tokens, ':') {
            return Result::Ok(Pat::Enum(tokens.cloned()));
        }
        if ident_at(tokens, start, "mut") {
            Result::Ok(Pat::Binding(tokens.cloned()))
        } else {
            Result::Ok(Pat::Binding(tokens.cloned()))
        }
    }

    fun tokens_span(tokens: &TokenStream) -> Span {
        match tokens.as_slice().get(0usize) {
            Option::Some(tree) => tree.span(),
            Option::None => Span::call_site(),
        }
    }

    fun split_top_level(tokens: &TokenStream, separator: char) -> Vector<TokenStream> {
        let mut parts = Vector::new();
        let mut start = 0usize;
        let mut angle_depth = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<') {
                angle_depth += 1usize;
            } else if punct_at(tokens, index, '>') && angle_depth > 0usize {
                angle_depth -= 1usize;
            } else if punct_at(tokens, index, separator) && angle_depth == 0usize {
                if start < index {
                    parts.push(token_range(tokens, start, index));
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        if start < tokens.len() {
            parts.push(token_range(tokens, start, tokens.len()));
        }
        parts
    }

    fun find_top_level_punct(tokens: &TokenStream, expected: char) -> usize {
        let mut angle_depth = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<') {
                angle_depth += 1usize;
            } else if punct_at(tokens, index, '>') && angle_depth > 0usize {
                angle_depth -= 1usize;
            } else if punct_at(tokens, index, expected) && angle_depth == 0usize {
                if expected != ':'
                    || (!punct_at(tokens, index + 1usize, ':')
                        && (index == 0usize || !punct_at(tokens, index - 1usize, ':')))
                {
                    return index;
                }
            }
            index += 1usize;
        }
        tokens.len()
    }

    fun parse_attributes(tokens: &TokenStream, index: &mut usize) -> Vector<Attribute> {
        let mut attrs = Vector::new();
        while *index + 1usize < tokens.len()
            && punct_at(tokens, *index, '#')
            && bracket_at(tokens, *index + 1usize)
        {
            attrs.push(Attribute {
                tokens: token_range(tokens, *index, *index + 2usize),
            });
            *index += 2usize;
        }
        attrs
    }

    fun parse_visibility(tokens: &TokenStream, index: &mut usize) -> Visibility {
        if ident_at(tokens, *index, "pub") {
            *index += 1usize;
            Visibility::Public
        } else {
            Visibility::Inherited
        }
    }

    fun parse_ident_at(tokens: &TokenStream, index: usize, expected: &str) -> Result<Ident, Error> {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Ident(ident)) => Result::Ok(ident.clone()),
            _ => Result::Err(Error::new(tokens_span(tokens), expected)),
        }
    }

    fun parse_field(tokens: &TokenStream) -> Result<Field, Error> {
        let mut index = 0usize;
        let attrs = parse_attributes(tokens, &mut index);
        let vis = parse_visibility(tokens, &mut index);
        let ident = match parse_ident_at(tokens, index, "expected field name") {
            Result::Ok(value) => value,
            Result::Err(error) => { return Result::Err(error); },
        };
        index += 1usize;
        if !punct_at(tokens, index, ':') || punct_at(tokens, index + 1usize, ':') {
            return Result::Err(Error::new(tokens_span(tokens), "expected `:` after field name"));
        }
        index += 1usize;
        if index == tokens.len() {
            return Result::Err(Error::new(tokens_span(tokens), "expected field type"));
        }
        let ty_tokens = token_range(tokens, index, tokens.len());
        let ty = match classify_type(&ty_tokens) {
            Result::Ok(value) => value,
            Result::Err(error) => { return Result::Err(error); },
        };
        Result::Ok(Field {
            attrs,
            vis,
            ident,
            ty,
            tokens: tokens.cloned(),
        })
    }

    fun parse_named_fields(tokens: &TokenStream) -> Result<Vector<Field>, Error> {
        let mut fields = Vector::new();
        for field_tokens in split_top_level(tokens, ',') {
            match parse_field(&field_tokens) {
                Result::Ok(field) => fields.push(field),
                Result::Err(error) => { return Result::Err(error); },
            }
        }
        Result::Ok(fields)
    }

    fun parse_unnamed_fields(tokens: &TokenStream) -> Result<Vector<Type>, Error> {
        let mut fields = Vector::new();
        for field_tokens in split_top_level(tokens, ',') {
            match classify_type(&field_tokens) {
                Result::Ok(field) => fields.push(field),
                Result::Err(error) => { return Result::Err(error); },
            }
        }
        Result::Ok(fields)
    }

    fun parse_variant(tokens: &TokenStream) -> Result<Variant, Error> {
        let mut index = 0usize;
        let attrs = parse_attributes(tokens, &mut index);
        let ident = match parse_ident_at(tokens, index, "expected variant name") {
            Result::Ok(value) => value,
            Result::Err(error) => { return Result::Err(error); },
        };
        index += 1usize;
        let fields = if index == tokens.len() {
            Fields::Unit
        } else {
            match tokens.as_slice().get(index) {
                Option::Some(TokenTree::Group(group)) => {
                    if index + 1usize != tokens.len() {
                        return Result::Err(Error::new(
                            tokens_span(tokens),
                            "unexpected tokens after enum variant"
                        ));
                    }
                    match group.delimiter() {
                        Delimiter::Parenthesis => match parse_unnamed_fields(group.stream()) {
                            Result::Ok(values) => Fields::Unnamed(values),
                            Result::Err(error) => { return Result::Err(error); },
                        },
                        Delimiter::Brace => match parse_named_fields(group.stream()) {
                            Result::Ok(values) => Fields::Named(values),
                            Result::Err(error) => { return Result::Err(error); },
                        },
                        _ => {
                            return Result::Err(Error::new(
                                group.span(),
                                "expected tuple or named variant fields"
                            ));
                        },
                    }
                },
                _ => {
                    return Result::Err(Error::new(
                        tokens_span(tokens),
                        "expected enum variant fields"
                    ));
                },
            }
        };
        Result::Ok(Variant {
            attrs,
            ident,
            fields,
            tokens: tokens.cloned(),
        })
    }

    fun parse_variants(tokens: &TokenStream) -> Result<Vector<Variant>, Error> {
        let mut variants = Vector::new();
        for variant_tokens in split_top_level(tokens, ',') {
            match parse_variant(&variant_tokens) {
                Result::Ok(variant) => variants.push(variant),
                Result::Err(error) => { return Result::Err(error); },
            }
        }
        Result::Ok(variants)
    }

    fun parse_generic_params(tokens: &TokenStream) -> Result<Vector<GenericParam>, Error> {
        let mut params = Vector::new();
        if tokens.is_empty() {
            return Result::Ok(Vector::new());
        }
        if tokens.len() < 3usize
            || !punct_at(tokens, 0usize, '<')
            || !punct_at(tokens, tokens.len() - 1usize, '>')
        {
            return Result::Err(Error::new(tokens_span(tokens), "invalid generic parameters"));
        }
        let inner = token_range(tokens, 1usize, tokens.len() - 1usize);
        for param_tokens in split_top_level(&inner, ',') {
            let is_const = ident_at(&param_tokens, 0usize, "const");
            let name_index = if is_const { 1usize } else { 0usize };
            let ident = match parse_ident_at(&param_tokens, name_index, "expected generic parameter") {
                Result::Ok(value) => value,
                Result::Err(error) => { return Result::Err(error); },
            };
            if is_const {
                if !punct_at(&param_tokens, name_index + 1usize, ':') {
                    return Result::Err(Error::new(
                        tokens_span(&param_tokens),
                        "expected `:` in const generic parameter"
                    ));
                }
                let ty_tokens = token_range(&param_tokens, name_index + 2usize, param_tokens.len());
                if ty_tokens.is_empty() || !valid_type(&ty_tokens) {
                    return Result::Err(Error::new(tokens_span(&param_tokens), "expected const parameter type"));
                }
                let ty = match classify_type(&ty_tokens) {
                    Result::Ok(value) => value,
                    Result::Err(error) => { return Result::Err(error); },
                };
                params.push(GenericParam::Const(ConstParam {
                    ident: ident.clone(),
                    ty,
                    tokens: param_tokens.cloned(),
                }));
            } else {
                let colon = find_top_level_punct(&param_tokens, ':');
                let equals = find_top_level_punct(&param_tokens, '=');
                let bounds_end = if equals < param_tokens.len() { equals } else { param_tokens.len() };
                let bounds = if colon < bounds_end {
                    token_range(&param_tokens, colon + 1usize, bounds_end)
                } else {
                    TokenStream::new()
                };
                let default = if equals < param_tokens.len() {
                    token_range(&param_tokens, equals + 1usize, param_tokens.len())
                } else {
                    TokenStream::new()
                };
                let name_end = if colon < bounds_end { colon } else { bounds_end };
                if name_end != 1usize
                    || (colon < bounds_end && (bounds.is_empty() || !valid_bounds(&bounds)))
                    || (equals < param_tokens.len()
                        && (default.is_empty() || !valid_type(&default)))
                {
                    return Result::Err(Error::new(
                        tokens_span(&param_tokens),
                        "invalid type generic parameter"
                    ));
                }
                params.push(GenericParam::Type(TypeParam {
                    ident,
                    bounds,
                    default,
                    tokens: param_tokens,
                }));
            }
        }
        Result::Ok(params)
    }

    fun parse_where_predicates(tokens: &TokenStream) -> Result<Vector<WherePredicate>, Error> {
        let mut predicates = Vector::new();
        if tokens.is_empty() {
            return Result::Ok(Vector::new());
        }
        let start = if ident_at(tokens, 0usize, "where") { 1usize } else { 0usize };
        let body = token_range(tokens, start, tokens.len());
        for predicate_tokens in split_top_level(&body, ',') {
            let colon = find_top_level_punct(&predicate_tokens, ':');
            if colon == predicate_tokens.len() {
                return Result::Err(Error::new(
                    tokens_span(&predicate_tokens),
                    "expected `:` in where predicate"
                ));
            }
            let ty_tokens = token_range(&predicate_tokens, 0usize, colon);
            let bounds = token_range(&predicate_tokens, colon + 1usize, predicate_tokens.len());
            if ty_tokens.is_empty() || bounds.is_empty() {
                return Result::Err(Error::new(
                    tokens_span(&predicate_tokens),
                    "incomplete where predicate"
                ));
            }
            let ty = match classify_type(&ty_tokens) {
                Result::Ok(value) => value,
                Result::Err(error) => { return Result::Err(error); },
            };
            if !valid_bounds(&bounds) {
                return Result::Err(Error::new(
                    tokens_span(&predicate_tokens),
                    "invalid where predicate bounds"
                ));
            }
            predicates.push(WherePredicate {
                ty,
                bounds,
                tokens: predicate_tokens,
            });
        }
        Result::Ok(predicates)
    }

    pub fun walk_file<V: Visit>(visitor: &mut V, node: &File) {
        for stmt in node.stmts.as_slice() {
            visitor.visit_stmt(stmt);
        }
    }

    pub fun walk_stmt<V: Visit>(visitor: &mut V, node: &Stmt) {
        match node {
            Stmt::Item(item) => visitor.visit_item(item),
            Stmt::Expr(tokens) => {
                let end = if punct_at(tokens, tokens.len() - 1usize, ';') {
                    tokens.len() - 1usize
                } else {
                    tokens.len()
                };
                let expr = token_range(tokens, 0usize, end);
                visit_expr_tokens(visitor, &expr);
            },
            Stmt::Local(tokens) => {
                let keyword = item_keyword_index(tokens);
                let body = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
                let equals = find_top_level_punct(&body, '=');
                let left_end = if equals < body.len() { equals } else { body.len() };
                let left = token_range(&body, 0usize, left_end);
                let colon = find_top_level_punct(&left, ':');
                let pat_end = if colon < left.len() { colon } else { left.len() };
                let pat = token_range(&left, 0usize, pat_end);
                visit_pat_tokens(visitor, &pat);
                if colon < left.len() {
                    let ty = token_range(&left, colon + 1usize, left.len());
                    visit_type_tokens(visitor, &ty);
                }
                if equals < body.len() {
                    let value = token_range(&body, equals + 1usize, body.len());
                    visit_expr_tokens(visitor, &value);
                }
            },
            Stmt::Break(tokens) => {
                let keyword = item_keyword_index(tokens);
                if keyword + 2usize < tokens.len() {
                    let value = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
                    visit_expr_tokens(visitor, &value);
                }
            },
            Stmt::Return(tokens) => {
                let keyword = item_keyword_index(tokens);
                if keyword + 2usize < tokens.len() {
                    let value = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
                    visit_expr_tokens(visitor, &value);
                }
            },
            Stmt::Continue(_) => {},
        }
    }

    fun visit_expr_tokens<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match classify_expr(tokens) {
            Result::Ok(expr) => visitor.visit_expr(&expr),
            Result::Err(_) => {},
        }
    }

    fun visit_type_tokens<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match classify_type(tokens) {
            Result::Ok(ty) => visitor.visit_type(&ty),
            Result::Err(_) => {},
        }
    }

    fun visit_pat_tokens<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match classify_pat(tokens) {
            Result::Ok(pat) => visitor.visit_pat(&pat),
            Result::Err(_) => {},
        }
    }

    fun visit_file_tokens<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match parse::<File>(tokens.cloned()) {
            Result::Ok(file) => visitor.visit_file(&file),
            Result::Err(_) => {},
        }
    }

    fun visit_expr_list<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for value in split_top_level(tokens, ',') {
            visit_expr_tokens(visitor, &value);
        }
    }

    fun visit_type_list<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for value in split_top_level(tokens, ',') {
            visit_type_tokens(visitor, &value);
        }
    }

    fun visit_bound_arguments<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for argument in split_top_level(tokens, ',') {
            let equals = find_top_level_punct(&argument, '=');
            let value = if equals < argument.len() {
                token_range(&argument, equals + 1usize, argument.len())
            } else {
                argument
            };
            visit_type_tokens(visitor, &value);
        }
    }

    fun visit_bound<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        let path_end = consume_path(tokens, 0usize, tokens.len());
        if punct_at(tokens, path_end, '<') {
            let close = matching_angle_end(tokens, path_end, tokens.len());
            let arguments = token_range(tokens, path_end + 1usize, close - 1usize);
            visit_bound_arguments(visitor, &arguments);
        } else {
            match tokens.as_slice().get(path_end) {
                Option::Some(TokenTree::Group(group)) => {
                    visit_type_list(visitor, group.stream());
                    if punct_joint_at(tokens, path_end + 1usize, '-')
                        && punct_at(tokens, path_end + 2usize, '>')
                    {
                        let output = token_range(tokens, path_end + 3usize, tokens.len());
                        visit_type_tokens(visitor, &output);
                    }
                },
                _ => {},
            }
        }
    }

    fun visit_bounds<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for bound in split_top_level(tokens, '+') {
            visit_bound(visitor, &bound);
        }
    }

    fun visit_generic_params<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match parse_generic_params(tokens) {
            Result::Ok(params) => {
                for param in params.as_slice() {
                    match param {
                        GenericParam::Type(param) => {
                            if !param.bounds.is_empty() { visit_bounds(visitor, &param.bounds); }
                            if !param.default.is_empty() { visit_type_tokens(visitor, &param.default); }
                        },
                        GenericParam::Const(param) => visitor.visit_type(&param.ty),
                    }
                }
            },
            Result::Err(_) => {},
        }
    }

    fun visit_where_clause<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match parse_where_predicates(tokens) {
            Result::Ok(predicates) => {
                for predicate in predicates.as_slice() {
                    visitor.visit_type(&predicate.ty);
                    visit_bounds(visitor, &predicate.bounds);
                }
            },
            Result::Err(_) => {},
        }
    }

    fun visit_pat_list<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for value in split_top_level(tokens, ',') {
            visit_pat_tokens(visitor, &value);
        }
    }

    fun visit_function<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        let keyword = item_keyword_index(tokens);
        let mut index = keyword + 2usize;
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, tokens.len());
            let generics = token_range(tokens, index, close);
            visit_generic_params(visitor, &generics);
            index = close;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(params)) => {
                for param in split_top_level(params.stream(), ',') {
                    let colon = find_top_level_punct(&param, ':');
                    if colon < param.len() {
                        let ty = token_range(&param, colon + 1usize, param.len());
                        visit_type_tokens(visitor, &ty);
                    }
                }
            },
            _ => {},
        }
        index += 1usize;
        if punct_joint_at(tokens, index, '-') && punct_at(tokens, index + 1usize, '>') {
            let mut end = index + 2usize;
            while end < tokens.len() && !ident_at(tokens, end, "where") && !brace_at(tokens, end) {
                end += 1usize;
            }
            let ty = token_range(tokens, index + 2usize, end);
            visit_type_tokens(visitor, &ty);
            index = end;
        }
        if ident_at(tokens, index, "where") {
            let mut end = index + 1usize;
            while end < tokens.len() && !brace_at(tokens, end) {
                end += 1usize;
            }
            let clause = token_range(tokens, index, end);
            visit_where_clause(visitor, &clause);
            index = end;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(body)) => visit_file_tokens(visitor, body.stream()),
            _ => {},
        }
    }

    fun visit_trait_header<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        let keyword = item_keyword_index(tokens);
        let mut index = keyword + 2usize;
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, tokens.len());
            visit_generic_params(visitor, &token_range(tokens, index, close));
            index = close;
        }
        let body = tokens.len() - 1usize;
        let colon = find_top_level_punct(&token_range(tokens, index, body), ':');
        if colon < body - index {
            let bounds = token_range(tokens, index + colon + 1usize, body);
            visit_bounds(visitor, &bounds);
        }
        visit_item_body(visitor, tokens);
    }

    fun visit_impl_header<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        let keyword = item_keyword_index(tokens);
        let body = tokens.len() - 1usize;
        let mut index = keyword + 1usize;
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, body);
            visit_generic_params(visitor, &token_range(tokens, index, close));
            index = close;
        }
        let mut where_index = body;
        let mut for_index = body;
        let mut scan = index;
        while scan < body {
            if ident_at(tokens, scan, "where") && where_index == body { where_index = scan; }
            if ident_at(tokens, scan, "for") && for_index == body { for_index = scan; }
            scan += 1usize;
        }
        let head_end = if where_index < body { where_index } else { body };
        if for_index < head_end {
            visit_type_tokens(visitor, &token_range(tokens, index, for_index));
            visit_type_tokens(visitor, &token_range(tokens, for_index + 1usize, head_end));
        } else {
            visit_type_tokens(visitor, &token_range(tokens, index, head_end));
        }
        if where_index < body {
            visit_where_clause(visitor, &token_range(tokens, where_index, body));
        }
        visit_item_body(visitor, tokens);
    }

    fun visit_extern_body<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for member in split_top_level(tokens, ';') {
            let mut fun_index = member.len();
            let mut index = 0usize;
            while index < member.len() {
                if ident_at(&member, index, "fun") { fun_index = index; break; }
                index += 1usize;
            }
            if fun_index < member.len() {
                visit_function(visitor, &token_range(&member, fun_index, member.len()));
            }
        }
    }

    fun visit_item_body<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        match tokens.as_slice().get(tokens.len() - 1usize) {
            Option::Some(TokenTree::Group(body)) => visit_file_tokens(visitor, body.stream()),
            _ => {},
        }
    }

    pub fun walk_item<V: Visit>(visitor: &mut V, node: &Item) {
        match node {
            Item::Struct(tokens) => {
                match parse::<DeriveInput>(tokens.cloned()) {
                    Result::Ok(input) => visitor.visit_derive_input(&input),
                    Result::Err(_) => {},
                }
            },
            Item::Enum(tokens) => {
                match parse::<DeriveInput>(tokens.cloned()) {
                    Result::Ok(input) => visitor.visit_derive_input(&input),
                    Result::Err(_) => {},
                }
            },
            Item::Function(tokens) => visit_function(visitor, tokens),
            Item::Const(tokens) => {
                let keyword = item_keyword_index(tokens);
                let rest = token_range(tokens, keyword + 2usize, tokens.len() - 1usize);
                let colon = find_top_level_punct(&rest, ':');
                let equals = find_top_level_punct(&rest, '=');
                let ty = token_range(&rest, colon + 1usize, equals);
                let value = token_range(&rest, equals + 1usize, rest.len());
                visit_type_tokens(visitor, &ty);
                visit_expr_tokens(visitor, &value);
            },
            Item::TypeAlias(tokens) => {
                let keyword = item_keyword_index(tokens);
                if punct_at(tokens, keyword + 2usize, '=') {
                    let ty = token_range(tokens, keyword + 3usize, tokens.len() - 1usize);
                    visit_type_tokens(visitor, &ty);
                }
            },
            Item::Module(tokens) => visit_item_body(visitor, tokens),
            Item::Trait(tokens) => visit_trait_header(visitor, tokens),
            Item::Impl(tokens) => visit_impl_header(visitor, tokens),
            Item::Extern(tokens) => {
                let keyword = item_keyword_index(tokens);
                let mut fun_index = keyword + 1usize;
                while fun_index < tokens.len() && !ident_at(tokens, fun_index, "fun") {
                    fun_index += 1usize;
                }
                if fun_index < tokens.len() {
                    visit_function(visitor, &token_range(tokens, fun_index, tokens.len()));
                } else {
                    match tokens.as_slice().get(tokens.len() - 1usize) {
                        Option::Some(TokenTree::Group(group)) => visit_extern_body(visitor, group.stream()),
                        _ => {},
                    }
                }
            },
            Item::Use(_) => {},
        }
    }

    fun visit_control_expr<V: Visit>(visitor: &mut V, tokens: &TokenStream, start: usize) {
        let brace = first_brace(tokens, start);
        if brace == tokens.len() {
            return;
        }
        let value = token_range(tokens, start, brace);
        visit_expr_tokens(visitor, &value);
        match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(body)) => visit_file_tokens(visitor, body.stream()),
            _ => {},
        }
    }

    fun visit_match_arms<V: Visit>(visitor: &mut V, tokens: &TokenStream) {
        for arm in split_top_level(tokens, ',') {
            let mut arrow = 0usize;
            while arrow + 1usize < arm.len()
                && !(punct_joint_at(&arm, arrow, '=') && punct_at(&arm, arrow + 1usize, '>'))
            {
                arrow += 1usize;
            }
            let mut guard = arrow;
            let mut index = 0usize;
            while index < arrow {
                if ident_at(&arm, index, "if") {
                    guard = index;
                    break;
                }
                index += 1usize;
            }
            let pat = token_range(&arm, 0usize, guard);
            visit_pat_tokens(visitor, &pat);
            if guard < arrow {
                let condition = token_range(&arm, guard + 1usize, arrow);
                visit_expr_tokens(visitor, &condition);
            }
            let value = token_range(&arm, arrow + 2usize, arm.len());
            visit_expr_tokens(visitor, &value);
        }
    }

    pub fun walk_expr<V: Visit>(visitor: &mut V, node: &Expr) {
        let tokens = match node {
            Expr::Literal(tokens) => tokens,
            Expr::Path(tokens) => tokens,
            Expr::Block(tokens) => tokens,
            Expr::Tuple(tokens) => tokens,
            Expr::Array(tokens) => tokens,
            Expr::Struct(tokens) => tokens,
            Expr::Call(tokens) => tokens,
            Expr::Field(tokens) => tokens,
            Expr::Index(tokens) => tokens,
            Expr::Unary(tokens) => tokens,
            Expr::Binary(tokens) => tokens,
            Expr::Cast(tokens) => tokens,
            Expr::Try(tokens) => tokens,
            Expr::Closure(tokens) => tokens,
            Expr::If(tokens) => tokens,
            Expr::While(tokens) => tokens,
            Expr::For(tokens) => tokens,
            Expr::Match(tokens) => tokens,
            Expr::Unsafe(tokens) => tokens,
            Expr::Macro(tokens) => tokens,
        };
        match node {
            Expr::Literal(_) => {},
            Expr::Path(_) => {},
            Expr::Macro(_) => {},
            Expr::Binary(_) => {
                let split = expr_binary_split(tokens);
                let end = binary_operator_end(tokens, split);
                let left = token_range(tokens, 0usize, split);
                let right = token_range(tokens, end, tokens.len());
                visit_expr_tokens(visitor, &left);
                visit_expr_tokens(visitor, &right);
            },
            Expr::Cast(_) => {
                let split = expr_cast_split(tokens);
                let value = token_range(tokens, 0usize, split);
                let ty = token_range(tokens, split + 1usize, tokens.len());
                visit_expr_tokens(visitor, &value);
                visit_type_tokens(visitor, &ty);
            },
            Expr::Unary(_) => {
                let mut start = attribute_end_index(tokens) + 1usize;
                if punct_at(tokens, attribute_end_index(tokens), '&')
                    && (ident_at(tokens, start, "mut") || punct_at(tokens, start, '&'))
                {
                    start += 1usize;
                }
                let value = token_range(tokens, start, tokens.len());
                visit_expr_tokens(visitor, &value);
            },
            Expr::Try(_) => {
                let value = token_range(tokens, 0usize, tokens.len() - 1usize);
                visit_expr_tokens(visitor, &value);
            },
            Expr::Block(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                        Delimiter::Brace => visit_file_tokens(visitor, group.stream()),
                        Delimiter::Parenthesis => visit_expr_list(visitor, group.stream()),
                        Delimiter::Bracket => {
                            for part in split_top_level(group.stream(), ';') {
                                visit_expr_list(visitor, &part);
                            }
                        },
                        Delimiter::None => visit_expr_tokens(visitor, group.stream()),
                    },
                    _ => {},
                }
            },
            Expr::Tuple(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => visit_expr_list(visitor, group.stream()),
                    _ => {},
                }
            },
            Expr::Array(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => {
                        for part in split_top_level(group.stream(), ';') {
                            visit_expr_list(visitor, &part);
                        }
                    },
                    _ => {},
                }
            },
            Expr::Call(_) => {
                let last = tokens.len() - 1usize;
                let receiver = token_range(tokens, 0usize, last);
                visit_expr_tokens(visitor, &receiver);
                match tokens.as_slice().get(last) {
                    Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                        Delimiter::Parenthesis => visit_expr_list(visitor, group.stream()),
                        Delimiter::Bracket => visit_expr_tokens(visitor, group.stream()),
                        _ => {},
                    },
                    _ => {},
                }
            },
            Expr::Index(_) => {
                let last = tokens.len() - 1usize;
                let receiver = token_range(tokens, 0usize, last);
                visit_expr_tokens(visitor, &receiver);
                match tokens.as_slice().get(last) {
                    Option::Some(TokenTree::Group(group)) => visit_expr_tokens(visitor, group.stream()),
                    _ => {},
                }
            },
            Expr::Field(_) => {
                let mut dot = tokens.len();
                let mut index = 0usize;
                while index < tokens.len() {
                    if punct_at(tokens, index, '.') {
                        dot = index;
                    }
                    index += 1usize;
                }
                let receiver = token_range(tokens, 0usize, dot);
                visit_expr_tokens(visitor, &receiver);
            },
            Expr::Struct(_) => {
                let last = tokens.len() - 1usize;
                match tokens.as_slice().get(last) {
                    Option::Some(TokenTree::Group(group)) => {
                        for field in split_top_level(group.stream(), ',') {
                            let colon = find_top_level_punct(&field, ':');
                            if colon < field.len() {
                                let value = token_range(&field, colon + 1usize, field.len());
                                visit_expr_tokens(visitor, &value);
                            }
                        }
                    },
                    _ => {},
                }
            },
            Expr::If(_) => {
                visit_control_expr(visitor, tokens, 1usize);
                let brace = first_brace(tokens, 1usize);
                if brace + 2usize < tokens.len() && ident_at(tokens, brace + 1usize, "else") {
                    let tail = token_range(tokens, brace + 2usize, tokens.len());
                    visit_expr_tokens(visitor, &tail);
                }
            },
            Expr::While(_) => visit_control_expr(visitor, tokens, 1usize),
            Expr::For(_) => {
                let pat = token_range(tokens, 1usize, 2usize);
                visit_pat_tokens(visitor, &pat);
                visit_control_expr(visitor, tokens, 3usize);
            },
            Expr::Match(_) => {
                let brace = first_brace(tokens, 1usize);
                let value = token_range(tokens, 1usize, brace);
                visit_expr_tokens(visitor, &value);
                match tokens.as_slice().get(brace) {
                    Option::Some(TokenTree::Group(group)) => visit_match_arms(visitor, group.stream()),
                    _ => {},
                }
            },
            Expr::Unsafe(_) => {
                match tokens.as_slice().get(1usize) {
                    Option::Some(TokenTree::Group(group)) => visit_file_tokens(visitor, group.stream()),
                    _ => {},
                }
            },
            Expr::Closure(_) => {
                let mut group_index = 0usize;
                if ident_at(tokens, 0usize, "move") {
                    group_index = 1usize;
                }
                match tokens.as_slice().get(group_index) {
                    Option::Some(TokenTree::Group(group)) => {
                        let stream = group.stream();
                        let arrow = find_top_level_arrow(stream);
                        if arrow < stream.len() {
                            for param in split_top_level(&token_range(stream, 0usize, arrow), ',') {
                                let colon = find_top_level_punct(&param, ':');
                                if colon < param.len() {
                                    let ty = token_range(&param, colon + 1usize, param.len());
                                    visit_type_tokens(visitor, &ty);
                                }
                            }
                            let body = token_range(stream, arrow + 2usize, stream.len());
                            visit_expr_tokens(visitor, &body);
                        }
                    },
                    _ => {},
                }
            },
        }
    }

    pub fun walk_type<V: Visit>(visitor: &mut V, node: &Type) {
        let tokens = match node {
            Type::Path(tokens) => tokens,
            Type::Reference(tokens) => tokens,
            Type::Pointer(tokens) => tokens,
            Type::Tuple(tokens) => tokens,
            Type::Array(tokens) => tokens,
            Type::Const(tokens) => tokens,
            Type::Never(tokens) => tokens,
            Type::ImplTrait(tokens) => tokens,
            Type::Macro(tokens) => tokens,
        };
        match node {
            Type::Const(_) => {},
            Type::Never(_) => {},
            Type::Macro(_) => {},
            Type::Reference(_) => {
                let start = attribute_end_index(tokens);
                let mut inner = start + 1usize;
                if punct_at(tokens, inner, '&') || ident_at(tokens, inner, "mut") {
                    inner += 1usize;
                }
                let ty = token_range(tokens, inner, tokens.len());
                visit_type_tokens(visitor, &ty);
            },
            Type::Pointer(_) => {
                let ty = token_range(tokens, attribute_end_index(tokens) + 2usize, tokens.len());
                visit_type_tokens(visitor, &ty);
            },
            Type::Tuple(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => visit_type_list(visitor, group.stream()),
                    _ => {},
                }
            },
            Type::Array(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => {
                        let parts = split_top_level(group.stream(), ';');
                        if !parts.is_empty() {
                            visit_type_tokens(visitor, &parts.as_slice()[0usize]);
                        }
                        if parts.len() == 2usize {
                            visit_expr_tokens(visitor, &parts.as_slice()[1usize]);
                        }
                    },
                    _ => {},
                }
            },
            Type::ImplTrait(_) => {
                let bounds = token_range(tokens, attribute_end_index(tokens) + 1usize, tokens.len());
                visit_bounds(visitor, &bounds);
            },
            Type::Path(_) => {
                let mut index = attribute_end_index(tokens);
                while index < tokens.len() {
                    if punct_at(tokens, index, '<') {
                        let close = matching_angle_end(tokens, index, tokens.len());
                        let arguments = token_range(tokens, index + 1usize, close - 1usize);
                        visit_type_list(visitor, &arguments);
                        index = close;
                    } else {
                        match tokens.as_slice().get(index) {
                            Option::Some(TokenTree::Group(group)) => visit_type_list(visitor, group.stream()),
                            _ => {},
                        }
                        index += 1usize;
                    }
                }
            },
        }
    }

    pub fun walk_pat<V: Visit>(visitor: &mut V, node: &Pat) {
        let tokens = match node {
            Pat::Wildcard(tokens) => tokens,
            Pat::Literal(tokens) => tokens,
            Pat::Tuple(tokens) => tokens,
            Pat::Struct(tokens) => tokens,
            Pat::Enum(tokens) => tokens,
            Pat::Binding(tokens) => tokens,
            Pat::Reference(tokens) => tokens,
            Pat::Macro(tokens) => tokens,
        };
        match node {
            Pat::Wildcard(_) => {},
            Pat::Literal(_) => {},
            Pat::Binding(_) => {},
            Pat::Macro(_) => {},
            Pat::Reference(_) => {
                let mut start = attribute_end_index(tokens) + 1usize;
                if punct_at(tokens, start, '&') || ident_at(tokens, start, "mut") {
                    start += 1usize;
                }
                let inner = token_range(tokens, start, tokens.len());
                visit_pat_tokens(visitor, &inner);
            },
            Pat::Tuple(_) => {
                match tokens.as_slice().get(attribute_end_index(tokens)) {
                    Option::Some(TokenTree::Group(group)) => visit_pat_list(visitor, group.stream()),
                    _ => {},
                }
            },
            Pat::Struct(_) => {
                match tokens.as_slice().get(tokens.len() - 1usize) {
                    Option::Some(TokenTree::Group(group)) => {
                        for field in split_top_level(group.stream(), ',') {
                            let colon = find_top_level_punct(&field, ':');
                            if colon < field.len() {
                                let inner = token_range(&field, colon + 1usize, field.len());
                                visit_pat_tokens(visitor, &inner);
                            }
                        }
                    },
                    _ => {},
                }
            },
            Pat::Enum(_) => {
                match tokens.as_slice().get(tokens.len() - 1usize) {
                    Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                        Delimiter::Parenthesis => visit_pat_list(visitor, group.stream()),
                        Delimiter::Brace => {
                            for field in split_top_level(group.stream(), ',') {
                                let colon = find_top_level_punct(&field, ':');
                                if colon < field.len() {
                                    let inner = token_range(&field, colon + 1usize, field.len());
                                    visit_pat_tokens(visitor, &inner);
                                }
                            }
                        },
                        _ => {},
                    },
                    _ => {},
                }
            },
        }
    }
    pub fun walk_derive_input<V: Visit>(visitor: &mut V, node: &DeriveInput) {
        visit_generic_params(visitor, &node.generics.tokens);
        visit_where_clause(visitor, &node.generics.where_clause);
        match &node.data {
            Data::Struct(data) => {
                for field in data.named.as_slice() {
                    visitor.visit_type(&field.ty);
                }
            },
            Data::Enum(data) => {
                for variant in data.items.as_slice() {
                    match &variant.fields {
                        Fields::Unit => {},
                        Fields::Named(fields) => {
                            for field in fields.as_slice() {
                                visitor.visit_type(&field.ty);
                            }
                        },
                        Fields::Unnamed(fields) => {
                            for field in fields.as_slice() {
                                visitor.visit_type(field);
                            }
                        },
                    }
                }
            },
        }
    }

    fun node_tokens<T: crate::ToTokens>(node: &T) -> TokenStream {
        let mut output = TokenStream::new();
        node.to_tokens(&mut output);
        output
    }

    fun append_range(output: &mut TokenStream, tokens: &TokenStream, start: usize, end: usize) {
        let mut index = start;
        while index < end {
            output.push(tokens.as_slice()[index].clone());
            index += 1usize;
        }
    }

    fun rebuilt_group(group: &Group, stream: TokenStream) -> TokenTree {
        let mut output = Group::new(group.delimiter(), stream);
        output.set_span(group.span());
        TokenTree::Group(output)
    }

    fun replace_group(tokens: &TokenStream, index: usize, stream: TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, index);
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => output.push(rebuilt_group(group, stream)),
            _ => {},
        }
        append_range(&mut output, tokens, index + 1usize, tokens.len());
        output
    }

    fun fold_expr_tokens<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        match classify_expr(tokens) {
            Result::Ok(expr) => node_tokens(&folder.fold_expr(expr)),
            Result::Err(_) => tokens.cloned(),
        }
    }

    fun fold_type_tokens<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        match classify_type(tokens) {
            Result::Ok(ty) => node_tokens(&folder.fold_type(ty)),
            Result::Err(_) => tokens.cloned(),
        }
    }

    fun fold_pat_tokens<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        match classify_pat(tokens) {
            Result::Ok(pat) => node_tokens(&folder.fold_pat(pat)),
            Result::Err(_) => tokens.cloned(),
        }
    }

    fun fold_file_tokens<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        match parse::<File>(tokens.cloned()) {
            Result::Ok(file) => node_tokens(&folder.fold_file(file)),
            Result::Err(_) => tokens.cloned(),
        }
    }

    fun fold_expr_separated<F: Fold>(
        folder: &mut F,
        tokens: &TokenStream,
        separator: char
    ) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut angle_depth = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<') {
                angle_depth += 1usize;
            } else if punct_at(tokens, index, '>') && angle_depth > 0usize {
                angle_depth -= 1usize;
            } else if punct_at(tokens, index, separator) && angle_depth == 0usize {
                let value = token_range(tokens, start, index);
                if !value.is_empty() {
                    output.extend(fold_expr_tokens(folder, &value));
                }
                output.push(tokens.as_slice()[index].clone());
                start = index + 1usize;
            }
            index += 1usize;
        }
        let value = token_range(tokens, start, tokens.len());
        if !value.is_empty() {
            output.extend(fold_expr_tokens(folder, &value));
        }
        output
    }

    fun fold_type_separated<F: Fold>(
        folder: &mut F,
        tokens: &TokenStream,
        separator: char
    ) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut angle_depth = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<') {
                angle_depth += 1usize;
            } else if punct_at(tokens, index, '>') && angle_depth > 0usize {
                angle_depth -= 1usize;
            } else if punct_at(tokens, index, separator) && angle_depth == 0usize {
                let value = token_range(tokens, start, index);
                if !value.is_empty() {
                    output.extend(fold_type_tokens(folder, &value));
                }
                output.push(tokens.as_slice()[index].clone());
                start = index + 1usize;
            }
            index += 1usize;
        }
        let value = token_range(tokens, start, tokens.len());
        if !value.is_empty() {
            output.extend(fold_type_tokens(folder, &value));
        }
        output
    }

    fun fold_pat_separated<F: Fold>(
        folder: &mut F,
        tokens: &TokenStream,
        separator: char
    ) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, separator) {
                let value = token_range(tokens, start, index);
                if !value.is_empty() {
                    output.extend(fold_pat_tokens(folder, &value));
                }
                output.push(tokens.as_slice()[index].clone());
                start = index + 1usize;
            }
            index += 1usize;
        }
        let value = token_range(tokens, start, tokens.len());
        if !value.is_empty() {
            output.extend(fold_pat_tokens(folder, &value));
        }
        output
    }

    fun fold_expr_group<F: Fold>(folder: &mut F, tokens: &TokenStream, index: usize) -> TokenStream {
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                let inner = match group.delimiter() {
                    Delimiter::Brace => fold_file_tokens(folder, group.stream()),
                    Delimiter::Parenthesis => fold_expr_separated(folder, group.stream(), ','),
                    Delimiter::Bracket => {
                        if has_punct(group.stream(), ';') {
                            fold_expr_separated(folder, group.stream(), ';')
                        } else {
                            fold_expr_separated(folder, group.stream(), ',')
                        }
                    },
                    Delimiter::None => fold_expr_tokens(folder, group.stream()),
                };
                replace_group(tokens, index, inner)
            },
            _ => tokens.cloned(),
        }
    }

    fun fold_struct_expr_fields<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, ',') {
                let field = token_range(tokens, start, index);
                if !field.is_empty() {
                    let colon = find_top_level_punct(&field, ':');
                    if colon < field.len() {
                        append_range(&mut output, &field, 0usize, colon + 1usize);
                        let value = token_range(&field, colon + 1usize, field.len());
                        output.extend(fold_expr_tokens(folder, &value));
                    } else {
                        output.extend(field);
                    }
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_match_arms<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut end = 0usize;
        while end <= tokens.len() {
            if end == tokens.len() || punct_at(tokens, end, ',') {
                let arm = token_range(tokens, start, end);
                if !arm.is_empty() {
                    let mut arrow = 0usize;
                    while arrow + 1usize < arm.len()
                        && !(punct_joint_at(&arm, arrow, '=') && punct_at(&arm, arrow + 1usize, '>'))
                    {
                        arrow += 1usize;
                    }
                    let mut guard = arrow;
                    let mut index = 0usize;
                    while index < arrow {
                        if ident_at(&arm, index, "if") {
                            guard = index;
                            break;
                        }
                        index += 1usize;
                    }
                    let pat = token_range(&arm, 0usize, guard);
                    output.extend(fold_pat_tokens(folder, &pat));
                    if guard < arrow {
                        output.push(arm.as_slice()[guard].clone());
                        let condition = token_range(&arm, guard + 1usize, arrow);
                        output.extend(fold_expr_tokens(folder, &condition));
                    }
                    append_range(&mut output, &arm, arrow, arrow + 2usize);
                    let value = token_range(&arm, arrow + 2usize, arm.len());
                    output.extend(fold_expr_tokens(folder, &value));
                }
                if end < tokens.len() {
                    output.push(tokens.as_slice()[end].clone());
                }
                start = end + 1usize;
            }
            end += 1usize;
        }
        output
    }

    fun fold_params<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut end = 0usize;
        while end <= tokens.len() {
            if end == tokens.len() || punct_at(tokens, end, ',') {
                let param = token_range(tokens, start, end);
                if !param.is_empty() {
                    let colon = find_top_level_punct(&param, ':');
                    if colon < param.len() {
                        append_range(&mut output, &param, 0usize, colon + 1usize);
                        let ty = token_range(&param, colon + 1usize, param.len());
                        output.extend(fold_type_tokens(folder, &ty));
                    } else {
                        output.extend(param);
                    }
                }
                if end < tokens.len() {
                    output.push(tokens.as_slice()[end].clone());
                }
                start = end + 1usize;
            }
            end += 1usize;
        }
        output
    }

    pub fun fold_file<F: Fold>(folder: &mut F, node: File) -> File {
        fold_file_default(folder, node)
    }

    pub fun fold_item<F: Fold>(folder: &mut F, node: Item) -> Item {
        fold_item_default(folder, node)
    }

    pub fun fold_stmt<F: Fold>(folder: &mut F, node: Stmt) -> Stmt {
        fold_stmt_default(folder, node)
    }

    pub fun fold_expr<F: Fold>(folder: &mut F, node: Expr) -> Expr {
        fold_expr_default(folder, node)
    }

    pub fun fold_type<F: Fold>(folder: &mut F, node: Type) -> Type {
        fold_type_default(folder, node)
    }

    pub fun fold_pat<F: Fold>(folder: &mut F, node: Pat) -> Pat {
        fold_pat_default(folder, node)
    }

    pub fun fold_derive_input<F: Fold>(folder: &mut F, node: DeriveInput) -> DeriveInput {
        fold_derive_input_default(folder, node)
    }

    fun fold_file_default<F: Fold>(folder: &mut F, node: File) -> File {
        let mut stmts = Vector::new();
        for stmt in node.stmts {
            stmts.push(folder.fold_stmt(stmt));
        }
        File { stmts }
    }

    fun fold_stmt_default<F: Fold>(folder: &mut F, node: Stmt) -> Stmt {
        match node {
            Stmt::Item(item) => Stmt::Item(folder.fold_item(item)),
            Stmt::Local(tokens) => Stmt::Local(fold_local_stmt(folder, &tokens)),
            Stmt::Expr(tokens) => {
                if punct_at(&tokens, tokens.len() - 1usize, ';') {
                    let value = token_range(&tokens, 0usize, tokens.len() - 1usize);
                    let mut output = fold_expr_tokens(folder, &value);
                    output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
                    Stmt::Expr(output)
                } else {
                    Stmt::Expr(fold_expr_tokens(folder, &tokens))
                }
            },
            Stmt::Break(tokens) => {
                if tokens.len() > 2usize {
                    let mut output = TokenStream::new();
                    output.push(tokens.as_slice()[0usize].clone());
                    let value = token_range(&tokens, 1usize, tokens.len() - 1usize);
                    output.extend(fold_expr_tokens(folder, &value));
                    output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
                    Stmt::Break(output)
                } else {
                    Stmt::Break(tokens)
                }
            },
            Stmt::Continue(tokens) => Stmt::Continue(tokens),
            Stmt::Return(tokens) => {
                if tokens.len() > 2usize {
                    let mut output = TokenStream::new();
                    output.push(tokens.as_slice()[0usize].clone());
                    let value = token_range(&tokens, 1usize, tokens.len() - 1usize);
                    output.extend(fold_expr_tokens(folder, &value));
                    output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
                    Stmt::Return(output)
                } else {
                    Stmt::Return(tokens)
                }
            },
        }
    }

    fun fold_local_stmt<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let body = token_range(tokens, keyword + 1usize, tokens.len() - 1usize);
        let equals = find_top_level_punct(&body, '=');
        let left_end = if equals < body.len() { equals } else { body.len() };
        let left = token_range(&body, 0usize, left_end);
        let colon = find_top_level_punct(&left, ':');
        let pat_end = if colon < left.len() { colon } else { left.len() };
        let pat = token_range(&left, 0usize, pat_end);
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, keyword + 1usize);
        output.extend(fold_pat_tokens(folder, &pat));
        if colon < left.len() {
            output.push(left.as_slice()[colon].clone());
            let ty = token_range(&left, colon + 1usize, left.len());
            output.extend(fold_type_tokens(folder, &ty));
        }
        if equals < body.len() {
            output.push(body.as_slice()[equals].clone());
            let value = token_range(&body, equals + 1usize, body.len());
            output.extend(fold_expr_tokens(folder, &value));
        }
        output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
        output
    }

    fun fold_binary_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let split = expr_binary_split(tokens);
        let operator_end = binary_operator_end(tokens, split);
        let left = token_range(tokens, 0usize, split);
        let right = token_range(tokens, operator_end, tokens.len());
        let mut output = fold_expr_tokens(folder, &left);
        append_range(&mut output, tokens, split, operator_end);
        output.extend(fold_expr_tokens(folder, &right));
        output
    }

    fun fold_cast_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let split = expr_cast_split(tokens);
        let value = token_range(tokens, 0usize, split);
        let ty = token_range(tokens, split + 1usize, tokens.len());
        let mut output = fold_expr_tokens(folder, &value);
        output.push(tokens.as_slice()[split].clone());
        output.extend(fold_type_tokens(folder, &ty));
        output
    }

    fun fold_postfix_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let last = tokens.len() - 1usize;
        let receiver = token_range(tokens, 0usize, last);
        let mut output = fold_expr_tokens(folder, &receiver);
        match tokens.as_slice().get(last) {
            Option::Some(TokenTree::Group(group)) => {
                let inner = match group.delimiter() {
                    Delimiter::Parenthesis => fold_expr_separated(folder, group.stream(), ','),
                    Delimiter::Bracket => fold_expr_tokens(folder, group.stream()),
                    _ => group.stream().cloned(),
                };
                output.push(rebuilt_group(group, inner));
            },
            _ => {},
        }
        output
    }

    fun fold_control_tokens<F: Fold>(
        folder: &mut F,
        tokens: &TokenStream,
        value_start: usize
    ) -> TokenStream {
        let brace = first_brace(tokens, value_start);
        let value = token_range(tokens, value_start, brace);
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, value_start);
        output.extend(fold_expr_tokens(folder, &value));
        match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
            },
            _ => {},
        }
        append_range(&mut output, tokens, brace + 1usize, tokens.len());
        output
    }

    fun fold_if_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let brace = first_brace(tokens, 1usize);
        let condition = token_range(tokens, 1usize, brace);
        let mut output = TokenStream::new();
        output.push(tokens.as_slice()[0usize].clone());
        output.extend(fold_expr_tokens(folder, &condition));
        match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
            },
            _ => {},
        }
        if brace + 1usize < tokens.len() {
            output.push(tokens.as_slice()[brace + 1usize].clone());
            let tail = token_range(tokens, brace + 2usize, tokens.len());
            output.extend(fold_expr_tokens(folder, &tail));
        }
        output
    }

    fun fold_match_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let brace = first_brace(tokens, 1usize);
        let value = token_range(tokens, 1usize, brace);
        let mut output = TokenStream::new();
        output.push(tokens.as_slice()[0usize].clone());
        output.extend(fold_expr_tokens(folder, &value));
        match tokens.as_slice().get(brace) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_match_arms(folder, group.stream())));
            },
            _ => {},
        }
        output
    }

    fun fold_closure_expr<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut group_index = 0usize;
        if ident_at(tokens, 0usize, "move") {
            group_index = 1usize;
        }
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, group_index);
        match tokens.as_slice().get(group_index) {
            Option::Some(TokenTree::Group(group)) => {
                let stream = group.stream();
                let arrow = find_top_level_arrow(stream);
                if arrow < stream.len() {
                    let params = token_range(stream, 0usize, arrow);
                    let body = token_range(stream, arrow + 2usize, stream.len());
                    let mut inner = fold_params(folder, &params);
                    append_range(&mut inner, stream, arrow, arrow + 2usize);
                    inner.extend(fold_expr_tokens(folder, &body));
                    output.push(rebuilt_group(group, inner));
                } else {
                    output.push(tokens.as_slice()[group_index].clone());
                }
            },
            _ => {},
        }
        append_range(&mut output, tokens, group_index + 1usize, tokens.len());
        output
    }

    fun fold_expr_default<F: Fold>(folder: &mut F, node: Expr) -> Expr {
        match node {
            Expr::Literal(tokens) => Expr::Literal(tokens),
            Expr::Path(tokens) => Expr::Path(tokens),
            Expr::Macro(tokens) => Expr::Macro(tokens),
            Expr::Binary(tokens) => Expr::Binary(fold_binary_expr(folder, &tokens)),
            Expr::Cast(tokens) => Expr::Cast(fold_cast_expr(folder, &tokens)),
            Expr::Unary(tokens) => {
                let prefix = attribute_end_index(&tokens);
                let mut start = prefix + 1usize;
                if punct_at(&tokens, prefix, '&')
                    && (punct_at(&tokens, start, '&') || ident_at(&tokens, start, "mut"))
                {
                    start += 1usize;
                }
                let value = token_range(&tokens, start, tokens.len());
                let mut output = TokenStream::new();
                append_range(&mut output, &tokens, 0usize, start);
                output.extend(fold_expr_tokens(folder, &value));
                Expr::Unary(output)
            },
            Expr::Try(tokens) => {
                let value = token_range(&tokens, 0usize, tokens.len() - 1usize);
                let mut output = fold_expr_tokens(folder, &value);
                output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
                Expr::Try(output)
            },
            Expr::Block(tokens) => {
                let index = attribute_end_index(&tokens);
                Expr::Block(fold_expr_group(folder, &tokens, index))
            },
            Expr::Tuple(tokens) => {
                let index = attribute_end_index(&tokens);
                Expr::Tuple(fold_expr_group(folder, &tokens, index))
            },
            Expr::Array(tokens) => {
                let index = attribute_end_index(&tokens);
                Expr::Array(fold_expr_group(folder, &tokens, index))
            },
            Expr::Call(tokens) => Expr::Call(fold_postfix_expr(folder, &tokens)),
            Expr::Index(tokens) => Expr::Index(fold_postfix_expr(folder, &tokens)),
            Expr::Field(tokens) => {
                let mut dot = tokens.len();
                let mut index = 0usize;
                while index < tokens.len() {
                    if punct_at(&tokens, index, '.') {
                        dot = index;
                    }
                    index += 1usize;
                }
                let receiver = token_range(&tokens, 0usize, dot);
                let mut output = fold_expr_tokens(folder, &receiver);
                append_range(&mut output, &tokens, dot, tokens.len());
                Expr::Field(output)
            },
            Expr::Struct(tokens) => {
                let last = tokens.len() - 1usize;
                let inner = match tokens.as_slice().get(last) {
                    Option::Some(TokenTree::Group(group)) => {
                        fold_struct_expr_fields(folder, group.stream())
                    },
                    _ => TokenStream::new(),
                };
                Expr::Struct(replace_group(&tokens, last, inner))
            },
            Expr::If(tokens) => Expr::If(fold_if_expr(folder, &tokens)),
            Expr::While(tokens) => Expr::While(fold_control_tokens(folder, &tokens, 1usize)),
            Expr::For(tokens) => {
                let pat = token_range(&tokens, 1usize, 2usize);
                let brace = first_brace(&tokens, 3usize);
                let value = token_range(&tokens, 3usize, brace);
                let mut output = TokenStream::new();
                output.push(tokens.as_slice()[0usize].clone());
                output.extend(fold_pat_tokens(folder, &pat));
                output.push(tokens.as_slice()[2usize].clone());
                output.extend(fold_expr_tokens(folder, &value));
                match tokens.as_slice().get(brace) {
                    Option::Some(TokenTree::Group(group)) => {
                        output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
                    },
                    _ => {},
                }
                Expr::For(output)
            },
            Expr::Match(tokens) => Expr::Match(fold_match_expr(folder, &tokens)),
            Expr::Unsafe(tokens) => {
                Expr::Unsafe(fold_expr_group(folder, &tokens, 1usize))
            },
            Expr::Closure(tokens) => Expr::Closure(fold_closure_expr(folder, &tokens)),
        }
    }

    fun fold_path_type<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, '<') {
                let close = matching_angle_end(tokens, index, tokens.len());
                output.push(tokens.as_slice()[index].clone());
                let arguments = token_range(tokens, index + 1usize, close - 1usize);
                output.extend(fold_type_separated(folder, &arguments, ','));
                output.push(tokens.as_slice()[close - 1usize].clone());
                index = close;
            } else {
                output.push(tokens.as_slice()[index].clone());
                index += 1usize;
            }
        }
        output
    }

    fun fold_bound_arguments<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, ',') {
                let argument = token_range(tokens, start, index);
                if !argument.is_empty() {
                    let equals = find_top_level_punct(&argument, '=');
                    if equals < argument.len() {
                        append_range(&mut output, &argument, 0usize, equals + 1usize);
                        let value = token_range(&argument, equals + 1usize, argument.len());
                        output.extend(fold_type_tokens(folder, &value));
                    } else {
                        output.extend(fold_type_tokens(folder, &argument));
                    }
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_bound<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let path_end = consume_path(tokens, 0usize, tokens.len());
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, path_end);
        if punct_at(tokens, path_end, '<') {
            let close = matching_angle_end(tokens, path_end, tokens.len());
            output.push(tokens.as_slice()[path_end].clone());
            let arguments = token_range(tokens, path_end + 1usize, close - 1usize);
            output.extend(fold_bound_arguments(folder, &arguments));
            output.push(tokens.as_slice()[close - 1usize].clone());
            append_range(&mut output, tokens, close, tokens.len());
        } else {
            match tokens.as_slice().get(path_end) {
                Option::Some(TokenTree::Group(group)) => {
                    output.push(rebuilt_group(
                        group,
                        fold_type_separated(folder, group.stream(), ',')
                    ));
                    let arrow = path_end + 1usize;
                    if punct_joint_at(tokens, arrow, '-') && punct_at(tokens, arrow + 1usize, '>') {
                        append_range(&mut output, tokens, arrow, arrow + 2usize);
                        let result = token_range(tokens, arrow + 2usize, tokens.len());
                        output.extend(fold_type_tokens(folder, &result));
                    }
                },
                _ => append_range(&mut output, tokens, path_end, tokens.len()),
            }
        }
        output
    }

    fun fold_impl_bounds<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, '+') {
                let bound = token_range(tokens, start, index);
                if !bound.is_empty() {
                    output.extend(fold_bound(folder, &bound));
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_type_default<F: Fold>(folder: &mut F, node: Type) -> Type {
        match node {
            Type::Const(tokens) => Type::Const(tokens),
            Type::Never(tokens) => Type::Never(tokens),
            Type::Macro(tokens) => Type::Macro(tokens),
            Type::Reference(tokens) => {
                let prefix = attribute_end_index(&tokens);
                let mut start = prefix + 1usize;
                if punct_at(&tokens, start, '&') || ident_at(&tokens, start, "mut") {
                    start += 1usize;
                }
                let inner = token_range(&tokens, start, tokens.len());
                let mut output = TokenStream::new();
                append_range(&mut output, &tokens, 0usize, start);
                output.extend(fold_type_tokens(folder, &inner));
                Type::Reference(output)
            },
            Type::Pointer(tokens) => {
                let start = attribute_end_index(&tokens) + 2usize;
                let inner = token_range(&tokens, start, tokens.len());
                let mut output = TokenStream::new();
                append_range(&mut output, &tokens, 0usize, start);
                output.extend(fold_type_tokens(folder, &inner));
                Type::Pointer(output)
            },
            Type::Tuple(tokens) => {
                let index = attribute_end_index(&tokens);
                let inner = match tokens.as_slice().get(index) {
                    Option::Some(TokenTree::Group(group)) => {
                        fold_type_separated(folder, group.stream(), ',')
                    },
                    _ => TokenStream::new(),
                };
                Type::Tuple(replace_group(&tokens, index, inner))
            },
            Type::Array(tokens) => {
                let index = attribute_end_index(&tokens);
                let inner = match tokens.as_slice().get(index) {
                    Option::Some(TokenTree::Group(group)) => {
                        let parts = split_top_level(group.stream(), ';');
                        let mut result = TokenStream::new();
                        if !parts.is_empty() {
                            result.extend(fold_type_tokens(folder, &parts.as_slice()[0usize]));
                        }
                        if parts.len() == 2usize {
                            let semicolon = find_top_level_punct(group.stream(), ';');
                            result.push(group.stream().as_slice()[semicolon].clone());
                            result.extend(fold_expr_tokens(folder, &parts.as_slice()[1usize]));
                        }
                        result
                    },
                    _ => TokenStream::new(),
                };
                Type::Array(replace_group(&tokens, index, inner))
            },
            Type::ImplTrait(tokens) => {
                let start = attribute_end_index(&tokens) + 1usize;
                let bounds = token_range(&tokens, start, tokens.len());
                let mut output = TokenStream::new();
                append_range(&mut output, &tokens, 0usize, start);
                output.extend(fold_impl_bounds(folder, &bounds));
                Type::ImplTrait(output)
            },
            Type::Path(tokens) => Type::Path(fold_path_type(folder, &tokens)),
        }
    }

    fun fold_pattern_fields<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, ',') {
                let field = token_range(tokens, start, index);
                if !field.is_empty() {
                    let colon = find_top_level_punct(&field, ':');
                    if colon < field.len() {
                        append_range(&mut output, &field, 0usize, colon + 1usize);
                        let pat = token_range(&field, colon + 1usize, field.len());
                        output.extend(fold_pat_tokens(folder, &pat));
                    } else {
                        output.extend(field);
                    }
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_pat_default<F: Fold>(folder: &mut F, node: Pat) -> Pat {
        match node {
            Pat::Wildcard(tokens) => Pat::Wildcard(tokens),
            Pat::Literal(tokens) => Pat::Literal(tokens),
            Pat::Binding(tokens) => Pat::Binding(tokens),
            Pat::Macro(tokens) => Pat::Macro(tokens),
            Pat::Reference(tokens) => {
                let prefix = attribute_end_index(&tokens);
                let mut start = prefix + 1usize;
                if punct_at(&tokens, start, '&') || ident_at(&tokens, start, "mut") {
                    start += 1usize;
                }
                let inner = token_range(&tokens, start, tokens.len());
                let mut output = TokenStream::new();
                append_range(&mut output, &tokens, 0usize, start);
                output.extend(fold_pat_tokens(folder, &inner));
                Pat::Reference(output)
            },
            Pat::Tuple(tokens) => {
                let index = attribute_end_index(&tokens);
                let inner = match tokens.as_slice().get(index) {
                    Option::Some(TokenTree::Group(group)) => {
                        fold_pat_separated(folder, group.stream(), ',')
                    },
                    _ => TokenStream::new(),
                };
                Pat::Tuple(replace_group(&tokens, index, inner))
            },
            Pat::Struct(tokens) => {
                let index = tokens.len() - 1usize;
                let inner = match tokens.as_slice().get(index) {
                    Option::Some(TokenTree::Group(group)) => {
                        fold_pattern_fields(folder, group.stream())
                    },
                    _ => TokenStream::new(),
                };
                Pat::Struct(replace_group(&tokens, index, inner))
            },
            Pat::Enum(tokens) => {
                let index = tokens.len() - 1usize;
                let inner = match tokens.as_slice().get(index) {
                    Option::Some(TokenTree::Group(group)) => match group.delimiter() {
                        Delimiter::Parenthesis => fold_pat_separated(folder, group.stream(), ','),
                        Delimiter::Brace => fold_pattern_fields(folder, group.stream()),
                        _ => group.stream().cloned(),
                    },
                    _ => TokenStream::new(),
                };
                Pat::Enum(replace_group(&tokens, index, inner))
            },
        }
    }

    fun fold_where_clause<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let start = if ident_at(tokens, 0usize, "where") { 1usize } else { 0usize };
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, start);
        let body = token_range(tokens, start, tokens.len());
        let mut part_start = 0usize;
        let mut index = 0usize;
        while index <= body.len() {
            if index == body.len() || punct_at(&body, index, ',') {
                let predicate = token_range(&body, part_start, index);
                if !predicate.is_empty() {
                    let colon = find_top_level_punct(&predicate, ':');
                    if colon < predicate.len() {
                        let ty = token_range(&predicate, 0usize, colon);
                        let bounds = token_range(&predicate, colon + 1usize, predicate.len());
                        output.extend(fold_type_tokens(folder, &ty));
                        output.push(predicate.as_slice()[colon].clone());
                        output.extend(fold_impl_bounds(folder, &bounds));
                    } else {
                        output.extend(predicate);
                    }
                }
                if index < body.len() {
                    output.push(body.as_slice()[index].clone());
                }
                part_start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_generic_params<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        if tokens.len() < 2usize {
            return tokens.cloned();
        }
        let inner = token_range(tokens, 1usize, tokens.len() - 1usize);
        let mut output = TokenStream::new();
        output.push(tokens.as_slice()[0usize].clone());
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= inner.len() {
            if index == inner.len() || punct_at(&inner, index, ',') {
                let param = token_range(&inner, start, index);
                if !param.is_empty() {
                    let colon = find_top_level_punct(&param, ':');
                    let equals = find_top_level_punct(&param, '=');
                    if ident_at(&param, 0usize, "const") && colon < param.len() {
                        append_range(&mut output, &param, 0usize, colon + 1usize);
                        let ty_end = if equals < param.len() { equals } else { param.len() };
                        let ty = token_range(&param, colon + 1usize, ty_end);
                        output.extend(fold_type_tokens(folder, &ty));
                        if equals < param.len() {
                            append_range(&mut output, &param, equals, param.len());
                        }
                    } else {
                        let bounds_end = if equals < param.len() { equals } else { param.len() };
                        if colon < bounds_end {
                            append_range(&mut output, &param, 0usize, colon + 1usize);
                            let bounds = token_range(&param, colon + 1usize, bounds_end);
                            output.extend(fold_impl_bounds(folder, &bounds));
                        } else {
                            append_range(&mut output, &param, 0usize, bounds_end);
                        }
                        if equals < param.len() {
                            output.push(param.as_slice()[equals].clone());
                            let default = token_range(&param, equals + 1usize, param.len());
                            output.extend(fold_type_tokens(folder, &default));
                        }
                    }
                }
                if index < inner.len() {
                    output.push(inner.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
        output
    }

    fun fold_named_fields<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, ',') {
                let field = token_range(tokens, start, index);
                if !field.is_empty() {
                    let colon = find_top_level_punct(&field, ':');
                    if colon < field.len() {
                        append_range(&mut output, &field, 0usize, colon + 1usize);
                        let ty = token_range(&field, colon + 1usize, field.len());
                        output.extend(fold_type_tokens(folder, &ty));
                    } else {
                        output.extend(field);
                    }
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_variants<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index <= tokens.len() {
            if index == tokens.len() || punct_at(tokens, index, ',') {
                let variant = token_range(tokens, start, index);
                if !variant.is_empty() {
                    let last = variant.len() - 1usize;
                    match variant.as_slice().get(last) {
                        Option::Some(TokenTree::Group(group)) => {
                            append_range(&mut output, &variant, 0usize, last);
                            let inner = match group.delimiter() {
                                Delimiter::Parenthesis => {
                                    fold_type_separated(folder, group.stream(), ',')
                                },
                                Delimiter::Brace => fold_named_fields(folder, group.stream()),
                                _ => group.stream().cloned(),
                            };
                            output.push(rebuilt_group(group, inner));
                        },
                        _ => output.extend(variant),
                    }
                }
                if index < tokens.len() {
                    output.push(tokens.as_slice()[index].clone());
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        output
    }

    fun fold_derive_tokens<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let mut index = keyword + 2usize;
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, index);
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, tokens.len());
            let generics = token_range(tokens, index, close);
            output.extend(fold_generic_params(folder, &generics));
            index = close;
        }
        if ident_at(tokens, index, "where") {
            let body = first_brace(tokens, index + 1usize);
            let clause = token_range(tokens, index, body);
            output.extend(fold_where_clause(folder, &clause));
            index = body;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                let inner = if ident_at(tokens, keyword, "enum") {
                    fold_variants(folder, group.stream())
                } else {
                    fold_named_fields(folder, group.stream())
                };
                output.push(rebuilt_group(group, inner));
            },
            _ => append_range(&mut output, tokens, index, tokens.len()),
        }
        output
    }

    fun fold_function_item<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let mut index = keyword + 2usize;
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, index);
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, tokens.len());
            let generics = token_range(tokens, index, close);
            output.extend(fold_generic_params(folder, &generics));
            index = close;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_params(folder, group.stream())));
            },
            _ => {},
        }
        index += 1usize;
        if punct_joint_at(tokens, index, '-') && punct_at(tokens, index + 1usize, '>') {
            output.push(tokens.as_slice()[index].clone());
            output.push(tokens.as_slice()[index + 1usize].clone());
            let mut end = index + 2usize;
            while end < tokens.len() && !ident_at(tokens, end, "where") && !brace_at(tokens, end)
                && !punct_at(tokens, end, ';')
            {
                end += 1usize;
            }
            let ty = token_range(tokens, index + 2usize, end);
            output.extend(fold_type_tokens(folder, &ty));
            index = end;
        }
        if ident_at(tokens, index, "where") {
            let mut end = index + 1usize;
            while end < tokens.len() && !brace_at(tokens, end) && !punct_at(tokens, end, ';') {
                end += 1usize;
            }
            let clause = token_range(tokens, index, end);
            output.extend(fold_where_clause(folder, &clause));
            index = end;
        }
        match tokens.as_slice().get(index) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
            },
            _ => append_range(&mut output, tokens, index, tokens.len()),
        }
        output
    }

    fun fold_const_item<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let rest = token_range(tokens, keyword + 2usize, tokens.len() - 1usize);
        let colon = find_top_level_punct(&rest, ':');
        let equals = find_top_level_punct(&rest, '=');
        let ty = token_range(&rest, colon + 1usize, equals);
        let value = token_range(&rest, equals + 1usize, rest.len());
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, keyword + 2usize);
        append_range(&mut output, &rest, 0usize, colon + 1usize);
        output.extend(fold_type_tokens(folder, &ty));
        output.push(rest.as_slice()[equals].clone());
        output.extend(fold_expr_tokens(folder, &value));
        output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
        output
    }

    fun fold_trait_item<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let body = tokens.len() - 1usize;
        let mut index = keyword + 2usize;
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, index);
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, body);
            output.extend(fold_generic_params(folder, &token_range(tokens, index, close)));
            index = close;
        }
        if punct_at(tokens, index, ':') {
            output.push(tokens.as_slice()[index].clone());
            output.extend(fold_impl_bounds(folder, &token_range(tokens, index + 1usize, body)));
        } else {
            append_range(&mut output, tokens, index, body);
        }
        match tokens.as_slice().get(body) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
            },
            _ => {},
        }
        output
    }

    fun fold_impl_item<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let body = tokens.len() - 1usize;
        let mut index = keyword + 1usize;
        let mut output = TokenStream::new();
        append_range(&mut output, tokens, 0usize, index);
        if punct_at(tokens, index, '<') {
            let close = matching_angle_end(tokens, index, body);
            output.extend(fold_generic_params(folder, &token_range(tokens, index, close)));
            index = close;
        }
        let mut where_index = body;
        let mut for_index = body;
        let mut scan = index;
        while scan < body {
            if ident_at(tokens, scan, "where") && where_index == body { where_index = scan; }
            if ident_at(tokens, scan, "for") && for_index == body { for_index = scan; }
            scan += 1usize;
        }
        let head_end = if where_index < body { where_index } else { body };
        if for_index < head_end {
            output.extend(fold_type_tokens(folder, &token_range(tokens, index, for_index)));
            output.push(tokens.as_slice()[for_index].clone());
            output.extend(fold_type_tokens(folder, &token_range(tokens, for_index + 1usize, head_end)));
        } else {
            output.extend(fold_type_tokens(folder, &token_range(tokens, index, head_end)));
        }
        if where_index < body {
            output.extend(fold_where_clause(folder, &token_range(tokens, where_index, body)));
        }
        match tokens.as_slice().get(body) {
            Option::Some(TokenTree::Group(group)) => {
                output.push(rebuilt_group(group, fold_file_tokens(folder, group.stream())));
            },
            _ => {},
        }
        output
    }

    fun fold_extern_members<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let mut output = TokenStream::new();
        let mut start = 0usize;
        let mut index = 0usize;
        while index < tokens.len() {
            if punct_at(tokens, index, ';') {
                let member = token_range(tokens, start, index + 1usize);
                let mut fun_index = member.len();
                let mut scan = 0usize;
                while scan < member.len() {
                    if ident_at(&member, scan, "fun") { fun_index = scan; break; }
                    scan += 1usize;
                }
                if fun_index < member.len() {
                    append_range(&mut output, &member, 0usize, fun_index);
                    output.extend(fold_function_item(
                        folder,
                        &token_range(&member, fun_index, member.len())
                    ));
                } else {
                    output.extend(member);
                }
                start = index + 1usize;
            }
            index += 1usize;
        }
        append_range(&mut output, tokens, start, tokens.len());
        output
    }

    fun fold_extern_item<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let keyword = item_keyword_index(tokens);
        let mut fun_index = keyword + 1usize;
        while fun_index < tokens.len() && !ident_at(tokens, fun_index, "fun") {
            fun_index += 1usize;
        }
        if fun_index < tokens.len() {
            let mut output = TokenStream::new();
            append_range(&mut output, tokens, 0usize, fun_index);
            output.extend(fold_function_item(
                folder,
                &token_range(tokens, fun_index, tokens.len())
            ));
            return output;
        }
        let body = tokens.len() - 1usize;
        match tokens.as_slice().get(body) {
            Option::Some(TokenTree::Group(group)) => {
                replace_group(tokens, body, fold_extern_members(folder, group.stream()))
            },
            _ => tokens.cloned(),
        }
    }

    fun fold_item_body<F: Fold>(folder: &mut F, tokens: &TokenStream) -> TokenStream {
        let last = tokens.len() - 1usize;
        match tokens.as_slice().get(last) {
            Option::Some(TokenTree::Group(group)) => {
                replace_group(tokens, last, fold_file_tokens(folder, group.stream()))
            },
            _ => tokens.cloned(),
        }
    }

    fun fold_item_default<F: Fold>(folder: &mut F, node: Item) -> Item {
        match node {
            Item::Module(tokens) => Item::Module(fold_item_body(folder, &tokens)),
            Item::Use(tokens) => Item::Use(tokens),
            Item::Function(tokens) => Item::Function(fold_function_item(folder, &tokens)),
            Item::Struct(tokens) => {
                match parse::<DeriveInput>(tokens.cloned()) {
                    Result::Ok(input) => Item::Struct(node_tokens(&folder.fold_derive_input(input))),
                    Result::Err(_) => Item::Struct(tokens),
                }
            },
            Item::Enum(tokens) => {
                match parse::<DeriveInput>(tokens.cloned()) {
                    Result::Ok(input) => Item::Enum(node_tokens(&folder.fold_derive_input(input))),
                    Result::Err(_) => Item::Enum(tokens),
                }
            },
            Item::Trait(tokens) => Item::Trait(fold_trait_item(folder, &tokens)),
            Item::Impl(tokens) => Item::Impl(fold_impl_item(folder, &tokens)),
            Item::Const(tokens) => Item::Const(fold_const_item(folder, &tokens)),
            Item::TypeAlias(tokens) => {
                let keyword = item_keyword_index(&tokens);
                if punct_at(&tokens, keyword + 2usize, '=') {
                    let ty = token_range(&tokens, keyword + 3usize, tokens.len() - 1usize);
                    let mut output = TokenStream::new();
                    append_range(&mut output, &tokens, 0usize, keyword + 3usize);
                    output.extend(fold_type_tokens(folder, &ty));
                    output.push(tokens.as_slice()[tokens.len() - 1usize].clone());
                    Item::TypeAlias(output)
                } else {
                    Item::TypeAlias(tokens)
                }
            },
            Item::Extern(tokens) => Item::Extern(fold_extern_item(folder, &tokens)),
        }
    }

    fun fold_derive_input_default<F: Fold>(folder: &mut F, node: DeriveInput) -> DeriveInput {
        let tokens = fold_derive_tokens(folder, &node.tokens);
        match parse::<DeriveInput>(tokens) {
            Result::Ok(input) => input,
            Result::Err(_) => node,
        }
    }

    impl Parse for File {
        fun parse(input: &mut ParseStream) -> Result<File, Error> {
            let tokens = input.remaining();
            input.consume_all();
            let mut stmts = Vector::new();
            let mut start = 0usize;
            let mut index = 0usize;
            while index < tokens.len() {
                let at_end = punct_at(&tokens, index, ';')
                    || (brace_at(&tokens, index)
                        && brace_terminates_statement(&tokens, index, start));
                if at_end {
                    match push_statement(&mut stmts, &tokens, start, index + 1usize) {
                        Result::Ok(()) => {},
                        Result::Err(error) => { return Result::Err(error); },
                    }
                    start = index + 1usize;
                }
                index += 1usize;
            }
            if start < tokens.len() {
                match push_statement(&mut stmts, &tokens, start, tokens.len()) {
                    Result::Ok(()) => {},
                    Result::Err(error) => { return Result::Err(error); },
                }
            }
            Result::Ok(File { stmts })
        }
    }

    impl Parse for Item {
        fun parse(input: &mut ParseStream) -> Result<Item, Error> {
            match take_tokens(input, "expected item") {
                Result::Ok(tokens) => classify_item(&tokens),
                Result::Err(error) => Result::Err(error),
            }
        }
    }

