        fun to_tokens(&self, output: &mut TokenStream) {
            match self {
                Item::Module(tokens) => tokens.to_tokens(output),
                Item::Use(tokens) => tokens.to_tokens(output),
                Item::Function(tokens) => tokens.to_tokens(output),
