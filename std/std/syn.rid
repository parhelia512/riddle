    impl crate::ToTokens for Attribute {
        fun to_tokens(&self, output: &mut TokenStream) {
            self.tokens.to_tokens(output);
        }
    }

    impl crate::ToTokens for Visibility {
        fun to_tokens(&self, output: &mut TokenStream) {
            match self {
                Visibility::Inherited => {},
                Visibility::Public => {
                    match TokenStream::from_str("pub") {
                        Result::Ok(tokens) => output.extend(tokens),
                        Result::Err(_) => {},
                    }
                },
            }
        }
    }

    impl crate::ToTokens for Generics {
        fun to_tokens(&self, output: &mut TokenStream) {
            output.extend(self.tokens.cloned());
            output.extend(self.where_clause.cloned());
        }
    }

    impl crate::ToTokens for GenericParam {
        fun to_tokens(&self, output: &mut TokenStream) {
            match self {
                GenericParam::Type(param) => param.to_tokens(output),
                GenericParam::Const(param) => param.to_tokens(output),
            }
        }
    }

    impl crate::ToTokens for Fields {
        fun to_tokens(&self, output: &mut TokenStream) {
            match self {
                Fields::Unit => {},
                Fields::Named(fields) => {
                    let mut inner = TokenStream::new();
                    for field in fields.as_slice() {
                        field.to_tokens(&mut inner);
                        inner.push(TokenTree::Punct(Punct::new(',', Spacing::Alone)));
                    }
                    Group::new(Delimiter::Brace, inner).to_tokens(output);
                },
                Fields::Unnamed(fields) => {
                    let mut inner = TokenStream::new();
                    for ty in fields.as_slice() {
                        ty.to_tokens(&mut inner);
                        inner.push(TokenTree::Punct(Punct::new(',', Spacing::Alone)));
                    }
                    Group::new(Delimiter::Parenthesis, inner).to_tokens(output);
                },
            }
        }
    }

    impl crate::ToTokens for DataStruct {
        fun to_tokens(&self, output: &mut TokenStream) {
            Group::new(Delimiter::Brace, self.fields.cloned()).to_tokens(output);
        }
    }

    impl crate::ToTokens for DataEnum {
        fun to_tokens(&self, output: &mut TokenStream) {
            Group::new(Delimiter::Brace, self.variants.cloned()).to_tokens(output);
        }
    }

    impl crate::ToTokens for Data {
        fun to_tokens(&self, output: &mut TokenStream) {
