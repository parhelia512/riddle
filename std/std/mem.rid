pub fun drop<T>(value: T) {}

#[builtin = "replace"]
pub fun replace<T>(destination: &mut T, source: T) -> T { source }

#[builtin = "size_of"]
pub fun size_of<T>() -> usize { 0usize }

#[builtin = "swap"]
pub fun swap<T>(a: &mut T, b: &mut T) {}

/// Replaces `destination` with [`Default::default`] and returns the old value.
pub fun take<T: Default>(destination: &mut T) -> T {
    replace(destination, Default::default())
}
