pub trait Default {
    fun default() -> Self;
}

impl Default for bool { fun default() -> Self { false } }
impl Default for char { fun default() -> Self { '\0' } }
impl Default for i8 { fun default() -> Self { 0i8 } }
impl Default for i16 { fun default() -> Self { 0i16 } }
impl Default for i32 { fun default() -> Self { 0i32 } }
impl Default for i64 { fun default() -> Self { 0i64 } }
impl Default for isize { fun default() -> Self { 0isize } }
impl Default for u8 { fun default() -> Self { 0u8 } }
impl Default for u16 { fun default() -> Self { 0u16 } }
impl Default for u32 { fun default() -> Self { 0u32 } }
impl Default for u64 { fun default() -> Self { 0u64 } }
impl Default for usize { fun default() -> Self { 0usize } }
impl Default for f32 { fun default() -> Self { 0.0f32 } }
impl Default for f64 { fun default() -> Self { 0.0f64 } }

impl<T> Default for crate::std::option::Option<T> {
    fun default() -> Self { crate::std::option::Option::None }
}

impl Default for crate::std::string::String {
    fun default() -> Self { crate::std::string::String::new() }
}

impl<T> Default for crate::std::vector::Vector<T> {
    fun default() -> Self { crate::std::vector::Vector::new() }
}
