// Process control built on the C runtime.
unsafe extern "C" {
    fun riddle_process_exit(code: i32) -> !;
}

/// Terminates the process with the given exit code.
/// Like C `exit`, this does not run Riddle stack destructors.
pub fun exit(code: i32) -> ! {
    unsafe {
        riddle_process_exit(code)
    }
}
