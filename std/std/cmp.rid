impl PartialOrd for f32 {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self != *self || *other != *other {
            Option::None
        } else if *self < *other {
            Option::Some(Ordering::Less)
        } else if *self > *other {
            Option::Some(Ordering::Greater)
        } else {
            Option::Some(Ordering::Equal)
        }
    }
}
impl PartialOrd for f64 {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self != *self || *other != *other {
            Option::None
        } else if *self < *other {
            Option::Some(Ordering::Less)
        } else if *self > *other {
            Option::Some(Ordering::Greater)
        } else {
            Option::Some(Ordering::Equal)
        }
    }
}

impl Ord for bool {
    fun cmp(&self, other: &Self) -> Ordering {
        if *self == *other {
            Ordering::Equal
        } else if *self {
            Ordering::Greater
        } else {
            Ordering::Less
        }
    }
}
