impl<A, B> Ord for (A, B) where A: Ord, B: Ord {
    fun cmp(&self, other: &Self) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {
                return self.1.cmp(&other.1);
            },
            first => {
                return first;
            },
        }
    }
}

