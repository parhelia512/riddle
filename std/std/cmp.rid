// ── Reference comparison impls ───────────────────────────────────────────────
// `&T == &T` previously had no `PartialEq` to dispatch to. The bodies drop
// to the pointee before delegating (`**self`, not `*self`): a method call
// or comparison on `*self: &T` would re-select this blanket impl during
// monomorphization and recurse forever.

impl<T> PartialEq for &T where T: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        (**self).eq(&**other)
    }
}

impl<T> Eq for &T where T: Eq {}

impl<T> PartialOrd for &T where T: PartialOrd {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        (**self).partial_cmp(&**other)
    }
}

impl<T> Ord for &T where T: Ord {
    fun cmp(&self, other: &Self) -> Ordering {
        (**self).cmp(&**other)
    }
}

// ── Ordering itself ─────────────────────────────────────────────────────────
// `Ordering` starts out with only `Copy`, so `x.cmp(&y) == Ordering::Equal` —
// the normal way to test a comparison result — had no `PartialEq` to use. The
// variants compare by declaration order, like Rust's derived impls.

fun ordering_rank(ordering: Ordering) -> i32 {
    match ordering {
        Ordering::Less => 0,
        Ordering::Equal => 1,
        Ordering::Greater => 2,
    }
}

impl PartialEq for Ordering {
    fun eq(&self, other: &Self) -> bool {
        ordering_rank(*self) == ordering_rank(*other)
    }
}

impl Eq for Ordering {}

impl PartialOrd for Ordering {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Option::Some(self.cmp(other))
    }
}

impl Ord for Ordering {
    fun cmp(&self, other: &Self) -> Ordering {
        let left = ordering_rank(*self);
        let right = ordering_rank(*other);
        left.cmp(&right)
    }
}

// ── Tuple comparison impls ──────────────────────────────────────────────────
// Lexicographic, element-wise, like Rust's built-ins. Without these the
// checker's structural composite rules satisfied `T: PartialEq` / `T:
// PartialOrd` bounds for tuples, but generic bodies calling `.eq` / `.lt`
// had no impl to dispatch to (an unfilled function slot at runtime). Scalars
// keep their hand-written impls above; tuple arities 2..=6 are covered here.

impl<A, B> PartialEq for (A, B) where A: PartialEq, B: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        self.0.eq(&other.0) && self.1.eq(&other.1)
    }
}

impl<A, B, C> PartialEq for (A, B, C) where A: PartialEq, B: PartialEq, C: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        self.0.eq(&other.0) && self.1.eq(&other.1) && self.2.eq(&other.2)
    }
}

impl<A, B, C, D> PartialEq for (A, B, C, D) where A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        self.0.eq(&other.0) && self.1.eq(&other.1) && self.2.eq(&other.2) && self.3.eq(&other.3)
    }
}

impl<A, B, C, D, E> PartialEq for (A, B, C, D, E) where A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        self.0.eq(&other.0) && self.1.eq(&other.1) && self.2.eq(&other.2) && self.3.eq(&other.3) && self.4.eq(&other.4)
    }
}

impl<A, B, C, D, E, F> PartialEq for (A, B, C, D, E, F) where A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq, F: PartialEq {
    fun eq(&self, other: &Self) -> bool {
        self.0.eq(&other.0) && self.1.eq(&other.1) && self.2.eq(&other.2) && self.3.eq(&other.3) && self.4.eq(&other.4) && self.5.eq(&other.5)
    }
}

impl<A, B> Eq for (A, B) where A: Eq, B: Eq {}

impl<A, B, C> Eq for (A, B, C) where A: Eq, B: Eq, C: Eq {}

impl<A, B, C, D> Eq for (A, B, C, D) where A: Eq, B: Eq, C: Eq, D: Eq {}

impl<A, B, C, D, E> Eq for (A, B, C, D, E) where A: Eq, B: Eq, C: Eq, D: Eq, E: Eq {}

impl<A, B, C, D, E, F> Eq for (A, B, C, D, E, F) where A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq {}

impl<A, B> PartialOrd for (A, B) where A: PartialOrd, B: PartialOrd {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {
                return self.1.partial_cmp(&other.1);
            },
            first => {
                return first;
            },
        }
    }
}

impl<A, B, C> PartialOrd for (A, B, C) where A: PartialOrd, B: PartialOrd, C: PartialOrd {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {
                match self.1.partial_cmp(&other.1) {
                    Option::Some(Ordering::Equal) => {
                        return self.2.partial_cmp(&other.2);
                    },
                    first => {
                        return first;
                    },
                }
            },
            first => {
                return first;
            },
        }
    }
}

impl<A, B, C, D> PartialOrd for (A, B, C, D) where A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd {
    fun partial_cmp(&self, other: &Self) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {
                match self.1.partial_cmp(&other.1) {
                    Option::Some(Ordering::Equal) => {
                        match self.2.partial_cmp(&other.2) {
                            Option::Some(Ordering::Equal) => {
                                return self.3.partial_cmp(&other.3);
                            },
                            first => {
                                return first;
                            },
                        }
                    },
                    first => {
                        return first;
                    },
                }
            },
            first => {
                return first;
            },
        }
    }
}

