use crate::std::fmt::{
    Display,
    Formatter
};
use crate::std::option::Option;
use crate::std::panic::panic;
use crate::std::result::Result;
use crate::std::fs::{
    FsError,
    FsFile
};
use crate::std::vector::Vector;

fun expect_written(result: crate::std::fmt::Result) {
    if result.is_err() {
        panic("failed to write to stdout");
    }
}

#[doc = "hidden"]
pub fun _print<T: Display>(value: &T) {
    let mut formatter = Formatter::stdout();
    expect_written(value.fmt(&mut formatter));
}

fun expect_written_err(result: crate::std::fmt::Result) {
    if result.is_err() {
        panic("failed to write to stderr");
    }
}

/// Writes `value`'s `Display` form to stderr without a trailing newline.
pub fun eprint<T: Display>(value: &T) {
    let mut formatter = Formatter::stderr();
    expect_written_err(value.fmt(&mut formatter));
}

/// Writes `value`'s `Display` form to stderr followed by a newline.
pub fun eprintln<T: Display>(value: &T) {
    let mut formatter = Formatter::stderr();
    expect_written_err(value.fmt(&mut formatter));
    expect_written_err(formatter.write_str("\n"));
}

unsafe extern "C" {
    safe fun riddle_io_stdin() -> usize;
    safe fun riddle_fs_fgetc(stream: usize) -> i32;
}

pub enum ReadError {
    EndOfFile,
    InvalidUtf8,
}

/// Buffered line reader over an `FsFile`.
pub struct BufReader {
    file: FsFile,
    bytes: Vector<u8>,
    position: usize,
    eof: bool,
}

impl BufReader {
    pub fun new(file: FsFile) -> BufReader {
        BufReader {
            file,
            bytes: Vector::new(),
            position: 0usize,
            eof: false
        }
    }

    pub fun open(path: &str) -> Result<BufReader, FsError> {
        match FsFile::open(path) {
            Result::Ok(file) => Result::Ok(BufReader::new(file)),
            Result::Err(error) => Result::Err(error),
        }
    }

    fun refill(&mut self) -> Result<bool, FsError> {
        if self.eof {
            return Result::Ok(false);
        }
        self.bytes.clear();
        self.position = 0usize;
        let mut chunk = [0u8; 1024];
        let count = match self.file.read(&mut chunk) {
            Result::Ok(value) => value,
            Result::Err(error) => {
                return Result::Err(error);
            },
        };
        let mut index = 0usize;
        while index < count {
            self.bytes.push(chunk[index]);
            index += 1usize;
        }
        if count == 0usize {
            self.eof = true;
        }
        Result::Ok(count != 0usize)
    }

    pub fun read_line(&mut self, output: &mut String) -> Result<(), ReadError> {
        output.clear();
        let mut line: Vector<u8> = Vector::new();
        let mut read_any = false;
        loop {
            if self.position >= self.bytes.len() {
                match self.refill() {
                    Result::Ok(true) => {},
                    Result::Ok(false) => {
                        return finish_line(&mut line, output, read_any);
                    },
                    Result::Err(_) => {
                        return finish_line(&mut line, output, read_any);
                    },
                }
            }
            let byte = match self.bytes.get(self.position) {
                Option::Some(value) => *value,
                Option::None => {
                    self.eof = true;
                    continue;
                },
            };
            self.position += 1usize;
            read_any = true;
            if byte == 10u8 {
                return decode_line(&mut line, output);
            }
            line.push(byte);
        }
    }
}

/// Decodes a collected line as UTF-8, replacing `output` on success. When the
/// bytes are not valid UTF-8 the error is returned and `output` stays empty.
fun decode_line(line: &mut Vector<u8>, output: &mut String) -> Result<(), ReadError> {
    output.clear();
    match String::from_utf8(line.as_slice()) {
        Option::Some(text) => {
            *output = text;
            Result::Ok(())
        },
        Option::None => Result::Err(ReadError::InvalidUtf8),
    }
}

/// Flushes a final line that ended at end of stream without a newline; with
/// no bytes read there is no line, so the stream reports `EndOfFile`.
fun finish_line(line: &mut Vector<u8>, output: &mut String, read_any: bool) -> Result<(), ReadError> {
    if !read_any {
        return Result::Err(ReadError::EndOfFile);
    }
    decode_line(line, output)
}

/// Reads one line (without the trailing newline) from standard input into
/// `buffer`, replacing its contents. The line must be valid UTF-8; invalid
/// byte sequences yield `InvalidUtf8` and leave `buffer` empty. Returns
/// `EndOfFile` when no bytes were read because the stream has ended.
pub fun read_line(buffer: &mut String) -> Result<(), ReadError> {
    buffer.clear();
    let stream = unsafe {
        riddle_io_stdin()
    };
    let mut line: Vector<u8> = Vector::new();
    let mut read_any = false;
    loop {
        let byte = unsafe {
            riddle_fs_fgetc(stream)
        };
        if byte < 0 {
            break;
        }
        read_any = true;
        if byte == 10 {
            return decode_line(&mut line, buffer);
        }
        line.push(byte as u8);
    }
    finish_line(&mut line, buffer, read_any)
}
