unsafe extern "C" {
    safe fun putchar(value: i32) -> i32;
}

pub trait Display {
    fun write(self);
}

impl Display for &str {
    fun write(self) {
        for byte in self.as_bytes() {
            putchar(*byte as i32);
        }
    }
}

impl Display for i32 {
    fun write(self) {
        let mut value = self as i64;
        if value < 0i64 {
            putchar(45);
            value = -value;
        }
        print_positive(value);
    }
}

fun print_positive(value: i64) {
    if value >= 10i64 {
        print_positive(value / 10i64);
    }
    putchar((value % 10i64) as i32 + 48);
}

pub fun print<T: Display>(value: T) {
    value.write();
}

pub fun println<T: Display>(value: T) {
    value.write();
    putchar(10);
}
