// `Ordering` renders its variants by name, matching the derived `Debug`
// impls that `Option` and `Result` already carry.
impl Debug for crate::std::cmp::Ordering {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        match self {
            crate::std::cmp::Ordering::Less => formatter.write_str("Less"),
            crate::std::cmp::Ordering::Equal => formatter.write_str("Equal"),
            crate::std::cmp::Ordering::Greater => formatter.write_str("Greater"),
        }
    }
}

pub fun write_debug<T: Debug>(value: &T, formatter: &mut Formatter) -> Result {
    value.fmt(formatter)
}

pub fun write_display<T: Display>(value: &T, formatter: &mut Formatter) -> Result {
    value.fmt(formatter)
}

impl<A, B> Debug for (A, B) where A: Debug, B: Debug {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_debug(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_debug(&self.1, &mut *formatter)?;
        formatter.write_str(")")
    }
}

