use crate::std::option::Option;
use crate::std::result::Result::{
    Err,
    Ok
};
use crate::std::string::String;
use crate::std::vector::Vector;

unsafe extern "C" {
    // `putchar` is the proc-macro protocol sink on the host side (clue
    // renames it at C-compile time); stderr takes a separate shim so the
    // protocol channel stays untouched.
    safe fun putchar(value: i32) -> i32;
    safe fun riddle_fmt_fputc_stderr(value: i32) -> i32;
}

pub struct Error {}

pub type Result = crate::std::result::Result<(), Error>;

pub struct Formatter {
    output: *mut String,
    writes_to_string: bool,
    /// Writes go to stderr instead of stdout when `writes_to_string` is false.
    to_stderr: bool,
}

impl Formatter {
    pub fun stdout() -> Formatter {
        Formatter {
            output: 0usize as *mut String,
            writes_to_string: false,
            to_stderr: false,
        }
    }

    pub fun stderr() -> Formatter {
        Formatter {
            output: 0usize as *mut String,
            writes_to_string: false,
            to_stderr: true,
        }
    }

    pub fun for_string(output: &mut String) -> Formatter {
        Formatter {
            output: output as *mut String,
            writes_to_string: true,
            to_stderr: false,
        }
    }

    pub fun write_str(&mut self, value: &str) -> Result {
        if self.writes_to_string {
            unsafe {
                (*self.output).push_str(value);
            }
            return Ok(());
        }
        for byte in value.as_bytes() {
            self.write_byte(*byte)?;
        }
        Ok(())
    }

    pub fun write_char(&mut self, value: char) -> Result {
        if self.writes_to_string {
            unsafe {
                (*self.output).push_char(value);
            }
            return Ok(());
        }
        let code = value as u32;
        if code <= 127u32 {
            return self.write_byte(code as u8);
        }
        if code <= 2047u32 {
            self.write_byte((192u32 | (code >> 6u32)) as u8)?;
            return self.write_byte((128u32 | (code & 63u32)) as u8);
        }
        if code <= 65535u32 {
            self.write_byte((224u32 | (code >> 12u32)) as u8)?;
            self.write_byte((128u32 | ((code >> 6u32) & 63u32)) as u8)?;
            return self.write_byte((128u32 | (code & 63u32)) as u8);
        }
        self.write_byte((240u32 | (code >> 18u32)) as u8)?;
        self.write_byte((128u32 | ((code >> 12u32) & 63u32)) as u8)?;
        self.write_byte((128u32 | ((code >> 6u32) & 63u32)) as u8)?;
        self.write_byte((128u32 | (code & 63u32)) as u8)
    }

    fun write_byte(&mut self, value: u8) -> Result {
        if self.writes_to_string {
            unsafe {
                (*self.output).push_char(value as char);
            }
            return Ok(());
        }
        let written = if self.to_stderr {
            unsafe {
                riddle_fmt_fputc_stderr(value as i32)
            }
        } else {
            putchar(value as i32)
        };
        if written < 0 {
            Err(Error {})
        } else {
            Ok(())
        }
    }
}

pub trait Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result;
}

#[lang = "debug"]
pub trait Debug {
    fun fmt(&self, formatter: &mut Formatter) -> Result;
}

impl Display for &str {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str(*self)
    }
}

impl Display for String {
    fun fmt(&self, formatter: &mut crate::std::fmt::Formatter) -> crate::std::fmt::Result {
        formatter.write_str(self.as_str())
    }
}

impl Display for bool {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        if *self {
            formatter.write_str("true")
        } else {
            formatter.write_str("false")
        }
    }
}

impl Display for char {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_char(*self)
    }
}

impl Display for i8 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_signed(formatter, *self as i64)
    }
}
impl Display for i16 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_signed(formatter, *self as i64)
    }
}
impl Display for i32 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_signed(formatter, *self as i64)
    }
}
impl Display for i64 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_signed(formatter, *self)
    }
}
impl Display for isize {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_signed(formatter, *self as i64)
    }
}
impl Display for u8 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_unsigned(formatter, *self as u64)
    }
}
impl Display for u16 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_unsigned(formatter, *self as u64)
    }
}
impl Display for u32 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_unsigned(formatter, *self as u64)
    }
}
impl Display for u64 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_unsigned(formatter, *self)
    }
}
impl Display for usize {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_unsigned(formatter, *self as u64)
    }
}
impl Display for f32 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_float(formatter, *self as f64)
    }
}
impl Display for f64 {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_float(formatter, *self)
    }
}

// Tuples render like Rust's `Debug`: parenthesized, comma-separated, with
// each element formatted through its own impl. Arities mirror the
// `PartialEq`/`Ord`/`Hash` tuple impls in std::cmp and std::hash.
impl<A, B> Display for (A, B) where A: Display, B: Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_display(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.1, &mut *formatter)?;
        formatter.write_str(")")
    }
}

impl<A, B, C> Display for (A, B, C) where A: Display, B: Display, C: Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_display(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.1, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.2, &mut *formatter)?;
        formatter.write_str(")")
    }
}

impl<A, B, C, D> Display for (A, B, C, D) where A: Display, B: Display, C: Display, D: Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_display(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.1, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.2, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.3, &mut *formatter)?;
        formatter.write_str(")")
    }
}

impl<A, B, C, D, E> Display for (A, B, C, D, E) where A: Display, B: Display, C: Display, D: Display, E: Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_display(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.1, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.2, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.3, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.4, &mut *formatter)?;
        formatter.write_str(")")
    }
}

impl<A, B, C, D, E, F> Display for (A, B, C, D, E, F) where A: Display, B: Display, C: Display, D: Display, E: Display, F: Display {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("(")?;
        write_display(&self.0, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.1, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.2, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.3, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.4, &mut *formatter)?;
        formatter.write_str(", ")?;
        write_display(&self.5, &mut *formatter)?;
        formatter.write_str(")")
    }
}

impl Debug for &str {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_debug_str(formatter, *self)
    }
}

impl Debug for () {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        formatter.write_str("()")
    }
}
impl<T> Debug for *mut T {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        // ponytail: add the numeric address when pointer-to-integer casts exist.
        formatter.write_str("<pointer>")
    }
}
impl Debug for bool {
    fun fmt(&self, formatter: &mut Formatter) -> Result {
        write_debug_bool(formatter, *self)
    }
}
