pub fun append_display<T: Display>(output: &mut String, value: &T) {
    let mut formatter = Formatter::for_string(output);
    value.fmt(&mut formatter);
}

pub fun append_debug<T: Debug>(output: &mut String, value: &T) {
    let mut formatter = Formatter::for_string(output);
    write_debug(value, &mut formatter);
}

fun write_debug_bool(formatter: &mut Formatter, value: bool) -> Result {
    if value {
        formatter.write_str("true")
    } else {
        formatter.write_str("false")
    }
}

fun write_debug_str(formatter: &mut Formatter, value: &str) -> Result {
    formatter.write_char('"')?;
    for character in value {
        match character {
            '\\' => formatter.write_str("\\\\")?,
            '"' => formatter.write_str("\\\"")?,
            '\n' => formatter.write_str("\\n")?,
            '\r' => formatter.write_str("\\r")?,
            '\t' => formatter.write_str("\\t")?,
            '\0' => formatter.write_str("\\0")?,
            character => formatter.write_char(character)?,
        }
    }
    formatter.write_char('"')
}

fun write_debug_char(formatter: &mut Formatter, value: char) -> Result {
    formatter.write_char('\'')?;
    match value {
        '\\' => formatter.write_str("\\\\")?,
        '\'' => formatter.write_str("\\'")?,
        '\n' => formatter.write_str("\\n")?,
        '\r' => formatter.write_str("\\r")?,
        '\t' => formatter.write_str("\\t")?,
        '\0' => formatter.write_str("\\0")?,
        value => formatter.write_char(value)?,
    }
    formatter.write_char('\'')
}

fun write_signed(formatter: &mut Formatter, value: i64) -> Result {
    if value < 0i64 {
        formatter.write_char('-')?;
        write_unsigned(formatter, (0i64 - (value + 1i64)) as u64 + 1u64)
    } else {
        write_unsigned(formatter, value as u64)
    }
}

fun write_unsigned(formatter: &mut Formatter, value: u64) -> Result {
    if value >= 10u64 {
        write_unsigned(formatter, value / 10u64)?;
    }
    formatter.write_byte((value % 10u64) as u8 + 48u8)
}

// A finite float at or above 2^64 is an exact integer `m * 2^e`. Halving by
// factors of two is exact in binary floating point, so the mantissa is
// recovered bit-exactly; its digits are then built by doubling base-2^32
// limbs and rendered through repeated division into 9-digit decimal groups.
fun write_large_float(formatter: &mut Formatter, value: f64) -> Result {
    let two_pow_63 = 9223372036854775808.0f64;
    let mut mantissa = value;
    let mut shift = 0u32;
    while mantissa >= two_pow_63 {
        mantissa = mantissa / 2.0f64;
        shift += 1u32;
    }
    let integer = mantissa as u64;
    let mut limbs: Vector<u32> = Vector::new();
    limbs.push(integer as u32);
    limbs.push((integer >> 32usize) as u32);
    let mut doubles = 0u32;
    while doubles < shift {
        let mut carry = 0u64;
        let mut index = 0usize;
        while index < limbs.len() {
            let doubled = *limbs.get(index).unwrap_or(&0u32) as u64 * 2u64 + carry;
            match limbs.get_mut(index) {
                Option::Some(slot) => {
                    *slot = doubled as u32;
                },
                Option::None => {},
            }
            carry = doubled >> 32usize;
            index += 1usize;
        }
        if carry > 0u64 {
            limbs.push(carry as u32);
        }
        doubles += 1u32;
    }
    // Peel 9-digit groups off the limb array, least significant first, and
    // drop limbs the division empties so the loop terminates.
    let mut groups: Vector<u32> = Vector::new();
    while limbs.len() > 1usize || (limbs.len() == 1usize && *limbs.get(0usize).unwrap_or(&0u32) > 0u32) {
        let mut remainder = 0u64;
        let mut index = limbs.len();
        while index > 0usize {
            index -= 1usize;
            let current = remainder * 4294967296u64 + *limbs.get(index).unwrap_or(&0u32) as u64;
            match limbs.get_mut(index) {
                Option::Some(slot) => {
                    *slot = (current / 1000000000u64) as u32;
                },
                Option::None => {},
            }
            remainder = current % 1000000000u64;
        }
        groups.push(remainder as u32);
        while limbs.len() > 1usize && *limbs.get(limbs.len() - 1usize).unwrap_or(&0u32) == 0u32 {
            let _emptied = limbs.pop();
        }
    }
    // Groups are least significant first: the most significant one prints
    // bare, the rest keep a full nine digits so zeros are not lost.
    let mut group_index = groups.len();
    while group_index > 0usize {
        group_index -= 1usize;
        let group = *groups.get(group_index).unwrap_or(&0u32) as u64;
        if group_index + 1usize == groups.len() {
            write_unsigned(formatter, group)?;
        } else {
            let mut place = 100000000u64;
            while place >= 1u64 {
                formatter.write_byte(((group / place) % 10u64) as u8 + 48u8)?;
                place = place / 10u64;
            }
        }
    }
    // Every float this large is an exact integer, so the fraction is zeros.
    formatter.write_str(".000000")
}

fun write_float(formatter: &mut Formatter, value: f64) -> Result {
    // NaN compares unequal to itself, and only infinities lie beyond the
    // largest finite double, so both special values are detected by value.
    let f64_max = 1.7976931348623157e308f64;
    if value != value {
        return formatter.write_str("NaN");
    }
    if value < 0.0f64 {
        formatter.write_char('-')?;
        return write_float(formatter, -value);
    }
    if value > f64_max {
        return formatter.write_str("inf");
    }
    // Negative zero is the only zero whose reciprocal is negative.
    if value == 0.0f64 && 1.0f64 / value < 0.0f64 {
        formatter.write_char('-')?;
    }
    // At and above 2^64 the integer part no longer fits in u64; its exact
    // digits are reconstructed from the mantissa instead of saturating.
    if value >= 18446744073709551616.0f64 {
        return write_large_float(formatter, value);
    }
    let integer = value as u64;
    write_unsigned(formatter, integer)?;
    formatter.write_char('.')?;
    let mut fraction = value - integer as f64;
    let mut digits = 0usize;
    while digits < 6usize {
        fraction *= 10.0f64;
        let digit = fraction as u64;
        formatter.write_byte(digit as u8 + 48u8)?;
        fraction -= digit as f64;
        digits += 1usize;
    }
    Ok(())
}
